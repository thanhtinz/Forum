SEPAY_ACCOUNT_NUMBER=""
SEPAY_BANK_CODE=""

# Tuỳ chọn
REDIS_URL=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# URL công khai của trang (dùng cho SEO: sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL="https://nova.example.com"

# Cloudflare R2 — lưu ảnh người dùng tải lên và sticker.
