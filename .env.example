# Chuỗi kết nối Postgres.
DATABASE_URL="postgresql://nguoi:matkhau@localhost:5432/nova"

# Địa chỉ gốc của trang, dùng cho SEO và cho đường dẫn tuyệt đối.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Cổng nhà phát triển ───────────────────────────────────────────────────
# Bảng tác giả và trang xin làm tác giả có tên miền riêng: cứ thêm tiền tố
# `developer.` vào trước tên miền cửa hàng là ra — không cần khai biến nào.
# Chỉ cần trỏ bản ghi DNS `developer.<tên miền>` về cùng máy chủ; phần mềm
# trung gian tự phân luồng. Ở máy dựng thì `developer.localhost` chạy sẵn.

# ─── Kho của cửa hàng: Cloudflare R2 ───────────────────────────────────────
# Giữ CẢ ẢNH, PHIM LẪN TỆP GAME: biểu tượng, ảnh bìa, ảnh chụp màn hình, ảnh
# trong bài diễn đàn, đoạn phim xem trước, và mọi tệp cài đặt (JAR, APK, EXE…)
# người ta tải về.
# Thiếu bất kỳ dòng nào thì tệp tải lên sẽ ghi xuống `tai-len/` — dùng
# được khi chạy ở máy phát triển, KHÔNG dùng được trên máy chủ chỉ đọc.
#
# Lấy ở bảng điều khiển Cloudflare: R2 → thùng của bạn → Settings.
#   R2_TAI_KHOAN : mã tài khoản, nằm trong địa chỉ endpoint
#   R2_KHOA      : Access Key ID của một API token có quyền ghi vào thùng
#   R2_BI_MAT    : Secret Access Key của chính token ấy
#   R2_THUNG     : tên thùng
#   R2_DIA_CHI   : địa chỉ công khai của thùng (tên miền riêng hoặc r2.dev)
R2_TAI_KHOAN=
R2_KHOA=
R2_BI_MAT=
R2_THUNG=
R2_DIA_CHI=

# ─── Gửi thư (SMTP) ────────────────────────────────────────────────────────
# Dùng cho MỘT việc: gửi mã đặt lại mật khẩu cho người quên.
#
# THIẾU BẤT KỲ DÒNG NÀO LÀ TẮT HẲN phần gửi thư, và lúc ấy trang "Quên mật
# khẩu" tự chuyển sang chỉ đường xin mã tay từ ban quản trị — chứ không bày
# một ô nhập bấm vào rồi chẳng có gì tới. Cấu hình thiếu mà giao diện vẫn nói
# "đã gửi rồi nhé" là kiểu hỏng tệ nhất: người dùng ngồi đợi một lá thư không
# bao giờ có.
#
# Cổng 465 là TLS ngay từ đầu; 587 thì bắt tay xong mới nâng cấp bằng
# STARTTLS. Đoán sai chỗ này là nối kết treo im cho tới lúc hết giờ chờ.
THU_MAY_CHU="smtp.example.com"
THU_CONG="587"
THU_NGUOI="khong-tra-loi@example.com"
THU_MAT_KHAU=""
# Địa chỉ đứng tên người gửi. Bỏ trống thì mượn luôn THU_NGUOI.
THU_TU="SunnyStore <khong-tra-loi@example.com>"
