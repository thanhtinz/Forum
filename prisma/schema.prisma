generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
// NGƯỜI DÙNG
// ════════════════════════════════════════════════════════════════════

model NguoiDung {
  id          String  @id @default(cuid())
  email       String  @unique
  tenDangNhap String  @unique
  tenHienThi  String
  anh         String?
  matKhauBam  String
  vaiTro      VaiTro  @default(THANH_VIEN)
  khoa        Boolean @default(false)

  taoLuc      DateTime  @default(now())
  ghePhutCuoi DateTime?

  /// Lúc người này tự xoá tài khoản. Chưa xoá thì để trống.
  ///
  /// XOÁ Ở ĐÂY LÀ XOÁ DANH TÍNH, KHÔNG PHẢI XOÁ HÀNG. Hàng vẫn ở lại nhưng đã
  /// bị chùi sạch email, mật khẩu, ảnh và tên — vì bài viết, lời đáp và đánh
  /// giá của người ấy treo vào hàng này. Xoá hàng đi thì mọi chủ đề họ từng mở
  /// biến mất, kéo theo cả lời đáp của NHỮNG NGƯỜI KHÁC trong chủ đề ấy: một
  /// người rời đi mà cuộc trò chuyện của mấy chục người khác thủng lỗ chỗ.
  ///
  /// Với người bày game ra cửa hàng thì còn nặng hơn: game của họ treo vào đây
  /// qua `GameCuaTacGia`, xoá hàng là gỡ luôn game khỏi kệ.
  xoaLuc      DateTime?

  /// Có gửi thư mỗi khi có thông báo mới không.
  ///
  /// BẬT SẴN, và đó là lựa chọn có cân nhắc: thông báo ở đây không phải quảng
  /// cáo mà là chuyện người ta đang đợi — ai đó trả lời bài mình, game mình
  /// gửi duyệt đã xong, bản mới của game mình đã tải. Mấy thứ ấy mà im lặng
  /// thì người dùng phải tự nhớ quay lại xem, và phần lớn là không quay lại.
  /// Mỗi lá thư đều kèm lối tắt đi.
  thuThongBao Boolean @default(true)

  danhGia       DanhGia[]
  danhGiaHuuIch DanhGiaHuuIch[]
  luotTai       LuotTai[]
  daLuu         DaLuu[]
  chuDe         ChuDe[]
  traLoi        TraLoi[]
  theoDoiChuDe  TheoDoiChuDe[]
  traLoiHuuIch  TraLoiHuuIch[]
  phieu         Phieu[]
  tinNhanChat   TinNhanChat[]
  yeuCau        YeuCau[]
  phienDangNhap Phien[]
  maXacMinh     MaXacMinh[]
  baoXau        BaoXau[]
  thongBao      ThongBao[]
  donTacGia     DonTacGia?
  gameDaDang    Game[]    @relation("GameCuaTacGia")

  /// Tên hiện ở trang tác giả, thay cho tên hiển thị thường. Rỗng thì dùng
  /// tên hiển thị — người làm game một mình chẳng cần nghĩ ra tên hãng.
  tenTacGia  String?
  /// Vài dòng tự giới thiệu, viết bằng Markdown như phần mô tả game.
  gioiThieuTacGia String? @db.Text

  @@index([taoLuc])
}

enum VaiTro {
  THANH_VIEN
  /// Tác giả: tự đăng game của mình, nhưng game phải qua duyệt mới lên kệ.
  TAC_GIA
  QUAN_TRI
}

/// Mã sáu số dùng vào việc gì.
enum ViecXacMinh {
  /// Xác minh email lúc mở tài khoản. Chưa nhập đúng mã thì CHƯA có tài khoản.
  DANG_KY
  /// Đặt lại mật khẩu cho người đã quên.
  DAT_LAI
}

/**
 * MÃ XÁC MINH SÁU SỐ — dùng chung cho mở tài khoản và đặt lại mật khẩu.
 *
 * MỘT BẢNG CHO CẢ HAI VIỆC, vì hai việc ấy giống nhau tới từng chi tiết: phát
 * một mã có hạn, gửi tới một hòm thư, đếm số lần gõ sai, dùng đúng một lần.
 * Dựng hai bảng gần y hệt là dựng sẵn chỗ để hai bên lệch nhau — vá lỗ hổng ở
 * bên này rồi quên bên kia.
 *
 * SÁU SỐ, không phải một chuỗi dài ngẫu nhiên. Mã này đi tới người qua thư rồi
 * người gõ lại bằng tay, có khi đọc qua điện thoại cho nhau chép. Một dãy năm
 * mươi ký tự thì không ai chép nổi. Đổi lại, sáu số chỉ có một triệu khả năng,
 * nên thứ giữ cho nó an toàn KHÔNG phải độ dài mà là ba cái chốt: hạn ngắn, số
 * lần gõ sai có trần (`soLanSai`), và cửa chặn ở chỗ xin mã.
 *
 * BĂM MÃ, nhưng phải nói thật là băm ở đây yếu hơn hẳn chỗ mật khẩu: một triệu
 * khả năng thì ai cầm được bảng này cũng dò ngược ra mã trong tích tắc. Vẫn
 * băm vì nó chặn được lối đọc lướt — mã không nằm trần trong bản sao lưu hay
 * trong một dòng nhật ký lỡ in cả hàng ra. Băm KÈM EMAIL để một bảng tra dựng
 * sẵn không dùng lại được cho người khác.
 *
 * Hồ sơ đang chờ (`tenHienThi`, `matKhauBam`) nằm ngay đây chứ không nằm ở
 * bảng người dùng: chưa xác minh xong thì CHƯA có tài khoản nào cả. Dựng sẵn
 * tài khoản rồi đánh dấu "chưa xác minh" là để người lạ chiếm chỗ một địa chỉ
 * email mà họ không sở hữu.
 */
model MaXacMinh {
  id    String      @id @default(cuid())
  viec  ViecXacMinh
  email String

  /// SHA-256 của "email:mã".
  ma String

  /// Chỉ có ở việc DAT_LAI — người đang xin đặt lại.
  nguoiId String?
  nguoi   NguoiDung? @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  /// Chỉ có ở việc DANG_KY — hồ sơ chờ xác minh xong mới dựng thành tài khoản.
  tenHienThi String?
  matKhauBam String?

  /// Gõ sai mấy lần rồi. Quá trần là mã chết, không đợi tới lúc hết hạn.
  soLanSai Int @default(0)

  hetHan  DateTime
  /// Lúc đã dùng. Có giá trị là mã chết — một mã chỉ đổi được một lần.
  dungLuc DateTime?

  taoLuc DateTime @default(now())

  @@index([email, viec])
  @@index([nguoiId])
  @@index([hetHan])
}

/// Phiên đăng nhập của NextAuth. Giữ ở CSDL chứ không nhét hết vào cookie:
/// khoá một tài khoản là phải đá được người ấy ra ngay, mà cookie thì không
/// gọi về được.
model Phien {
  id      String    @id @default(cuid())
  ma      String    @unique
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)
  hetHan  DateTime

  @@index([nguoiId])
}

// ════════════════════════════════════════════════════════════════════
// KHO GAME
// ════════════════════════════════════════════════════════════════════

model Game {
  id       String  @id @default(cuid())
  duongDan String  @unique // slug trên URL
  ten      String
  tenViet  String? // tên tiếng Việt, nếu có bản Việt hoá

  /// Chuỗi gộp đã BỎ DẤU, dùng cho ô tìm kiếm. Dựng ở `dungChuoiTim`; xem tệp
  /// ấy để biết vì sao gộp vào một cột thay vì `OR` qua bốn cột.
  timKiem String @default("")

  nhaPhatTrien String?
  namPhatHanh  Int?

  gioiThieu String? @db.Text
  /// Điều người tải cần biết TRƯỚC khi bấm: máy nào chạy được, lỗi đã biết.

  icon String?
  bia  String?

  /**
   * Độ tuổi khuyến nghị, chép theo thang của App Store: 4+, 9+, 12+, 17+.
   *
   * Lưu con SỐ chứ không lưu chuỗi "12+": số thì so sánh và lọc được (cha mẹ
   * xem "game từ 9 tuổi trở xuống"), còn chuỗi thì chỉ in ra được.
   */
  doTuoi Int @default(4)

  ngonNgu   String        @default("en") // en | vi | da-ngon-ngu
  vietHoa   Boolean       @default(false)
  noiBat    Boolean       @default(false)
  trangThai TrangThaiGame @default(NHAP)

  /**
   * Điểm đánh giá lưu sẵn dạng TỔNG + SỐ LƯỢT chứ không lưu số trung bình.
   * Trung bình thì không cộng thêm một lượt mới vào được mà không đọc lại cả
   * bảng; tổng thì chỉ việc `increment`, và vẫn chia ra được lúc hiển thị.
   */
  tongSao       Int @default(0)
  soLuotDanhGia Int @default(0)

  /// Điểm trung bình tính sẵn, 0 khi chưa đủ phiếu — xem `diem-game-const.ts`.
  ///
  /// VÌ SAO LƯU: trung bình là một phép chia, mà `orderBy` của Prisma không
  /// xếp theo phép chia được. Không có cột này thì mọi bảng "điểm cao nhất"
  /// đành xếp theo SỐ LƯỢT đánh giá và nói sai về chính mình.
  diemTB Float @default(0)

  soLuotTai Int @default(0)
  soLuotXem Int @default(0)

  taoLuc  DateTime  @default(now())
  suaLuc  DateTime  @updatedAt
  dangLuc DateTime?

  /// Ai đăng game này. Rỗng = game do ban quản trị tự nhập.
  ///
  /// `SetNull` chứ không `Cascade`: xoá một tài khoản tác giả thì game của họ
  /// PHẢI ở lại. Người đã tải game ấy về vẫn cần trang của nó để xem bản mới,
  /// và cả khu diễn đàn quanh nó cũng chết theo nếu game biến mất.
  tacGiaId String?
  tacGia   NguoiDung? @relation("GameCuaTacGia", fields: [tacGiaId], references: [id], onDelete: SetNull)

  /// Lúc bấm gửi duyệt — để xếp hàng chờ theo thứ tự ai gửi trước.
  guiDuyetLuc DateTime?
  /// Vì sao bị trả lại. Ban quản trị bắt buộc phải viết, xem `tuChoiGame`.
  lyDoTuChoi  String?   @db.Text

  theLoai TheLoaiTrenGame[]
  banTai  BanTai[]
  anhChup AnhChup[]
  phim    PhimGame[]
  suKien  SuKien[]
  danhGia DanhGia[]
  luotTai LuotTai[]
  luotTaiNgay LuotTaiNgay[]
  daLuu   DaLuu[]
  chuDe   ChuDe[]
  chat    TinNhanChat[]
  duLieu  DuLieuThuThap[]

  /// Người bày game đã KHAI phần quyền riêng tư chưa.
  ///
  /// Cần một cột riêng chứ không suy từ "có hàng `DuLieuThuThap` nào không":
  /// hai chuyện khác hẳn nhau, và App Store phân biệt rất rõ. "Chưa khai" là
  /// người tải KHÔNG BIẾT GÌ CẢ; "khai rồi mà không thu thập gì" là một lời
  /// hứa của nhà phát triển. Gộp hai thứ ấy làm một là biến sự im lặng thành
  /// một lời hứa chẳng ai từng nói.
  khaiQuyenRiengTu Boolean @default(false)

  @@index([trangThai, dangLuc])
  @@index([trangThai, soLuotTai])
  @@index([trangThai, noiBat])
}

/// Đường đi của một game.
///
///   NHAP      → tác giả đang soạn, chưa ai ngoài họ thấy
///   CHO_DUYET → đã gửi, nằm trong hàng chờ của ban quản trị
///   DANG_HIEN → đã duyệt, đang bày ngoài cửa hàng
///   TU_CHOI   → bị trả lại kèm lý do; sửa xong gửi lại được
///   DA_GO     → từng bày rồi bị gỡ xuống
///
/// `DANG_HIEN` là trạng thái DUY NHẤT người ngoài thấy được — mọi truy vấn ở
/// mặt tiền đều lọc theo nó, nên thêm trạng thái mới không làm rò game nháp.
enum TrangThaiGame {
  NHAP
  CHO_DUYET
  DANG_HIEN
  TU_CHOI
  DA_GO
}

/*
 * SỰ KIỆN TRONG GAME — "In-App Events" của App Store.
 *
 * Một trang game vốn chỉ kể được chuyện game ấy LÀ GÌ, mà không kể được chuyện
 * tuần này trong game có gì. Apple thêm mục sự kiện đúng vì chỗ trống ấy: bản
 * cập nhật lớn, mùa mới, giải đấu, buổi phát trực tiếp — những thứ có ngày bắt
 * đầu và ngày kết thúc, và hết ngày thì phải tự lui đi chứ không nằm lại làm
 * trang game cũ kỹ.
 *
 * Ở một cửa hàng game cũ thì nó còn hợp hơn: chỗ này là nơi báo "bản Việt hoá
 * vừa xong", "giải đấu điểm cao tháng này", "server riêng mở lại".
 */
enum LoaiSuKien {
  THU_THACH // thử thách trong game
  THI_DAU // giải đấu, đua điểm
  TRUC_TIEP // buổi phát trực tiếp
  CAP_NHAT_LON // bản cập nhật lớn
  MUA_MOI // mùa chơi mới
  RA_MAT // ra mắt nội dung mới
  DAC_BIET // dịp đặc biệt, lễ tết
}

model SuKien {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  loai     LoaiSuKien
  tieuDe   String
  /// Một dòng in trên thẻ, dưới tiêu đề. Dài hơn thì thẻ vỡ dáng.
  moTaNgan String
  noiDung  String?    @db.Text

  /// Ảnh thẻ, nằm ngang — xem `luat-anh-const.ts`. Trống thì thẻ dùng dải màu.
  anh String?

  batDau  DateTime
  ketThuc DateTime

  /// Tắt đi mà không xoá: sự kiện năm ngoái còn dùng lại được năm sau.
  hien Boolean @default(true)

  taoLuc DateTime @default(now())

  @@index([gameId, ketThuc])
}

model TheLoai {
  id       String @id @default(cuid())
  duongDan String @unique
  ten      String
  thuTu    Int    @default(0)

  game TheLoaiTrenGame[]
}

model TheLoaiTrenGame {
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  theLoaiId String
  theLoai   TheLoai @relation(fields: [theLoaiId], references: [id], onDelete: Cascade)

  @@id([gameId, theLoaiId])
  @@index([theLoaiId])
}

/**
 * MỘT BẢN TẢI = một hệ máy + một số hiệu.
 * Tách theo hệ máy chứ không gom chung: bản Android 2.1 và bản Java 1.4 là hai
 * dãy số hoàn toàn riêng, gom vào một danh sách thì người dùng phải tự lọc
 * xem số nào dành cho máy mình.
 */
model BanTai {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  heMay     HeMay
  soHieu    String // "1.0.2"
  ghiChu    String?
  doiMoi    String?   @db.Text // có gì mới ở bản này
  dungLuong BigInt?
  ngayRa    DateTime?

  /// Bản mới nhất CỦA HỆ MÁY NÀY — mỗi hệ đúng một bản được đánh dấu.
  moiNhat Boolean @default(false)

  /**
   * Địa chỉ cửa hàng ngoài (App Store, Google Play).
   * iPhone chưa bẻ khoá KHÔNG cài được tệp IPA tải từ web: Apple chỉ cho cài
   * qua App Store, TestFlight, hệ thống quản lý thiết bị của doanh nghiệp,
   * hoặc chợ ứng dụng thay thế ở châu Âu. Nên lối vào của iOS phải là một
   * đường dẫn sang App Store; tệp IPA nếu có chỉ dành cho người tự biết cài.
   */
  duongDanCuaHang String?

  tep TepTai[]

  @@unique([gameId, heMay, soHieu])
  @@index([gameId, heMay, moiNhat])
}

enum HeMay {
  JAVA
  ANDROID
  IOS
  WINDOWS
  MAC
}

model TepTai {
  id    String @id @default(cuid())
  banId String
  ban   BanTai @relation(fields: [banId], references: [id], onDelete: Cascade)

  loai      LoaiTep
  duongDan  String // địa chỉ tải thật
  tenTep    String?
  dungLuong BigInt?

  /// Mã kiểm tra để người tải đối chiếu sau khi tải xong.
  ///
  /// LUÔN LÀ SHA-256, nên không có cột nào ghi tên thuật toán: `luuDong` băm
  /// bằng đúng nó, và trang quản trị in thẳng chữ "sha256" cạnh mã. Từng có
  /// một cột `thuatToan` mặc định "sha256" ở đây — không nơi nào GHI giá trị
  /// khác vào, cũng không nơi nào ĐỌC nó ra, nên nó chỉ hứa một sự linh hoạt
  /// không có thật.
  maKiemTra String?

  @@index([banId])
}

enum LoaiTep {
  JAR
  JAD
  APK
  IPA
  ZIP
  EXE
  /// Ảnh đĩa của macOS — kéo vào thư mục Applications là xong.
  DMG
  /// Gói cài đặt của macOS, dùng khi bản game cần chạy kịch bản lúc cài.
  PKG
}

/*
 * ĐOẠN PHIM XEM TRƯỚC — "app preview" của App Store.
 *
 * Apple cho tối đa ba đoạn, đứng TRƯỚC ảnh chụp trong dải xem trước, và chạy
 * ngay lúc người ta cuộn tới — không tiếng. Lý do họ đặt phim lên trước ảnh:
 * một game thì thứ đáng xem nhất là nó CHẠY như thế nào, mà ảnh tĩnh không nói
 * được điều đó.
 *
 * `anhBia` là tấm hiện ra trước khi phim chạy. Không có thì trình duyệt tự lấy
 * khung đầu, mà khung đầu của phim game thường là màn hình đen.
 */
model PhimGame {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  duongDan  String
  anhBia    String?
  dungLuong BigInt?
  thuTu     Int     @default(0)
  taoLuc    DateTime @default(now())

  @@index([gameId, thuTu])
}

model AnhChup {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  duongDan String
  chuThich String?
  thuTu    Int     @default(0)

  /// Ảnh này chụp trên hệ máy nào. RỖNG nghĩa là dùng chung cho mọi hệ.
  ///
  /// App Store có bộ ảnh riêng cho iPhone, iPad, Mac vì cùng một ứng dụng trên
  /// hai máy ấy trông khác hẳn nhau. Ở đây khoảng cách còn lớn hơn: cùng một
  /// game, bản Java ME là màn 176×208 hai màu, bản Android là đồ hoạ dựng lại
  /// — bày lẫn vào nhau thì người cầm điện thoại Android tưởng mình sắp tải
  /// đúng cái màn hình cũ kỹ kia.
  ///
  /// Để RỖNG được, và phần lớn game cũ sẽ rỗng: bắt gắn hệ máy cho từng tấm là
  /// bắt người bày hàng trả lời một câu mà chính họ cũng không nhớ.
  heMay HeMay?

  @@index([gameId, thuTu])
}

// ════════════════════════════════════════════════════════════════════
// ĐÁNH GIÁ · THƯ VIỆN
// ════════════════════════════════════════════════════════════════════

model DanhGia {
  id      String    @id @default(cuid())
  gameId  String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  sao     Int // 1..5

  /// Đầu đề bài đánh giá — một câu chốt lại ý, in đậm trên đầu thẻ.
  ///
  /// VÌ SAO CẦN: kệ đánh giá cuộn ngang thì mỗi thẻ chỉ được liếc chừng một
  /// giây. Không có đầu đề, người đọc phải nhá bốn dòng chữ của từng thẻ mới
  /// đoán ra bài ấy khen hay chê — mà liếc nhanh chính là cách người ta đọc
  /// kệ. RỖNG với bài chấm sao suông và với bài viết từ trước đợt này.
  tieuDe  String?
  noiDung String? @db.Text

  /// Một tấm ảnh người chấm sao đính kèm: ảnh chụp màn hình lỗi, ảnh chụp máy
  /// đang chạy. Cùng lối với `TinNhanChat.anh` — một cột cho cả ảnh tự tải
  /// lên, sticker lẫn ảnh động, vì cả ba đều là một địa chỉ và đều bày ra y
  /// như nhau.
  ///
  /// Bài đánh giá in ra dưới dạng CHỮ THUẦN, không phải Markdown, nên ảnh phải
  /// có cột riêng: nhét `![](…)` vào phần chữ thì người đọc thấy đúng mấy ký
  /// tự ấy chứ không thấy tấm hình.
  anh String?

  /// Số người thấy bài này hữu ích, đếm sẵn ở đây chứ không đếm lúc đọc.
  ///
  /// VÌ SAO ĐỂ SỐ Ở ĐÂY: cách sắp mặc định của phần đánh giá là "hữu ích
  /// nhất", mà `orderBy` thì phải có cột để sắp. Đếm `DanhGiaHuuIch` lúc đọc
  /// thì Prisma không sắp theo được, phải lôi hết bài về rồi sắp bằng tay —
  /// game nghìn bài đánh giá là hỏng.
  soHuuIch Int @default(0)

  huuIch DanhGiaHuuIch[]

  /// Game đang ở bản nào lúc người này chấm sao. RỖNG với bài chấm từ trước
  /// đợt này, và với game chưa có bản tải nào.
  ///
  /// VÌ SAO CẦN: một game bị chê nát ở bản 1.0 rồi vá sạch lỗi ở bản 2.0 thì
  /// điểm trung bình vẫn kéo lê mãi mấy bài cũ, mà người đang cân nhắc tải
  /// bản 2.0 không có cách nào lọc ra tiếng nói về ĐÚNG bản họ sắp tải. App
  /// Store cho lọc "mọi phiên bản" hay "bản hiện tại" đúng vì chuyện ấy.
  ///
  /// Ghi lại mỗi lần chấm, kể cả lúc sửa bài cũ: người sửa bài là người vừa
  /// chơi lại, nên tiếng nói ấy thuộc về bản họ đang cầm.
  soHieu String?

  /// Lời đáp của cửa hàng, nằm ngay trong hàng đánh giá thay vì thành bảng
  /// riêng: mỗi bài chỉ có đúng một lời đáp, y như CH Play.
  traLoi    String?   @db.Text
  /// Ảnh đính kèm lời đáp của cửa hàng. Cùng lẽ với `anh` ở trên.
  traLoiAnh String?
  traLoiLuc DateTime?

  taoLuc DateTime @default(now())
  suaLuc DateTime @updatedAt

  baoXau BaoXau[]

  /// Mỗi người một tiếng nói cho mỗi game; chấm lại là sửa bài cũ.
  @@unique([gameId, nguoiId])
  @@index([gameId, taoLuc])
  /// Sắp "hữu ích nhất" là lối vào mặc định của phần đánh giá, nên nó cần
  /// chỉ mục riêng chứ không dựa được vào chỉ mục theo ngày ở trên.
  @@index([gameId, soHuuIch])
}

/**
 * PHIẾU "HỮU ÍCH" — mỗi người bấm được đúng một lần cho mỗi bài.
 *
 * Thành bảng riêng chứ không cộng thẳng vào `DanhGia.soHuuIch` là vì phải
 * CHẶN bấm hai lần: không giữ dấu ai đã bấm thì một người bấm đi bấm lại là
 * đẩy được bài của mình lên đầu kệ. Khoá chính ghép sẵn làm luôn việc ấy —
 * hàng thứ hai không chèn nổi.
 */
model DanhGiaHuuIch {
  danhGiaId String
  danhGia   DanhGia   @relation(fields: [danhGiaId], references: [id], onDelete: Cascade)
  nguoiId   String
  nguoi     NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  taoLuc DateTime @default(now())

  @@id([danhGiaId, nguoiId])
  @@index([nguoiId])
}

/**
 * THƯ VIỆN — mỗi người mỗi game một hàng, ghi lần tải GẦN NHẤT.
 * Ghi từng lượt tải thì bảng phình theo số lần bấm mà mục "game tôi đã tải"
 * vẫn phải gom nhóm lại mới in ra được. Số lượt tải tổng đã có sẵn ở
 * `Game.soLuotTai`, nên ở đây chỉ cần biết ai có game gì.
 */
/**
 * LƯỢT TẢI GOM THEO NGÀY — để tác giả xem được đường đi của game mình.
 *
 * VÌ SAO CẦN BẢNG RIÊNG: `Game.soLuotTai` chỉ là một con số cộng dồn, nó không
 * nói được tuần này hơn hay kém tuần trước; còn `LuotTai` thì mỗi người mỗi
 * game đúng MỘT hàng, ghi đè mỗi lần tải lại — nên lịch sử coi như không có.
 * Hai thứ ấy không dựng lại được đường biểu diễn, dù có xoay kiểu gì.
 *
 * Gom sẵn theo ngày thay vì ghi từng lượt: một cửa hàng game Java chạy lâu năm
 * thì bảng "từng lượt tải" phình theo số lần bấm, mà câu hỏi người ta hỏi thì
 * luôn là "ngày ấy bao nhiêu lượt". Đếm sẵn lúc ghi thì lúc đọc chỉ việc lấy
 * ra.
 *
 * Mốc ngày tính theo GIỜ VIỆT NAM, xem `ngay-vn-const.ts`: gom theo giờ UTC
 * thì mọi lượt tải từ nửa đêm tới 7 giờ sáng giờ ta rơi sang hôm trước.
 *
 * Tách luôn theo hệ máy, vì đó là câu hỏi thật của người bày hàng: "còn ai tải
 * bản Java nữa không, hay dẹp đi cho rồi".
 */
model LuotTaiNgay {
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Mốc 0 giờ giờ Việt Nam của ngày ấy.
  ngay  DateTime
  heMay HeMay
  so    Int      @default(0)

  @@id([gameId, ngay, heMay])
  @@index([gameId, ngay])
}

model LuotTai {
  id      String    @id @default(cuid())
  gameId  String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  heMay   HeMay
  soHieu  String?
  lanCuoi DateTime @default(now())
  soLan   Int      @default(1)

  @@unique([gameId, nguoiId])
  @@index([nguoiId, lanCuoi])
}

/**
 * ĐÃ LƯU — danh sách game định tải, chưa tải.
 * Khác `LuotTai` ở đúng một chỗ, mà chỗ ấy quan trọng: `LuotTai` ghi việc đã
 * XẢY RA (ai tải gì, lúc nào), còn bảng này ghi một Ý ĐỊNH. Nhập hai thứ làm
 * một thì "thư viện của tôi" lẫn game chưa hề tải, mà mục cập nhật lại đi
 * nhắc bản mới của game người ta chưa tải bao giờ.
 *
 * Mỗi người mỗi game MỘT hàng, nên bật tắt là `upsert`/`delete` chứ không phải
 * đếm rồi mới quyết — hai lần bấm nhanh không đẻ ra hai hàng.
 */
model DaLuu {
  id      String    @id @default(cuid())
  gameId  String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  taoLuc DateTime @default(now())

  @@unique([gameId, nguoiId])
  @@index([nguoiId, taoLuc])
}

// ════════════════════════════════════════════════════════════════════
// CỘNG ĐỒNG — nằm TRONG từng game, không có bảng chuyên mục riêng
// ════════════════════════════════════════════════════════════════════

/// CHUYÊN MỤC CỦA DIỄN ĐÀN — dựng MỘT LẦN ở khu quản trị, dùng cho MỌI game.
///
/// Cửa hàng có hàng trăm game, mà câu chuyện trong diễn đàn game nào cũng chia
/// theo đúng mấy kiểu như nhau: hỏi cách qua màn, báo lỗi, khoe bản mod, tán
/// gẫu. Cho mỗi game tự dựng lấy bảng chuyên mục thì người bày hàng phải gõ
/// lại từng game một, mỗi nơi một tên, và người đọc đi từ game này sang game
/// kia là gặp một cái bảng lạ.
///
/// Nên chuyên mục là của CẢ CỬA HÀNG, còn chủ đề nằm trong nó thì của TỪNG
/// GAME: vào game nào cũng thấy đúng bảng chuyên mục ấy, mà bấm vào thì chỉ ra
/// chuyện của game đang xem.
/// MỘT GÓI STICKER, do quản trị tải lên.
///
/// Gói chứ không phải một rổ sticker phẳng: người gửi tìm theo gói ("bộ mèo
/// mập"), y như mọi ứng dụng nhắn tin — một lưới hai trăm hình không nhóm thì
/// cuộn mãi không thấy cái mình nhớ.
model GoiSticker {
  id     String   @id @default(cuid())
  ten    String
  thuTu  Int      @default(0)
  taoLuc DateTime @default(now())

  sticker Sticker[]

  @@index([thuTu])
}

/// Một hình trong gói. `Cascade`: gỡ gói thì hình đi theo, chúng chỉ tồn tại
/// bên trong gói và không có chỗ nào khác trỏ tới.
model Sticker {
  id    String     @id @default(cuid())
  goiId String
  goi   GoiSticker @relation(fields: [goiId], references: [id], onDelete: Cascade)

  anh   String
  thuTu Int @default(0)

  @@index([goiId, thuTu])
}

/// PHÒNG CHAT CHUNG của một game — mỗi game một phòng, ai cũng đọc được.
///
/// Diễn đàn trả lời tốt mấy câu hỏi CÒN LẠI LÂU: "màn 12 qua kiểu gì", "bản
/// nào chạy trên máy nào". Nhưng nửa số câu người ta gõ ra lại là loại sống
/// đúng ba phút — "ai đang chơi không", "vừa tải xong, mở lên đen sì" — mà mở
/// hẳn một chủ đề cho một câu như thế thì vừa ngại vừa làm rác danh sách.
///
/// Nên phòng chat KHÔNG thay diễn đàn, nó nhận đúng phần chuyện mà diễn đàn
/// nhận vào là hỏng: nói xong rồi trôi, không ai phải đặt tiêu đề.
model TinNhanChat {
  id      String    @id @default(cuid())
  gameId  String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  noiDung String   @db.Text

  /// Một tấm ảnh đi kèm: ảnh tự tải lên, một cái sticker, hay một ảnh động.
  ///
  /// MỘT CỘT CHO CẢ BA, vì cả ba rốt cuộc đều là một địa chỉ ảnh và đều bày ra
  /// y như nhau. Tách ba cột (hoặc thêm cột "loại") thì mỗi chỗ đọc phải viết
  /// ba nhánh, mà ba nhánh ấy in ra cùng một thẻ `img`.
  ///
  /// Câu có ảnh thì `noiDung` được phép rỗng — gửi mỗi cái sticker là chuyện
  /// thường nhất trong một phòng chat.
  anh String?

  taoLuc  DateTime @default(now())

  /// Đọc luôn luôn là "mấy câu mới nhất của phòng này", nên chỉ mục đúng theo
  /// hình dạng ấy — phòng đông tới chục nghìn câu thì vẫn chỉ chạm vào đuôi.
  @@index([gameId, taoLuc])

  /// Nhịp nghỉ giữa hai câu tra "câu cuối cùng của người này" trên TOÀN CỬA
  /// HÀNG, không riêng một phòng — xem `guiChat`. Không có chỉ mục này thì
  /// mỗi lượt gửi là một lượt quét cả bảng.
  @@index([nguoiId, taoLuc])
}

model ChuyenMuc {
  id       String @id @default(cuid())
  duongDan String @unique
  ten      String

  /// Một dòng nói chuyên mục này để bàn chuyện gì. Hiện ngay dưới tên, đúng
  /// lối bảng chuyên mục của mấy diễn đàn cũ — không có nó thì người đọc phải
  /// bấm thử vào từng mục mới đoán ra nó chứa gì.
  moTa String?

  /// Biểu tượng của chuyên mục, do quản trị tải lên. Bỏ trống thì bày chữ cái
  /// đầu, cùng lối với ảnh đại diện thành viên — một ô trống toang thì cả bảng
  /// lệch hàng, mà bắt quản trị phải có ảnh mới thêm được mục thì quá đắt.
  anh String?

  thuTu  Int      @default(0)
  taoLuc DateTime @default(now())

  chuDe ChuDe[]

  @@index([thuTu])
}

model ChuDe {
  id      String    @id @default(cuid())
  gameId  String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  tieuDe  String
  noiDung String @db.Text

  /// Tiêu đề + nội dung đã BỎ DẤU, cho ô tìm kiếm. Cùng lối với `Game.timKiem`
  /// — xem `dungChuoiTimChuDe` để biết vì sao gộp cả phần nội dung vào.
  timKiem String @default("") @db.Text

  ghim Boolean @default(false)
  khoa Boolean @default(false)

  /// Chuyên mục chứa chủ đề này. Để trống là chủ đề chưa xếp mục nào — bảng
  /// chuyên mục gom mấy bài ấy vào mục "Chung" dựng sẵn, chứ không giấu đi.
  ///
  /// `SetNull` chứ không `Cascade`: quản trị gỡ một chuyên mục thì mấy chủ đề
  /// trong đó chỉ mất chỗ xếp, KHÔNG được biến mất theo — bên trong là bài của
  /// hàng chục người khác, mà xoá một cái nhãn phân loại thì không đáng đổi
  /// bằng cả cuộc trò chuyện.
  chuyenMucId String?
  chuyenMuc   ChuyenMuc? @relation(fields: [chuyenMucId], references: [id], onDelete: SetNull)

  /// Người mở chủ đề tự chọn. Mặc định `TAN_GAU` — nhãn nhẹ nhất, vì đoán sai
  /// thành "báo lỗi" thì người bày hàng đi kiểm một thứ chẳng ai báo.
  nhan NhanChuDe @default(TAN_GAU)

  soTraLoi      Int      @default(0)
  traLoiCuoiLuc DateTime @default(now())
  taoLuc        DateTime @default(now())

  /// Lần sửa gần nhất. Chưa sửa lần nào thì để trống.
  ///
  /// KHÔNG dùng `@updatedAt`: cột ấy nhảy theo MỌI lượt ghi, kể cả lúc cửa
  /// hàng tự cộng `soTraLoi` hay tự đặt lời giải — rồi trang in "đã sửa" lên
  /// một bài mà chủ nó chưa hề đụng vào. Đây là chữ nói với người đọc rằng nội
  /// dung đã đổi sau khi họ có thể đã đọc, nên chỉ chính lượt sửa mới được ghi.
  suaLuc        DateTime?

  /// Đếm lượt mở chủ đề. Cùng lối `Game.soLuotXem`.
  soLuotXem     Int      @default(0)

  /// Bài được chọn là LỜI GIẢI của chủ đề.
  ///
  /// Diễn đàn game phần lớn là câu hỏi: kẹt màn nào, máy nào chạy được, tệp
  /// nào mới. Câu trả lời đúng thường nằm lẫn giữa hai chục bài bàn ra bàn
  /// vào, nên người thứ hai gặp đúng chuyện ấy vẫn phải đọc lại từ đầu — mà
  /// phần lớn thì bỏ giữa chừng rồi mở một chủ đề y hệt.
  ///
  /// Một con trỏ là đủ, không cần cột `laLoiGiai` trên từng bài: ràng buộc
  /// "mỗi chủ đề đúng MỘT lời giải" nằm luôn trong hình dạng dữ liệu, chứ
  /// không phải một luật phải nhớ giữ mỗi lần ghi.
  ///
  /// `SetNull`: bài lời giải bị gỡ thì chủ đề quay về chưa có lời giải.
  loiGiaiId String? @unique
  loiGiai   TraLoi? @relation("LoiGiai", fields: [loiGiaiId], references: [id], onDelete: SetNull)

  traLoi   TraLoi[]
  baoXau   BaoXau[]
  theoDoi  TheoDoiChuDe[]
  binhChon BinhChon?

  @@index([gameId, ghim, traLoiCuoiLuc])
  @@index([gameId, nhan])
  @@index([gameId, chuyenMucId])
  /// Cho lượt tra NHỊP NGHỈ: "chủ đề gần nhất của người này mở lúc nào".
  /// Không có chỉ mục thì phép chống rải bài lại thành một lượt quét cả bảng —
  /// tức là cái cửa chặn tự nó thành chỗ để đạp vào.
  @@index([nguoiId, taoLuc])
}

/*
 * AI ĐANG THEO DÕI MỘT CHỦ ĐỀ.
 *
 * Trước bảng này, chỉ chủ chủ đề được báo khi có bài mới. Nghĩa là người vào
 * hỏi thêm một câu rồi đi thì không bao giờ biết có ai đáp mình — họ phải nhớ
 * quay lại kiểm, và phần lớn thì không. Cuộc trò chuyện chết ở đúng chỗ nó
 * đang có ích nhất.
 *
 * Khoá chính là CẶP (chủ đề, người): một người theo dõi một chủ đề đúng một
 * lần, và ràng buộc ấy nằm trong cơ sở dữ liệu chứ không phải một câu `if` ở
 * chỗ ghi — bấm hai lần thật nhanh vẫn không đẻ ra hai hàng.
 */
/*
 * AI BẤM "HỮU ÍCH" CHO BÀI NÀO.
 *
 * Lời giải chỉ đánh dấu được MỘT bài, và chỉ chủ chủ đề đánh dấu được — nhưng
 * một chủ đề thường có mấy câu trả lời đều đáng đọc, và người hỏi thì hay biến
 * mất sau khi xong việc. Phiếu hữu ích để chính người đọc sau đẩy mấy câu ấy
 * nổi lên, không phải chờ ai cho phép.
 *
 * Khoá chính là cặp (bài, người): một người bấm một bài đúng một lần, và ràng
 * buộc ấy nằm trong cơ sở dữ liệu chứ không phải một câu `if` ở chỗ ghi.
 */
model TraLoiHuuIch {
  traLoiId String
  traLoi   TraLoi    @relation(fields: [traLoiId], references: [id], onDelete: Cascade)
  nguoiId  String
  nguoi    NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  taoLuc DateTime @default(now())

  @@id([traLoiId, nguoiId])
  @@index([nguoiId])
}

/*
 * BÌNH CHỌN GẮN VÀO MỘT CHỦ ĐỀ.
 *
 * VÌ SAO DIỄN ĐÀN GAME CẦN: nửa số chủ đề tán gẫu ở đây thực ra là một câu hỏi
 * đếm đầu người — "bản nào mượt hơn", "nên tải bản Việt hoá hay bản gốc", "ai
 * còn chơi trên máy thật". Không có chỗ bấm thì hai chục người vào gõ đúng một
 * chữ "bản 1.2", và người mở chủ đề phải tự ngồi đếm trong một dải bài.
 *
 * MỖI CHỦ ĐỀ NHIỀU NHẤT MỘT cuộc bình chọn (`@unique` trên `chuDeId`): hai
 * cuộc trong một chủ đề thì phiếu của người đọc chia đôi mà chẳng ai biết cuộc
 * nào mới là câu hỏi chính.
 *
 * KHÔNG có ngày đóng: một cuộc bình chọn trong diễn đàn game không phải cuộc
 * bầu cử, và một cột thời hạn kéo theo cả việc phải chốt lười lúc đọc trang.
 * Người mở chủ đề khoá chủ đề là bình chọn dừng theo.
 */
model BinhChon {
  id      String @id @default(cuid())
  chuDeId String @unique
  chuDe   ChuDe  @relation(fields: [chuDeId], references: [id], onDelete: Cascade)

  cauHoi String

  /// Cho chọn nhiều đáp án một lúc hay chỉ một.
  nhieuLuaChon Boolean @default(false)

  taoLuc DateTime @default(now())

  luaChon LuaChon[]
}

model LuaChon {
  id         String   @id @default(cuid())
  binhChonId String
  binhChon   BinhChon @relation(fields: [binhChonId], references: [id], onDelete: Cascade)

  noiDung String
  thuTu   Int    @default(0)

  /// Đếm sẵn số phiếu — cùng lẽ với `TraLoi.soHuuIch`: trang nào cũng cần con
  /// số này cho MỌI lựa chọn, mà đếm lúc đọc thì mỗi lượt xem là mấy phép đếm.
  soPhieu Int @default(0)

  phieu Phieu[]

  @@index([binhChonId, thuTu])
}

model Phieu {
  luaChonId String
  luaChon   LuaChon   @relation(fields: [luaChonId], references: [id], onDelete: Cascade)
  nguoiId   String
  nguoi     NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  taoLuc DateTime @default(now())

  /// Một người bỏ một phiếu cho một lựa chọn đúng một lần. Ràng buộc nằm ở
  /// khoá chính, không phải ở một câu `if` chỗ ghi.
  @@id([luaChonId, nguoiId])
  @@index([nguoiId])
}

model TheoDoiChuDe {
  chuDeId String
  chuDe   ChuDe     @relation(fields: [chuDeId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  taoLuc DateTime @default(now())

  @@id([chuDeId, nguoiId])
  @@index([nguoiId, taoLuc])
}

model TraLoi {
  id      String    @id @default(cuid())
  chuDeId String
  chuDe   ChuDe     @relation(fields: [chuDeId], references: [id], onDelete: Cascade)
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  noiDung String   @db.Text
  taoLuc  DateTime @default(now())

  /// Lần sửa gần nhất — xem chú thích cùng tên ở `ChuDe`.
  suaLuc  DateTime?

  /// Bao nhiêu người bấm "hữu ích" cho bài này.
  ///
  /// Đếm sẵn thay vì đếm lúc đọc: danh sách bài nào cũng cần con số này, mà
  /// đếm lúc đọc là hai mươi bài thành hai mươi phép đếm. Cùng lối với
  /// `DanhGia.soHuuIch`, kể cả chỗ chặn sàn 0.
  soHuuIch Int @default(0)

  /// Bài này đáp thẳng vào bài nào trong cùng chủ đề.
  ///
  /// Diễn đàn ở đây là một dải bài PHẲNG xếp theo thời gian, và một chủ đề
  /// đông người thì đọc mãi không ra ai đang đáp ai — nhất là khi hai ba cuộc
  /// trò chuyện đan vào nhau. Một con trỏ ngược là đủ để mỗi bài tự nói nó
  /// đang đáp ai, mà không phải đổi cả diễn đàn sang lối cây.
  ///
  /// `SetNull` chứ không `Cascade`: bài được đáp bị gỡ thì bài đáp PHẢI ở lại.
  /// Cascade ở đây là một người xoá bài của mình rồi kéo theo cả mấy bài
  /// người khác viết để đáp lại — mất chữ của người ngoài cuộc.
  traLoiChoId String?
  traLoiCho   TraLoi?  @relation("DapLai", fields: [traLoiChoId], references: [id], onDelete: SetNull)
  daDap       TraLoi[] @relation("DapLai")

  /// Chủ đề nào đang lấy bài này làm lời giải. Quan hệ ngược của `ChuDe.loiGiai`.
  laLoiGiaiCua ChuDe? @relation("LoiGiai")

  huuIch TraLoiHuuIch[]

  baoXau BaoXau[]

  @@index([chuDeId, taoLuc])
  @@index([traLoiChoId])
  /// Cùng lẽ với `ChuDe`: lượt tra nhịp nghỉ của lời đáp.
  @@index([nguoiId, taoLuc])
}

// ════════════════════════════════════════════════════════════════════
// YÊU CẦU GAME
// ════════════════════════════════════════════════════════════════════

model YeuCau {
  id      String    @id @default(cuid())
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  ten    String
  ghiChu String? @db.Text

  trangThai TrangThaiYeuCau @default(CHO_XEM)
  loiNhan   String? // ban quản trị trả lời

  taoLuc DateTime @default(now())

  @@index([trangThai, taoLuc])
}

enum TrangThaiYeuCau {
  CHO_XEM
  DANG_TIM
  DA_THEM
  TU_CHOI
}

// ════════════════════════════════════════════════════════════════════
// CÀI ĐẶT TRANG
// ════════════════════════════════════════════════════════════════════

model CaiDat {
  khoa   String   @id
  giaTri Json
  suaLuc DateTime @updatedAt
}

/*
 * NHÃN CỦA MỘT CHỦ ĐỀ.
 *
 * Diễn đàn game hỏi đi hỏi lại đúng bốn kiểu chuyện, và bốn kiểu ấy cần bốn
 * cách đọc khác nhau: người đang kẹt màn muốn tìm CÂU HỎI có lời giải, người
 * rảnh thì đọc MẸO, còn người bày hàng thì chỉ quan tâm mấy bài BÁO LỖI. Không
 * phân loại thì cả bốn trộn vào một dải, và ai cũng phải lọc bằng mắt.
 *
 * Danh sách CỐ ĐỊNH bốn nhãn, không cho người dùng tự đặt: nhãn tự đặt thì hai
 * mươi người đẻ ra hai mươi cách gọi cùng một chuyện, và bộ lọc hoá vô dụng.
 */
enum NhanChuDe {
  HOI_DAP
  MEO_HAY
  BAO_LOI
  TAN_GAU
}

/// Vì sao báo. Danh sách ngắn và cố định: ô chữ tự do thì người báo viết cả
/// đoạn tâm sự, còn người xử lý phải đọc hết mới biết chuyện gì.
enum LyDoBaoXau {
  RAC
  XUC_PHAM
  SAI_SU_THAT
  KHAC
}

enum TrangThaiBaoXau {
  CHO_XEM
  DA_XU_LY
  BO_QUA
}

/// Một lượt báo xấu.
///
/// Ba cột trỏ tới ba loại nội dung, và ĐÚNG MỘT cột có giá trị mỗi lần. Cách
/// kia — một cột `loai` kèm một cột `mucId` chung — thì gọn hơn khi viết,
/// nhưng CSDL không ràng buộc được gì cả: xoá một bài đánh giá là mấy lượt báo
/// nó ở lại thành rác trỏ vào hư không. Ba khoá ngoại thật thì `Cascade` tự
/// dọn, không cần nhớ.
///
/// `@@unique` với cột cho phép rỗng: Postgres coi mỗi NULL là một giá trị
/// riêng, nên ba ràng buộc này chặn đúng "một người báo một mục một lần" mà
/// không chặn nhầm hai lượt báo hai mục khác nhau.
model BaoXau {
  id      String    @id @default(cuid())
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  danhGiaId String?
  danhGia   DanhGia? @relation(fields: [danhGiaId], references: [id], onDelete: Cascade)
  chuDeId   String?
  chuDe     ChuDe?   @relation(fields: [chuDeId], references: [id], onDelete: Cascade)
  traLoiId  String?
  traLoi    TraLoi?  @relation(fields: [traLoiId], references: [id], onDelete: Cascade)

  lyDo   LyDoBaoXau
  ghiChu String?

  trangThai TrangThaiBaoXau @default(CHO_XEM)
  taoLuc    DateTime        @default(now())

  @@unique([nguoiId, danhGiaId])
  @@unique([nguoiId, chuDeId])
  @@unique([nguoiId, traLoiId])
  @@index([trangThai, taoLuc])
}

/// Loại thông báo. Quyết định biểu tượng và màu, không quyết định câu chữ —
/// câu chữ chốt sẵn lúc tạo, xem chú thích ở model.
/*
 * ĐƠN XIN LÀM TÁC GIẢ.
 *
 * Trước đây trang mời làm tác giả chỉ nói "nhắn cho ban quản trị" — tức là lối
 * đi duy nhất nằm NGOÀI cửa hàng, mà ban quản trị thì cũng chẳng có chỗ nào để
 * xem ai đã nhắn. Người muốn đăng game phải tự tìm cách liên lạc, còn người
 * xét thì lục tin nhắn. Cả hai đầu đều hỏng.
 *
 * Mỗi người MỘT đơn (`@unique`), và đơn bị trả lại thì sửa chính nó rồi gửi
 * lại: giữ một dãy đơn cũ của cùng một người chỉ khiến hàng chờ dài ra mà
 * chẳng nói thêm điều gì.
 */
enum TrangThaiDon {
  CHO_XEM
  DONG_Y
  TU_CHOI
}

model DonTacGia {
  id      String   @id @default(cuid())
  nguoiId String   @unique
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  /// Tên muốn bày ở trang tác giả — có thể khác tên tài khoản.
  tenTacGia  String
  gioiThieu  String? @db.Text
  /// Định đăng game gì: câu này là thứ ban quản trị đọc để quyết.
  lyDo       String  @db.Text

  trangThai TrangThaiDon @default(CHO_XEM)
  /// Vì sao bị trả lại — người gửi đọc đúng câu này.
  loiNhan   String?

  taoLuc DateTime  @default(now())
  xetLuc DateTime?

  @@index([trangThai, taoLuc])
}

enum LoaiThongBao {
  TRA_LOI_CHU_DE
  /// Có người đáp thẳng vào MỘT BÀI của bạn, không phải chỉ trả lời chủ đề.
  DAP_BAI_CUA_BAN
  /// Bài của bạn được chọn làm lời giải cho chủ đề.
  BAI_THANH_LOI_GIAI
  /// Có người nhắc tên bạn trong một bài viết.
  DUOC_NHAC_TEN
  DAP_DANH_GIA
  TRA_LOI_YEU_CAU
  GO_NOI_DUNG
  GAME_CO_BAN_MOI
  GAME_DA_DUYET
  GAME_BI_TU_CHOI
  TAC_GIA_DUOC_DUYET
  TAC_GIA_BI_TU_CHOI
}

/// Một thông báo gửi tới một người.
///
/// CHỐT SẴN câu chữ và đường dẫn ngay lúc tạo, KHÔNG trỏ khoá ngoại sang nội
/// dung gốc. Ngược hẳn với `BaoXau`, và có lý do: một lượt báo chỉ có nghĩa
/// khi nội dung còn đó, nên nó phải chết theo. Còn thông báo thì phải sống
/// LÂU HƠN thứ sinh ra nó — "bài của bạn đã bị gỡ" mà lại biến mất cùng lúc
/// với bài ấy thì người nhận không bao giờ biết chuyện gì đã xảy ra.
///
/// Cái giá: sửa tiêu đề một chủ đề thì thông báo cũ vẫn ghi tên cũ. Chấp nhận
/// được — thông báo là ảnh chụp một khoảnh khắc, không phải cửa sổ nhìn vào
/// hiện tại.
model ThongBao {
  id      String    @id @default(cuid())
  nguoiId String
  nguoi   NguoiDung @relation(fields: [nguoiId], references: [id], onDelete: Cascade)

  loai     LoaiThongBao
  tieuDe   String
  chiTiet  String?
  /// Chỗ bấm vào. Rỗng nghĩa là không còn chỗ nào để đi tới (nội dung đã gỡ).
  duongDan String?

  daDoc  Boolean  @default(false)
  taoLuc DateTime @default(now())

  @@index([nguoiId, daDoc, taoLuc])
}

/// Lượt đăng nhập HỎNG, để chặn dò mật khẩu.
///
/// Ghi ở CSDL chứ không giữ trong bộ nhớ tiến trình: bộ nhớ mất sạch mỗi lần
/// khởi động lại, mà khởi động lại là thứ kẻ dò có thể tự gây ra; và chạy
/// nhiều tiến trình thì mỗi tiến trình đếm một kiểu, nên ngưỡng 8 lần hoá ra
/// 8 lần NHÂN số tiến trình.
///
/// `khoa` là định danh người ta gõ vào (email hoặc tên đăng nhập) đã hạ về chữ
/// thường, hoặc địa chỉ IP. Không lưu mật khẩu đã thử — biết thêm chuỗi ấy
/// chẳng để làm gì, mà lỡ lộ bảng này thì lộ luôn mật khẩu người gõ nhầm ô.
model LanHong {
  khoa   String   @id
  soLan  Int      @default(0)
  /// Mốc bắt đầu đếm. Quá cửa sổ thì đếm lại từ đầu.
  tuLuc  DateTime @default(now())
  /// Cấm tới lúc này. Rỗng nghĩa là chưa bị cấm.
  camDen DateTime?

  @@index([camDen])
}

/*
 * QUYỀN RIÊNG TƯ CỦA GAME — chép theo bảng "App Privacy" của App Store.
 *
 * Apple bắt mọi nhà phát triển tự khai game mình chạm vào dữ liệu nào, rồi in
 * thẳng lên trang sản phẩm TRƯỚC khi người ta bấm tải. Lý do đơn giản: danh
 * sách quyền của Android chỉ hiện ra lúc cài, còn tệp JAR thì chẳng hiện gì —
 * tới lúc ấy người ta đã tải xong rồi, và phần lớn cứ bấm đồng ý cho xong.
 *
 * Đây là LỜI KHAI của người bày hàng, không phải kết quả cửa hàng đo được —
 * nên chữ trên trang phải nói rõ "nhà phát triển cho biết", đừng nói như thể
 * SunnyStore đã kiểm chứng.
 */

/// Nhóm dữ liệu. Danh sách ngắn và cố định: ô chữ tự do thì mỗi game khai một
/// kiểu, và người đọc không so nổi hai game với nhau.
enum LoaiDuLieu {
  DANH_TINH
  DANH_BA
  VI_TRI
  ANH_VA_PHIM
  NOI_DUNG_NGUOI_DUNG
  LICH_SU_TIM
  MUA_HANG
  DU_LIEU_SU_DUNG
  CHAN_DOAN
  KHAC
}

/// Dữ liệu ấy đi tới đâu — ba mức của App Store, xếp từ nặng tới nhẹ.
enum MucDuLieu {
  /// Dùng để theo dõi bạn sang ứng dụng và trang của công ty khác.
  THEO_DOI
  /// Liên kết với danh tính của bạn.
  LIEN_KET
  /// Thu thập nhưng không gắn với danh tính nào.
  KHONG_LIEN_KET
}

model DuLieuThuThap {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  loai LoaiDuLieu
  muc  MucDuLieu

  /// Một game khai một nhóm dữ liệu ở một mức ĐÚNG MỘT LẦN. Không chặn thì
  /// bấm lưu hai lần là bảng có hai hàng y hệt, và trang game in trùng.
  @@unique([gameId, loai, muc])
  @@index([gameId])
}
