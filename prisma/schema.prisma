// Nova Platform — Prisma schema
// PostgreSQL + Auth.js (credentials + OAuth) + SePay

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Auth.js adapter models)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  passwordHash  String?
  image         String?
  cover         String?
  bio           String?   @db.Text
  /// Tâm trạng — dòng chữ ngắn hiện cạnh tên, đổi xoành xoạch. Mod "tâm
  /// trạng" là thứ forum wap Việt nào quãng 2010 cũng gắn thêm.
  mood          String?
  /**
   * Chữ ký — dán dưới mỗi bài viết của người này ở diễn đàn.
   * Forum Việt thời 2010 nhà nào cũng có; nhận BBCode như nội dung bài.
   */
  signature     String?   @db.Text

  role   Role       @default(USER)
  status UserStatus @default(ACTIVE)

  // Kinh tế — chỉ còn MỘT loại: điểm, kiếm được bằng hoạt động trên diễn đàn.
  points Int @default(0)

  /**
   * Uy tín — tổng các lần thành viên khác chấm "+" và "−" cho người này.
   * Cộng dồn sẵn ở đây thay vì đếm lại bảng KarmaVote mỗi lần in tên: con số
   * này hiện cạnh nick ở MỌI bài trong chủ đề, đếm lại thì mỗi trang chủ đề
   * thêm vài chục lượt gom nhóm chỉ để ra một số nhỏ.
   */
  karma Int @default(0)

  // Cấp độ / kinh nghiệm
  exp   Int @default(0)
  level Int @default(1)

  // Điểm danh
  checkinStreak    Int       @default(0)
  lastCheckinAt    DateTime?
  totalCheckinDays Int       @default(0)

  // Mời bạn
  inviteCode  String? @unique
  invitedById String?
  invitedBy   User?   @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    User[]  @relation("Invites")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  /**
   * Mốc "đã đọc hết diễn đàn" — bấm một nút là mọi chủ đề cũ hơn mốc này hết
   * được coi là mới.
   * Có mốc chung thì nút ấy làm được trong một lần ghi, thay vì phải chèn một
   * hàng ThreadRead cho từng chủ đề trong cả diễn đàn.
   */
  forumReadAt DateTime?

  accounts      Account[]
  sessions      Session[]
  comments      Comment[]
  threads       Thread[]
  replies       Reply[]
  reactions     Reaction[]
  favorites     Favorite[]
  pointsLogs    PointsLog[]
  medals        UserMedal[]
  notifications Notification[]
  followers     Follow[]          @relation("Following")
  following     Follow[]          @relation("Follower")
  reportsMade   Report[]          @relation("Reporter")
  bans          Ban[]
  blocksMade    Block[]           @relation("Blocker")
  blocksAgainst Block[]           @relation("Blocked")
  convosA       Conversation[]    @relation("ConvoA")
  convosB       Conversation[]    @relation("ConvoB")
  messagesSent  Message[]
  msgReactions  MessageReaction[]
  threadFollows ThreadFollow[]
  pollVotes     PollVote[]

  /// Các loại thông báo người dùng đã tắt (chỉ áp dụng cho loại được phép tắt).
  notifyOff NotificationType[] @default([])
  adminLogs AdminLog[]         @relation("AdminLogActor")

  gameEvents  GameEvent[]
  gameRatings GameRating[]

  shouts        ShoutMessage[]
  shoutsDeleted ShoutMessage[]     @relation("ShoutDeleter")
  gameUnlocks   GameUnlock[]
  gameVersionUnlocks GameVersionUnlock[]
  hideUnlocks   ThreadHideUnlock[]

  clubsOwned        Club[]            @relation("ClubOwner")
  clubMemberships   ClubMember[]
  clubPosts         ClubPost[]
  clubPostLikes     ClubPostLike[]
  clubComments      ClubComment[]
  clubCommentLikes  ClubCommentLike[]
  presence          PresenceHere[]
  donationsSent     PointDonation[]   @relation("DonationFrom")
  donationsReceived PointDonation[]   @relation("DonationTo")

  guestbookReceived GuestbookEntry[] @relation("GuestbookOwner")
  guestbookWritten  GuestbookEntry[] @relation("GuestbookAuthor")
  guestbookHidden   GuestbookEntry[] @relation("GuestbookHider")

  gameRequests        GameRequest[]     @relation("GameRequestBy")
  gameRequestsHandled GameRequest[]     @relation("GameRequestHandler")
  gameRequestVotes    GameRequestVote[]

  friendRequestsSent     Friendship[] @relation("FriendRequester")
  friendRequestsReceived Friendship[] @relation("FriendAddressee")

  albums PhotoAlbum[]
  photos Photo[]

  karmaGiven    KarmaVote[] @relation("KarmaFrom")
  karmaReceived KarmaVote[] @relation("KarmaTo")

  threadReads ThreadRead[]

  // Cửa hàng: đồ đã mua, và đồ đang đeo (mỗi loại đeo được một món).
  shopPurchases ShopPurchase[]
  nameColorId   String?
  nameColor     ShopItem?      @relation("EquipNameColor", fields: [nameColorId], references: [id], onDelete: SetNull)
  shopBadgeId   String?
  shopBadge     ShopItem?      @relation("EquipBadge", fields: [shopBadgeId], references: [id], onDelete: SetNull)

  quizQuestions QuizQuestion[] @relation("QuizAuthor")
  quizReviewed  QuizQuestion[] @relation("QuizReviewer")
  quizAnswers   QuizAnswer[]
  quizComments  QuizComment[]  @relation("QuizCommentAuthor")
  farmPlots     FarmPlot[]
  farmBarn      FarmBarn[]
  farmSeeds     FarmSeed[]
  farmFerts     FarmFert[]
  farmOrders    FarmOrder[]
  pokeNhanVat   PokeNhanVat?
  rong          Rong[]
  rongHoSo      RongNguoiChoi?
  rongDo        RongDo[]
  rongLuotDau   RongLuotDau[]
  /// Lần hái cây khế gần nhất — nguồn điểm nhỏ, không mất gì, mỗi giờ một lần.
  lastTreeAt    DateTime?

  /// Danh hiệu = tên bậc của cấp hiện tại, chép sẵn từ `LevelRule.name`.
  ///
  /// Chép chứ không tra bảng lúc dựng giao diện: hơn hai mươi chỗ hiện tên
  /// người dùng chỉ cầm theo bộ trang trí, bắt từng chỗ tự tra bảng cấp là chắc
  /// chắn có chỗ quên. Ghi ở đúng hai nơi — lúc lên cấp (`addExp`) và lúc quản
  /// trị sửa bậc (`saveLevelRule`) — và có `scripts/soat-bo-dem.mjs` đối soát.
  levelTitle String?

  @@index([level])
  @@index([createdAt])
}

enum Role {
  USER
  AUTHOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// THẺ — dùng chung cho chủ đề diễn đàn và kho game
// ============================================================

model Tag {
  id      String          @id @default(cuid())
  slug    String          @unique
  name    String
  threads TagsOnThreads[]
  games   TagsOnGames[]
}

// ============================================================
// FORUM — diễn đàn
// ============================================================

model Forum {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  cover       String?
  order       Int     @default(0)

  postAccess ForumAccess @default(ALL)
  minLevel   Int         @default(1)

  /**
   * Huy hiệu bắt buộc để XEM khu vực này — khác `postAccess`/`minLevel` vốn
   * chỉ chặn việc mở chủ đề mới, còn xem thì ai cũng xem được. Đặt cái này
   * là khoá cả việc xem: khu vực vẫn hiện tên trong danh sách (không giấu sự
   * tồn tại), nhưng mở vào thì chỉ thấy lời nhắc cần huy hiệu gì, không lộ
   * chủ đề hay bài viết bên trong.
   */
  requiredMedalId String?
  requiredMedal   Medal?  @relation(fields: [requiredMedalId], references: [id], onDelete: SetNull)

  threadCount Int @default(0)
  replyCount  Int @default(0)

  parentId String?
  parent   Forum?  @relation("ForumTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Forum[] @relation("ForumTree")

  threads    Thread[]
  moderators ForumModerator[]

  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([requiredMedalId])
}

enum ForumAccess {
  ALL
  MEMBERS
  MODERATORS
}

model ForumModerator {
  id      String @id @default(cuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([forumId, userId])
}

model Thread {
  id      String @id @default(cuid())
  forumId String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title         String
  content       String  @db.Text
  // Mã BBCode gốc — giữ để sửa chủ đề không mất định dạng.
  contentSource String? @db.Text

  status   ThreadStatus @default(PUBLISHED)
  pinned   Boolean      @default(false)
  locked   Boolean      @default(false)
  featured Boolean      @default(false)

  // Thưởng / hỏi đáp
  bountyPoints  Int?
  solvedReplyId String? @unique

  viewCount  Int @default(0)
  replyCount Int @default(0)
  likeCount  Int @default(0)

  lastReplyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  replies     Reply[]
  tags        TagsOnThreads[]
  reactions   Reaction[]
  favorites   Favorite[]
  reports     Report[]
  followers   ThreadFollow[]
  reads       ThreadRead[]
  poll        Poll?
  donations   PointDonation[]
  hideUnlocks ThreadHideUnlock[]

  @@index([forumId, lastReplyAt])
  @@index([authorId])
  @@index([pinned])
}

/// Bình chọn gắn vào một chủ đề — mỗi chủ đề nhiều nhất một cuộc.
model Poll {
  id       String @id @default(cuid())
  threadId String @unique
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  question String
  /// Cho chọn nhiều đáp án cùng lúc.
  multiple Boolean   @default(false)
  /// Hết hạn thì khoá lại và ai cũng xem được kết quả. null = không hạn.
  closesAt DateTime?
  /// Chủ đề/quản trị đóng sớm.
  closed   Boolean   @default(false)

  createdAt DateTime @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text  String
  order Int    @default(0)

  votes PollVote[]

  @@index([pollId, order])
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

/// Theo dõi chủ đề: có trả lời mới thì được báo, kể cả không phải chủ chủ đề.
model ThreadFollow {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@index([userId, createdAt])
}

/**
 * Lần cuối một người mở một chủ đề — để đánh dấu chủ đề có bài mới.
 * Chỉ ghi mốc thời gian, không ghi "đã đọc tới bài số mấy": danh sách chủ đề
 * chỉ cần biết có gì mới sau lần mình ghé hay không, mà mốc thời gian thì so
 * thẳng được với `lastReplyAt` sẵn có, không phải đếm bài.
 */
model ThreadRead {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([userId, threadId])
  @@index([userId, readAt])
}

enum ThreadStatus {
  PUBLISHED
  PENDING
  HIDDEN
  DELETED
}

model TagsOnThreads {
  threadId String
  tagId    String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model Reply {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Reply?  @relation("ReplyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Reply[] @relation("ReplyTree")

  likeCount  Int     @default(0)
  isSolution Boolean @default(false)
  hidden     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]
  reports   Report[]
  donations PointDonation[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ============================================================
// COMMENTS (trên bài viết)
// ============================================================

model Comment {
  id String @id @default(cuid())

  // Bình luận của kho game. Trước còn gắn được vào bài viết nữa, nhưng mục
  // bài viết đã bỏ nên chỉ còn một cột. Giữ nguyên kiểu "một cột cho mỗi đối
  // tượng" mà Reaction và Favorite đang dùng, phòng khi có thêm chỗ cần.
  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentTree")

  likeCount Int     @default(0)
  pinned    Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  /// Bình luận cũ chưa có cột này nên lấy now() làm mốc, coi như chưa từng sửa.
  updatedAt DateTime @default(now()) @updatedAt

  reactions Reaction[]
  reports   Report[]

  @@index([gameId, createdAt])
}

// ============================================================
// TƯƠNG TÁC
// ============================================================

model Reaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ReactionType @default(LIKE)

  threadId  String?
  replyId   String?
  commentId String?

  thread  Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply   Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, threadId, type])
  @@unique([userId, replyId, type])
  @@unique([userId, commentId, type])
}

enum ReactionType {
  LIKE
  DISLIKE
  HELPFUL
  /// Nút "Cảm ơn" của forum Việt ngày xưa — khác Thích ở chỗ nó công khai
  /// danh sách người đã cảm ơn ngay dưới bài, và một người vẫn vừa thích
  /// vừa cảm ơn được (ràng buộc duy nhất đã tính cả `type`).
  THANKS
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadId String?
  gameId   String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  folder String @default("default")

  createdAt DateTime @default(now())

  @@unique([userId, threadId])
  @@unique([userId, gameId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ============================================================
// KINH TẾ — chỉ còn điểm và sổ ghi quyền mở khoá nội dung
// ============================================================

model PointsLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount  Int // +/- 
  balance Int // số dư sau giao dịch
  reason  PointsReason
  note    String?
  refId   String? // id đối tượng liên quan

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum PointsReason {
  CHECKIN
  /// Của mục bài viết đã bỏ. Giữ lại vì sổ điểm cũ còn hàng ghi lý do này —
  /// bỏ đi là mất luôn dòng lịch sử, mà lịch sử điểm thì không được phép mất.
  POST_CREATE
  COMMENT_CREATE
  THREAD_CREATE
  REPLY_CREATE
  RECEIVED_LIKE
  INVITE_BONUS
  PURCHASE_CONTENT // mở khoá khối [hide=diem:N] trong bài diễn đàn
  CONTENT_SALE // tác giả nhận từ lượt mở khoá ấy
  ADMIN_ADJUST
  EXCHANGE
  BOUNTY_PAID
  BOUNTY_RECEIVED
  /// Cũng của mục bài viết đã bỏ, giữ lại vì lý do như POST_CREATE.
  COUPON
  DONATE_SENT // tặng điểm cho bài của người khác
  DONATE_RECEIVED // nhận điểm người khác tặng
  SHOP_BUY // mua đồ trang trí ở cửa hàng
  SHOP_REFUND // hoàn điểm khi một loại đồ thôi bán
  GAME_BET // đặt cược ở khu giải trí
  GAME_WIN // thắng cược ở khu giải trí
  QUIZ_STAKE // đặt cọc khi đăng câu hỏi trắc nghiệm
  QUIZ_WIN // ăn cọc của người ra câu hỏi (hoặc ngược lại)
  FARM_SEED // mua hạt giống
  FARM_SELL // bán nông sản
  FARM_PLOT // mở thêm ô đất
  FARM_TREE // hái cây khế
  RONG_TRUNG // mua trứng rồng
  RONG_AN // cho rồng ăn
  RONG_DAU // phí ghi danh đấu trường
  RONG_THANG // thắng ở đấu trường rồng
}

// ============================================================
// GAMIFICATION — huy chương, cấp độ
// ============================================================

model Medal {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String
  color       String?
  rarity      Int     @default(1)

  autoGrant      Boolean @default(false)
  conditionType  String? // posts_count | checkin_streak | ...
  conditionValue Int?

  users  UserMedal[]
  forums Forum[]

  createdAt DateTime @default(now())
}

model UserMedal {
  id      String @id @default(cuid())
  userId  String
  medalId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal   Medal  @relation(fields: [medalId], references: [id], onDelete: Cascade)

  displayed Boolean   @default(true)
  expiresAt DateTime?
  grantedAt DateTime  @default(now())

  @@unique([userId, medalId])
}

model LevelRule {
  id          String  @id @default(cuid())
  level       Int     @unique
  /// Tên bậc — cũng là DANH HIỆU hiện cạnh tên (chép sang `User.levelTitle`).
  name        String
  expRequired Int
  color       String?

  // Quyền lợi theo cấp
  dailyDownloadLimit Int?
  canPostThread      Boolean @default(true)
  canUploadFile      Boolean @default(false)
}

// ============================================================
// THÔNG BÁO / TIN NHẮN
// ============================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  content String?          @db.Text
  link    String?
  actorId String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

enum NotificationType {
  COMMENT
  REPLY
  MENTION
  LIKE
  FOLLOW
  SYSTEM
  MEDAL
  /// Được người khác tặng điểm.
  DONATE
  /// Có người ghi vào sổ lưu bút, hoặc chủ nhà hồi âm lời nhắn của mình.
  GUESTBOOK
  /// Lời mời kết bạn, hoặc lời mời của mình được đồng ý.
  FRIEND
  /// Được người khác chấm uy tín (+ hoặc −).
  KARMA
  /// Việc của câu lạc bộ: có người xin vào, hoặc đơn của mình được duyệt.
  CLUB
}

// ============================================================
// KIỂM DUYỆT
// ============================================================

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  threadId  String?
  replyId   String?
  commentId String?
  gameId    String?
  // SetNull chứ KHÔNG Cascade: gỡ nội dung bị báo cáo mà cuốn theo luôn tờ báo
  // cáo thì mất sạch lịch sử xử lý, và `resolveReportAndRemove` xoá xong không
  // còn hàng nào để đánh dấu RESOLVED — cả giao dịch đổ, nội dung cũng không gỡ
  // được. Để null thì báo cáo còn nguyên ở tab "Đã xử lý", và `hasTarget` ở
  // trang quản trị tự thành false đúng như nó vẫn chờ.
  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  reply     Reply?   @relation(fields: [replyId], references: [id], onDelete: SetNull)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  reason    String
  detail    String?      @db.Text
  status    ReportStatus @default(OPEN)
  handledAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Ban {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason    String
  scope     BanScope  @default(FULL)
  expiresAt DateTime?
  createdBy String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum BanScope {
  FULL
  /// Cấm bình luận.
  COMMENT
  /// Cấm đăng bài — chủ đề diễn đàn, không dính gì tới mục bài viết đã bỏ.
  POST
  FORUM
}

// ============================================================
// CẤU HÌNH / TRANG CHỦ
// ============================================================

model StickerPack {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  order  Int     @default(0)
  active Boolean @default(true)

  stickers Sticker[]

  createdAt DateTime @default(now())
}

model Sticker {
  id     String      @id @default(cuid())
  packId String
  pack   StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  name       String
  url        String  @db.Text
  /**
   * Khoá đối tượng trên R2 để xoá được khi gỡ pack.
   */
  storageKey String? @db.Text
  order      Int     @default(0)

  @@index([packId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Slide {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  image    String
  link     String?
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
}

model NavLink {
  id    String  @id @default(cuid())
  label String
  url   String
  icon  String?
  order Int     @default(0)
  group String  @default("header") // header | footer | sidebar

  parentId String?
  parent   NavLink?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavLink[] @relation("NavTree")
}

model FriendLink {
  id          String  @id @default(cuid())
  name        String
  url         String
  logo        String?
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)
}

// ============================================================
// GAME HUB — catalog game Java ME
// ============================================================

model Game {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String // tên chính thức
  titleVi String? // tên bản Việt hóa
  series  String? // dòng game (Contra, Asphalt…)

  description String? @db.Text // mô tả
  gameplay    String? @db.Text // lối chơi
  icon        String? // ảnh icon (URL/storage key)
  cover       String? // ảnh nền trang chi tiết
  trailerUrl  String? // video/trailer tuỳ chọn

  developer   String?
  publisher   String?
  releaseYear Int?

  language    String  @default("en") // en | vi | multi
  vietnamized Boolean @default(false) // bản Việt hóa

  status   GameStatus @default(DRAFT)
  featured Boolean    @default(false)

  /**
   * Số điểm phải trả để mở phần tải xuống. null hoặc 0 = tải tự do.
   * Trả một lần là mở mãi, ghi lại bằng GameUnlock.
   */
  pricePoints Int?

  // Phân loại
  platformId   String?
  platform     GamePlatform?        @relation(fields: [platformId], references: [id], onDelete: SetNull)
  resolutionId String?
  resolution   GameResolution?      @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  genres       GenresOnGames[]
  tags         TagsOnGames[]

  // Hướng dẫn / lưu ý
  controls          Json? // [{ key, action }] — key mapping mô tả
  compatibilityNote String? @db.Text
  knownIssues       String? @db.Text

  // Thống kê
  ratingSum           Int   @default(0)
  ratingCount         Int   @default(0)
  commentCount        Int   @default(0)
  viewCount           Int   @default(0)
  uniqueViewCount     Int   @default(0)
  downloadCount       Int   @default(0)
  uniqueDownloadCount Int   @default(0)
  trendingScore       Float @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions   GameVersion[]
  images     GameImage[]
  events     GameEvent[]
  ratings    GameRating[]
  comments   Comment[]
  unlocks    GameUnlock[]
  favorites  Favorite[]
  reports    Report[]
  uniqueHits GameUniqueHit[]
  requests   GameRequest[]

  @@index([status, publishedAt])
  @@index([featured])
  @@index([trendingScore])
  @@index([platformId])
  @@index([resolutionId])
  @@index([vietnamized])
}

enum GameStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model GameGenre {
  id    String  @id @default(cuid())
  slug  String  @unique
  name  String
  icon  String?
  color String?
  order Int     @default(0)

  games GenresOnGames[]
}

model GenresOnGames {
  gameId  String
  genreId String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   GameGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
}

model TagsOnGames {
  gameId String
  tagId  String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
}

/// Nokia S40/S60, Sony Ericsson, Samsung, Motorola, Generic Java ME…
model GamePlatform {
  id    String  @id @default(cuid())
  slug  String  @unique
  name  String
  icon  String?
  order Int     @default(0)

  games Game[]
}

/// 128x160, 176x208, 176x220, 240x320, 320x240, 360x640, custom…
model GameResolution {
  id     String  @id @default(cuid())
  slug   String  @unique // "240x320"
  label  String // "240 × 320"
  width  Int
  height Int
  custom Boolean @default(false)
  order  Int     @default(0)

  games Game[]
}



// ── Versioning ────────────────────────────────────────────

model GameVersion {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Bản tải này dành cho nền tảng nào. Mỗi nền tảng có dãy version riêng.
  platform    DownloadPlatform @default(JAR)
  version     String // "1.0.2"
  releaseDate DateTime?
  changelog   String?          @db.Text
  sizeBytes   BigInt? // tổng dung lượng của bản tải
  /// Bản mới nhất **của nền tảng này** — mỗi nền tảng đúng một bản.
  latest      Boolean          @default(false)
  note        String?

  /**
   * Giá điểm RIÊNG của bản này. null hoặc 0 = tải tự do (nếu game cũng
   * không khoá). Tách khỏi `Game.pricePoints`: một game có thể miễn phí bản
   * cũ mà thu điểm bản mới, hoặc mỗi nền tảng một giá khác nhau — khoá theo
   * game thì không nói được chuyện đó, vì cả game chỉ có một cái khoá.
   */
  pricePoints Int?

  createdAt DateTime @default(now())

  files   GameFile[]
  events  GameEvent[]
  unlocks GameVersionUnlock[]

  @@unique([gameId, platform, version])
  @@index([gameId, platform, latest])
}

/**
 * Ai đã trả điểm để mở một PHIÊN BẢN cụ thể — khác `GameUnlock` vốn mở cả
 * game. Một game có thể không khoá gì cả mà một bản nâng cấp trong đó vẫn
 * thu điểm riêng, nên khoá phải theo từng version chứ gộp vào `GameUnlock`
 * là hai chuyện admin định giá độc lập với nhau lại chung một bảng.
 */
model GameVersionUnlock {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId String
  version   GameVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  pointsPaid Int

  createdAt DateTime @default(now())

  @@unique([userId, versionId])
  @@index([versionId, createdAt])
}

/// Nút tải trên trang chi tiết game. Khác `GamePlatform` (dòng máy để lọc catalog).
enum DownloadPlatform {
  WINDOWS
  MAC
  LINUX
  ANDROID
  IOS
  WEB
  JAR
}

model GameFile {
  id        String      @id @default(cuid())
  versionId String
  version   GameVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  type         GameFileType
  storageKey   String // key trên object storage / CDN
  fileName     String?
  sizeBytes    BigInt?
  checksum     String? // giá trị checksum
  checksumAlgo String       @default("sha256")
  mimeType     String?

  scanStatus ScanStatus @default(PENDING) // quét file trước khi phát hành
  scanNote   String?

  createdAt DateTime @default(now())

  @@unique([versionId, type])
  @@index([scanStatus])
}

enum GameFileType {
  JAR
  JAD
  APK
  IPA
  EXE
  MSI
  DMG
  PKG
  DEB
  ZIP
  PATCH
}

enum ScanStatus {
  PENDING
  CLEAN
  SUSPICIOUS
  QUARANTINED
}

model GameImage {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type       GameImageType @default(SCREENSHOT)
  storageKey String
  caption    String?
  width      Int?
  height     Int?
  sortOrder  Int           @default(0)

  createdAt DateTime @default(now())

  @@index([gameId, type, sortOrder])
}

enum GameImageType {
  ICON
  COVER
  SCREENSHOT
  TRAILER
}

// ── Sự kiện & thống kê ────────────────────────────────────

model GameEvent {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  versionId String?
  version   GameVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorKey String // userId hoặc hash(ip+ua) cho khách
  type     GameEventType
  isUnique Boolean       @default(false)
  value    Int? // ví dụ: thời lượng phiên (giây)
  meta     Json?

  createdAt DateTime @default(now())

  @@index([gameId, type, createdAt])
  @@index([type, createdAt])
  @@index([actorKey, type])
}

enum GameEventType {
  VIEW
  DOWNLOAD
  FAVORITE
  SHARE
  RATE
}

/// Khoá chống trùng cho "unique view / unique download / unique player".
model GameUniqueHit {
  id       String        @id @default(cuid())
  gameId   String
  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type     GameEventType
  actorKey String

  createdAt DateTime @default(now())

  @@unique([gameId, type, actorKey])
}

model GameRating {
  id     String @id @default(cuid())
  gameId String
  userId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int // 1..5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, userId])
  @@index([gameId])
}

// ============================================================
// TIN NHẮN RIÊNG
// ============================================================

model Conversation {
  id String @id @default(cuid())

  // Hội thoại 1–1. Luôn lưu userAId < userBId để một cặp chỉ có một hội thoại,
  // nhờ vậy @@unique chặn được trùng bất kể ai nhắn trước.
  userAId String
  userBId String
  userA   User   @relation("ConvoA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User   @relation("ConvoB", fields: [userBId], references: [id], onDelete: Cascade)

  // Tuỳ chỉnh dùng chung cho cả hai người, giống cách các app chat vẫn làm.
  theme           String    @default("default") // ảnh nền khung chat
  bubble          String    @default("default") // kiểu bong bóng
  nicknameA       String? // biệt danh đặt cho userA
  nicknameB       String? // biệt danh đặt cho userB
  // Số giờ giữ tin trước khi tự xoá; null = không tự xoá
  autoDeleteHours Int?
  // Mốc bật tự xoá. Chỉ tin gửi TỪ mốc này trở đi mới bị xoá — bật tính năng
  // không được phép thổi bay lịch sử đã có từ trước.
  autoDeleteFrom  DateTime?

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content   String    @db.Text
  readAt    DateTime?
  /**
   * Đã thu hồi: giữ lại bản ghi để tin trích dẫn nó không bị hụt.
   */
  deletedAt DateTime?

  // Trả lời một tin cụ thể trong cùng hội thoại
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  createdAt DateTime @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

/**
 * Cảm xúc thả lên một tin nhắn — mỗi người một cảm xúc cho mỗi tin.
 */
model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

/**
 * Chặn giữa hai thành viên: cắt nhắn tin và theo dõi cả hai chiều.
 */
model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/**
 * Nhật ký hành động quản trị. Ghi lại ai làm gì, lên đối tượng nào —
 * để đối soát khi có tranh chấp và tìm ra nguồn của một thay đổi bất thường.
 * Xoá tài khoản admin vẫn giữ nguyên bản ghi (actorId -> null) nên lịch sử không mất.
 */
model AdminLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AdminLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  /**
   * Tên đăng nhập lúc thao tác — giữ lại phòng khi tài khoản bị xoá/đổi tên.
   */
  actorName String?

  /**
   * Khoá hành động dạng `nhóm.việc`, ví dụ `post.approve`.
   */
  action     String
  /**
   * Loại đối tượng bị tác động: post, user, thread… (null nếu là cài đặt chung).
   */
  targetType String?
  targetId   String?
  /**
   * Mô tả ngắn hiển thị trong danh sách, đã kèm tên đối tượng.
   */
  summary    String  @db.Text
  /**
   * Dữ liệu phụ (giá trị trước/sau, lý do…) để soi khi cần.
   */
  meta       Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/**
 * Ảnh nền khung chat do admin tải lên.
 */
model ChatBackground {
  id     String  @id @default(cuid())
  name   String
  image  String // đường dẫn ảnh admin tải lên
  /**
   * Ảnh tối: chữ phụ trong khung chat phải sáng lên mới đọc được.
   */
  dark   Boolean @default(false)
  active Boolean @default(true)
  order  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([active, order])
}

/**
 * Kiểu bong bóng chat do admin tải lên: màu nền + ảnh trang trí phía trên.
 */
model ChatBubbleStyle {
  id          String  @id @default(cuid())
  name        String
  /**
   * Ảnh gắn trên bong bóng (tai chibi, nơ…). Để trống thì chỉ đổi màu.
   */
  decor       String?
  colorMine   String
  colorTheirs String
  /**
   * Chữ trong bong bóng là màu đậm hay trắng.
   */
  darkText    Boolean @default(true)
  active      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([active, order])
}

// ============================================================
// PHÒNG CHAT CHUNG — "chat tổng" kiểu forum wap ngày xưa
// ============================================================

/**
 * Một câu nói trong phòng chat chung.
 * Khác hẳn Message (nhắn riêng 1–1): đây là dòng chảy công khai, ai vào cũng
 * đọc được, chỉ giữ lại một số lượng gần đây. Xoá là xoá mềm để chỗ trống
 * trong hội thoại vẫn nhìn ra là "đã bị gỡ" chứ không lặng lẽ biến mất.
 */
model ShoutMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String @db.Text

  /**
   * Trả lời một câu cụ thể — giữ lại nếp "@ai đó" của phòng chat cũ.
   */
  replyToId String?
  replyTo   ShoutMessage?  @relation("ShoutReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ShoutMessage[] @relation("ShoutReply")

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ShoutDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/**
 * Ai đang ở trong một chủ đề / trong phòng chat ngay lúc này.
 * Forum ngày xưa trang nào cũng có dòng "Đang xem chủ đề: A, B và 3 khách".
 * Một hàng cho mỗi (người, chỗ); mở chỗ khác thì hàng cũ được ghi đè.
 * `scope` là 'thread:<id>' hoặc 'chat'.
 */
model PresenceHere {
  userId String
  scope  String
  at     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
  @@index([scope, at])
}

/**
 * Tặng điểm kèm lời cảm ơn.
 * Điểm đã cộng/trừ và ghi vào PointsLog rồi, nhưng bảng này giữ riêng để
 * dựng được dòng "N người đã tặng X điểm cho bài này" ngay dưới bài — moi ra
 * từ nhật ký điểm thì phải lọc theo cả reason lẫn refId, vừa chậm vừa dễ sai.
 */
model PointDonation {
  id String @id @default(cuid())

  fromId String
  from   User   @relation("DonationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("DonationTo", fields: [toId], references: [id], onDelete: Cascade)

  amount Int

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyId  String?
  reply    Reply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([replyId, createdAt])
  @@index([toId, createdAt])
}

/**
 * Ai đã trả điểm để mở phần tải của game nào.
 * Sổ ghi quyền mở khoá: mở rồi thì lần sau vào không bị đòi
 * điểm nữa, kể cả khi quản trị viên đổi giá.
 */
model GameUnlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /**
   * Số điểm thực trả lúc mở, giữ lại để đối soát khi giá đổi.
   */
  pointsPaid Int

  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}

/**
 * Ai đã trả điểm để mở khối `[hide=diem:N]` của chủ đề nào.
 * Ghi ở mức CHỦ ĐỀ chứ không phải từng khối: một chủ đề có thể có mấy khối ẩn,
 * mà bắt trả riêng từng khối thì vừa khó đếm cho người đọc vừa khó dò cho ta —
 * khối không có mã định danh riêng, thứ tự lại đổi mỗi lần người đăng sửa bài.
 */
model ThreadHideUnlock {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /**
   * Số điểm thực trả lúc mở, giữ lại để đối soát khi người đăng sửa giá.
   */
  pointsPaid Int

  createdAt DateTime @default(now())

  @@unique([userId, threadId])
  @@index([threadId, createdAt])
}

/**
 * Sổ lưu bút trên trang cá nhân.
 * Khách ghé qua để lại một lời nhắn công khai ngay trên hồ sơ, chủ nhà hồi âm
 * ngay dưới lời nhắn đó — đúng nếp sổ lưu bút của forum wap Việt thời 2010.
 * Khác tin nhắn riêng ở chỗ cả làng đọc được; khác bình luận ở chỗ nó gắn vào
 * *người* chứ không gắn vào bài nào.
 */
model GuestbookEntry {
  id String @id @default(cuid())

  /// Chủ nhà — người sở hữu trang cá nhân đang được ghi vào.
  ownerId  String
  owner    User   @relation("GuestbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Người để lại lời nhắn.
  authorId String
  author   User   @relation("GuestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  /// Hồi âm của chủ nhà, hiện ngay dưới lời nhắn.
  reply     String?   @db.Text
  repliedAt DateTime?

  /// Lời nhắn kín: chỉ chủ nhà, người viết và quản trị đọc được.
  private Boolean @default(false)

  hiddenAt   DateTime?
  hiddenById String?
  hiddenBy   User?     @relation("GuestbookHider", fields: [hiddenById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([authorId, createdAt])
}

/**
 * Yêu cầu game — chỗ người dùng xin một game mà kho chưa có.
 * Kho game chỉ quản trị viên đăng, nên không có yêu cầu game thì người dùng
 * không có cách nào nói ra là mình đang tìm gì. Trang "yêu cầu game" là mục
 * quen thuộc của ovigame / phonho ngày trước, và nó cũng là danh sách việc
 * cần làm cho người quản kho.
 */
model GameRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation("GameRequestBy", fields: [userId], references: [id], onDelete: Cascade)

  title String
  /// Mô tả thêm: dòng máy, độ phân giải, bản Việt hoá hay bản gốc…
  note  String? @db.Text

  status    GameRequestStatus @default(PENDING)
  /// Lời nhắn của người quản kho khi đổi trạng thái.
  adminNote String?           @db.Text

  /// Game đã lên kho để đáp ứng yêu cầu này.
  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  /// Số người bấm "tôi cũng muốn" — đếm sẵn để xếp hạng khỏi phải đếm lại.
  voteCount Int @default(0)

  handledAt   DateTime?
  handledById String?
  handledBy   User?     @relation("GameRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  votes GameRequestVote[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([voteCount])
}

enum GameRequestStatus {
  /// Chờ người quản kho xem.
  PENDING
  /// Đã nhận, đang tìm.
  ACCEPTED
  /// Đã có game trên kho.
  DONE
  /// Không làm được (không tìm ra, trùng, không hợp lệ…).
  REJECTED
}

/**
 * Một người bấm "tôi cũng muốn" cho một yêu cầu.
 */
model GameRequestVote {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  request   GameRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, requestId])
  @@index([requestId])
}

/**
 * Kết bạn hai chiều.
 * Theo dõi (Follow) là một chiều: mình theo ai đó không cần họ đồng ý. Kết bạn
 * thì phải cả hai gật — nếp của forum wap Việt ngày trước, và là thứ để sau
 * này giới hạn "chỉ bạn bè xem được".
 * Một hàng cho một cặp, giữ đúng chiều người gửi → người nhận để biết ai còn
 * phải bấm đồng ý. Muốn biết A và B có phải bạn không thì phải dò cả hai
 * chiều, nên đánh chỉ mục cho cả hai cột.
 */
model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status FriendStatus @default(PENDING)

  /// Lời nhắn kèm khi xin kết bạn.
  message String?

  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

enum FriendStatus {
  /// Đã gửi, chờ người kia đồng ý.
  PENDING
  /// Đã là bạn.
  ACCEPTED
}

/**
 * Album ảnh cá nhân.
 * Trang cá nhân thời forum wap Việt nào cũng có mục ảnh: vài tấm để khoe, vài
 * tấm chỉ cho bạn bè xem. Đây cũng là chỗ đầu tiên dùng tới quan hệ kết bạn:
 * mức "chỉ bạn bè" chỉ có nghĩa khi kết bạn là hai chiều.
 */
/**
 * Một lần chấm uy tín: ai chấm cho ai, cộng hay trừ, vì lý do gì.
 * Giữ từng lần chấm chứ không chỉ giữ con số tổng, vì trang uy tín của forum
 * ngày trước là một cuốn sổ công khai: ai chấm mình, chấm vì việc gì, ngày
 * nào. Không có sổ thì con số tổng chẳng khác gì lời đồn.
 */
model KarmaVote {
  id     String @id @default(cuid())
  fromId String
  from   User   @relation("KarmaFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("KarmaTo", fields: [toId], references: [id], onDelete: Cascade)

  /// Chỉ nhận +1 hoặc −1 — không có chuyện chấm một phát mười điểm uy tín.
  value  Int
  /// Bắt buộc ghi lý do: uy tín không lý do thì chỉ là chỗ để dìm nhau.
  reason String

  createdAt DateTime @default(now())

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

model PhotoAlbum {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  /// Ảnh bìa — lấy từ một ảnh trong album, giữ sẵn để khỏi phải truy vấn thêm.
  cover       String?

  privacy AlbumPrivacy @default(PUBLIC)

  /// Đếm sẵn số ảnh, để danh sách album không phải đếm lại từng cái.
  photoCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos Photo[]

  @@index([ownerId, createdAt])
}

enum AlbumPrivacy {
  /// Ai cũng xem được.
  PUBLIC
  /// Chỉ bạn bè (hai chiều) và chính chủ.
  FRIENDS
  /// Chỉ chính chủ.
  PRIVATE
}

model Photo {
  id String @id @default(cuid())

  albumId String
  album   PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  /// Giữ luôn chủ ảnh: kiểm quyền sửa/xoá không phải đi vòng qua album.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  url     String
  caption String?
  order   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([albumId, order, createdAt])
}

/**
 * Món đồ trong cửa hàng — mua bằng ĐIỂM, dùng để trang trí hồ sơ.
 * Đúng nếp JohnCMS ngày xưa: bỏ điểm ra mua màu nick, khung avatar, huy hiệu
 * rồi đeo lên cho cả diễn đàn thấy. Cửa hàng này KHÔNG dính tới tiền thật —
 * diễn đàn chỉ có một loại tiền là điểm.
 */
model ShopItem {
  id   String @id @default(cuid())
  slug String @unique

  kind ShopItemKind

  name        String
  description String?

  /**
   * Nội dung của món đồ, ý nghĩa tuỳ theo `kind`:
   * NAME_COLOR — một giá trị màu CSS (#hex, rgb(), hoặc linear-gradient()).
   * BADGE      — đường dẫn ảnh huy hiệu, hiện cạnh tên.
   * Cửa hàng CỐ Ý không bán avatar lẫn ảnh bìa: hai thứ ấy người dùng tự tải
   * lên ở trang cài đặt. Bán ảnh bìa thì món mua được sẽ đè lên ảnh người ta
   * tự chọn — tự dưng cướp mất chỗ của chính chủ. Danh hiệu cũng thôi bán: nó
   * là tên bậc theo cấp, thứ phải leo lên mới có.
   */
  value String

  pricePoints Int     @default(0)
  active      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  purchases ShopPurchase[]

  equippedNameColorBy User[] @relation("EquipNameColor")
  equippedBadgeBy     User[] @relation("EquipBadge")

  @@index([kind, active, order])
}

enum ShopItemKind {
  /// Màu tên hiển thị.
  NAME_COLOR
  /// Huy hiệu nhỏ hiện cạnh tên.
  BADGE
}

/**
 * Sổ ghi quyền sở hữu: ai đã mua món nào.
 * Mua một lần là của mãi mãi, kể cả khi quản trị viên gỡ món đó khỏi quầy hay
 * đổi giá — nên phải có bảng riêng chứ không suy ra từ nhật ký điểm.
 */
model ShopPurchase {
  id String @id @default(cuid())

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String
  item   ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Giá thực trả lúc mua, giữ lại để đối soát khi giá đổi.
  pointsPaid Int

  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId, createdAt])
}

// ============================================================
// CÂU LẠC BỘ — hội nhóm do thành viên tự lập
// ============================================================

enum ClubJoinMode {
  OPEN // bấm là vào
  APPROVAL // chủ câu lạc bộ duyệt
  CLOSED // không nhận thêm
}

enum ClubPrivacy {
  PUBLIC // ai cũng đọc được bảng tin
  MEMBERS // chỉ thành viên
}

enum ClubMemberRole {
  OWNER
  MOD
  MEMBER
}

enum ClubMemberStatus {
  /// Đã xin vào, chờ chủ nhóm duyệt.
  PENDING
  /// Được chủ nhóm mời, chờ chính người đó nhận lời.
  INVITED
  ACTIVE
}

/**
 * Một hội nhóm do thành viên lập, có bảng tin riêng.
 * Không dùng lại Forum: chuyên mục diễn đàn phân quyền theo vai trò và cấp,
 * còn ở đây quyền đọc/ghi phụ thuộc vào việc CÓ CHÂN trong nhóm hay không —
 * nhét thêm điều kiện ấy vào phân quyền chuyên mục thì mọi truy vấn diễn đàn
 * đều phải gánh một phép nối chẳng liên quan gì tới đại đa số chủ đề.
 */
model Club {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Tên viết tắt, hiện thành cái thẻ nhỏ cạnh tên mọi thành viên.
  ///
  /// Duy nhất toàn site: cái thẻ ấy chỉ có nghĩa khi nhìn vào là biết ngay
  /// nhóm nào — hai nhóm cùng viết tắt thì nó thành ra vô nghĩa. Cho phép rỗng
  /// vì những nhóm lập trước khi có mục này chưa kịp đặt.
  shortName String? @unique

  description String? @db.Text
  avatar      String?
  cover       String?

  ownerId String
  owner   User   @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  joinMode ClubJoinMode @default(OPEN)
  privacy  ClubPrivacy  @default(PUBLIC)

  /// Đếm sẵn để danh sách khỏi phải nối bảng đếm từng nhóm.
  memberCount Int @default(1)
  postCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ClubMember[]
  posts   ClubPost[]

  @@index([memberCount])
  @@index([createdAt])
}

model ClubMember {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   ClubMemberRole   @default(MEMBER)
  status ClubMemberStatus @default(ACTIVE)

  /// Ai mời — chỉ có ở hàng do lời mời sinh ra.
  invitedById String?

  createdAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([clubId, status, createdAt])
  @@index([userId, status])
}

model ClubPost {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content       String  @db.Text
  /// Mã BBCode gốc, giữ để sửa bài không mất định dạng.
  contentSource String? @db.Text

  /// Bài ghim luôn nằm trên đầu bảng tin.
  pinned Boolean @default(false)

  likeCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())

  likes    ClubPostLike[]
  comments ClubComment[]

  @@index([clubId, pinned, createdAt])
  @@index([clubId, createdAt])
}

model ClubPostLike {
  id     String   @id @default(cuid())
  postId String
  post   ClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model ClubComment {
  id     String   @id @default(cuid())
  postId String
  post   ClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  likeCount Int @default(0)

  /// Bình luận cha; rỗng nghĩa là bình luận gốc.
  parentId String?
  parent   ClubComment?  @relation("ClubCommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ClubComment[] @relation("ClubCommentTree")

  /**
   * Bình luận gốc của cả nhánh (rỗng ở chính bình luận gốc).
   * Có cột này thì lấy cả nhánh chỉ mất MỘT truy vấn: `rootId in (…)`. Không có
   * thì phải lần theo `parentId` từng tầng một, mỗi tầng một lượt hỏi cơ sở dữ
   * liệu — mà bảng tin có mười lăm bài mỗi trang.
   */
  rootId String?

  /// 0 là bình luận gốc. Có sẵn ở đây thì khỏi phải đếm ngược lên cây để thụt lề.
  depth Int @default(0)

  createdAt DateTime @default(now())

  likes ClubCommentLike[]

  @@index([postId, depth, createdAt])
  @@index([rootId, createdAt])
}

model ClubCommentLike {
  id        String      @id @default(cuid())
  commentId String
  comment   ClubComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

// ============================================================
// KHU GIẢI TRÍ — dựng lại từ bộ mod JohnCMS Việt hoá 2008-2011
// ============================================================

/**
 * Một lượt chơi ở khu giải trí.
 * Ghi lại TỪNG lượt chứ không chỉ cộng trừ điểm, vì ba lẽ:
 * • trần lượt mỗi ngày phải đếm được — không có trần thì mấy trò cược biến
 * thành chỗ ngồi bấm cả đêm,
 * • có gì bất thường (ai đó thắng liên tục) thì còn lần ra được,
 * • và để in bảng "lượt chơi gần đây" cho vui, đúng kiểu wap ngày trước.
 * Điểm vẫn đi qua `grantPoints` như mọi nơi khác; bảng này chỉ là sổ chơi.
 */


/**
 * Một phiên bầu cua chung cho cả nhà.
 * Bản cũ mỗi người xóc riêng một bát. Ở đây có MỘT bàn: ai cũng đặt lên cùng
 * sáu ô, hết giờ thì hệ thống xóc một lần cho tất cả — đúng kiểu ngồi quanh
 * chiếu ngày Tết, và nhìn người khác đặt cửa mới là phần vui nhất.
 * Phiên không do một tiến trình chạy nền sinh ra mà TÍNH THEO ĐỒNG HỒ: mã
 * phiên chính là mốc giây bắt đầu, nên máy chủ nào hỏi cũng ra cùng một phiên,
 * và không có gì để hỏng khi máy chủ khởi động lại. Ai ghé vào sau giờ xóc thì
 * chính người ấy chốt sổ phiên cũ — chốt bằng ghi có điều kiện nên dù mười
 * người cùng ghé cũng chỉ xóc đúng một lần.
 */

/**
 * Một cửa đặt của một người trong một phiên.
 * Điểm TRỪ ngay lúc đặt (không ai đặt được cửa mà chưa trả tiền) và TRẢ lúc
 * chốt sổ. `payout` rỗng nghĩa là phiên chưa chốt.
 */

// ============================================================
// TRẮC NGHIỆM — thành viên tự ra câu hỏi, đặt cọc bằng điểm
// ============================================================

/**
 * Một câu hỏi trắc nghiệm do thành viên đăng.
 * Luật kinh tế giữ đúng bản JohnCMS cũ, vì nó hay: người ra câu hỏi ĐẶT CỌC
 * `price` điểm. Ai trả lời ĐÚNG thì lấy cọc ấy; ai trả lời SAI thì mất đúng
 * bấy nhiêu cho người ra câu. Nghĩa là ra câu quá dễ thì lỗ, ra câu đánh đố vô
 * lý thì chẳng ai thèm trả lời — tự nó ép người ta ra câu tử tế.
 * Câu hỏi phải qua duyệt mới hiện: cọc đã trừ ngay lúc đăng, nên câu rác không
 * lọt ra mà người đăng vẫn mất tiền đặt cọc.
 */
model QuizQuestion {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Thể loại — bản gốc xếp câu hỏi theo thể loại, và đó là thứ khiến trang
  /// chủ trắc nghiệm có hình hài chứ không phải một đống câu hỏi trộn lẫn.
  categoryId String?
  category   QuizCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  content String   @db.Text
  /// Bốn phương án, theo đúng thứ tự hiện ra.
  options String[]
  /// Chỉ số phương án đúng, 0..3.
  correct Int
  /// Lời giải thích, hiện sau khi người ta trả lời xong.
  explain String?  @db.Text

  /// Số điểm đặt cọc, cũng là số điểm ăn thua mỗi lượt trả lời.
  price Int

  status QuizStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("QuizReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Lý do từ chối, để người đăng biết đường sửa.
  reviewNote   String?

  answers  QuizAnswer[]
  comments QuizComment[]

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([categoryId, status, createdAt])
}

/**
 * Thể loại câu hỏi, quản trị lập.
 */
model QuizCategory {
  id   String  @id @default(cuid())
  slug String  @unique
  name String
  /// Một dòng mô tả ngắn hiện dưới tên thể loại.
  note String?

  order Int @default(0)

  questions QuizQuestion[]

  createdAt DateTime @default(now())

  @@index([order])
}

/**
 * Bình luận dưới một câu hỏi.
 * Bản gốc có mục này và nó đúng là chỗ vui nhất: trả lời xong người ta hay
 * xuống cãi nhau về đáp án. Điều hành viên ẩn được bình luận bậy chứ không xoá
 * hẳn, giống mọi chỗ khác trong diễn đàn.
 */
model QuizComment {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation("QuizCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  content String  @db.Text
  hidden  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([questionId, hidden, createdAt])
}

enum QuizStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Một lượt trả lời. Mỗi người chỉ trả lời mỗi câu MỘT lần — có ràng buộc duy
 * nhất canh, chứ kiểm bằng truy vấn rồi mới ghi thì hai tab mở cùng lúc là
 * lách được.
 */
model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  chosen  Int
  correct Boolean

  createdAt DateTime @default(now())

  @@unique([questionId, userId])
  @@index([userId, createdAt])
}

// ============================================================
// NÔNG TRẠI — viết mới, dùng lại bộ ảnh của bản mod cũ
// ============================================================

/**
 * Một loại cây trồng. Quản trị cấu hình được, không viết cứng trong mã.
 * Bản cũ có 11 loại và bộ ảnh đi kèm (`nongtrai/o-dat/{n}.png` lúc còn non,
 * `{n}-chin.png` lúc chín), nên giữ nguyên chừng ấy loại để dùng lại tranh.
 */
model FarmCrop {
  id   String @id @default(cuid())
  /// Số thứ tự trong bộ ảnh cũ, cũng là tên tệp: 1..11.
  key  Int    @unique
  name String

  /// Giá một hạt giống, tính bằng điểm.
  seedCost    Int
  /// Bao lâu thì chín, tính bằng phút.
  growMinutes Int
  /// Thu được bao nhiêu nông sản mỗi vụ (chăm kém → chăm tốt).
  yieldMin    Int
  yieldMax    Int
  /// Giá bán một nông sản.
  sellPrice   Int

  order  Int     @default(0)
  active Boolean @default(true)

  /// Gieo được không. Quả khế là nông sản thật — vào kho, giao đơn được —
  /// nhưng nó rụng từ cây khế ngoài vườn chứ không có hạt để gieo, nên phải
  /// giấu khỏi cửa hàng mà vẫn để đơn hàng gọi tên.
  plantable Boolean @default(true)

  plots      FarmPlot[]
  barn       FarmBarn[]
  seeds      FarmSeed[]
  orderItems FarmOrderItem[]

  @@index([active, order])
}

/**
 * Một ô đất của một người.
 * Không lưu "còn bao lâu nữa chín" mà lưu THỜI ĐIỂM chín (`readyAt`): đếm
 * ngược thì phải có ai đó chạy nền trừ dần, còn mốc thời gian thì lúc nào hỏi
 * cũng tính ra được, và tưới nước hay bón phân chỉ là kéo cái mốc ấy gần lại.
 */
model FarmPlot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ô số mấy trên mảnh đất, đếm từ 0.
  index Int

  cropId String?
  crop   FarmCrop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  /// Đã xới chưa. Xới xong mới gieo được, và thu hoạch xong thì đất lại
  /// chai — mỗi vụ phải xới lại từ đầu.
  tilled Boolean @default(false)

  plantedAt DateTime?
  readyAt   DateTime?
  /// Đã tưới chưa — mỗi vụ tưới được một lần, tưới thì được mùa hơn.
  watered   Boolean   @default(false)
  /// Đã bón loại phân nào; `null` là chưa bón. Giữ LOẠI chứ không phải một
  /// cờ đúng/sai, vì mỗi loại bồi thêm một mức khác nhau và lúc thu hoạch mới
  /// cần tới con số ấy.
  fertKind  Int?

  @@unique([userId, index])
  @@index([userId])
}

/**
 * Nhà kho: nông sản thu được, chờ đem bán.
 */
model FarmBarn {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId String
  crop   FarmCrop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  qty Int @default(0)

  @@unique([userId, cropId])
  @@index([userId])
}

/// Túi hạt giống đã mua mà chưa gieo.
///
/// Tách khỏi `FarmBarn` (kho nông sản) dù hai bảng trông y hệt nhau: hạt chưa
/// gieo và quả đã thu là hai thứ khác nhau hoàn toàn — một thứ đem trồng, một
/// thứ đem bán — mà gộp một bảng thì phải thêm một cột phân loại, rồi mọi câu
/// truy vấn đều phải nhớ lọc theo cột ấy. Quên một chỗ là bán mất hạt giống.
model FarmSeed {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId String
  crop   FarmCrop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  qty Int @default(0)

  @@unique([userId, cropId])
  @@index([userId])
}

/// Phân bón trong kho, một hàng mỗi LOẠI.
///
/// Năm loại, mỗi loại một giá và một mức bồi. `kind` là số 1..5 và cũng là
/// tên tệp ảnh (`phan-bon/{kind}.png`) — cùng quy ước với `FarmCrop.key`, nên
/// đổi số là đổi luôn bao phân người ta nhìn thấy.
model FarmFert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind Int
  qty  Int @default(0)

  @@unique([userId, kind])
  @@index([userId])
}

/// Kiểu đơn hàng trên bảng ghi chú.
enum FarmOrderKind {
  /// Đơn thường, trả đúng phần thưởng cơ bản.
  THUONG
  /// Đơn đặc biệt, gấp đôi.
  DAC_BIET
  /// Đơn siêu tốc, gấp ba nhưng có hạn giao.
  SIEU_TOC
}

/// Một đơn hàng do khách đặt trên bảng ghi chú của nông trại.
///
/// Đơn thuộc về TỪNG NGƯỜI chứ không phải bảng chung: bảng chung thì ai vào
/// trước nhận hết, người vào sau mở ra thấy bảng trống mà chẳng hiểu vì sao.
model FarmOrder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tên khách đặt hàng, chọn sẵn từ một danh sách.
  khach String
  kind  FarmOrderKind @default(THUONG)

  /// Điểm trả cho đơn này, ĐÃ nhân hệ số. Chốt lúc tạo đơn chứ không tính
  /// lại lúc giao: giá bán nông sản có thể đổi, mà đơn đã treo lên bảng thì
  /// phải trả đúng số đã hứa.
  reward Int

  items FarmOrderItem[]

  /// Hạn giao của đơn siêu tốc; `null` là không có hạn.
  expiresAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, deliveredAt])
}

model FarmOrderItem {
  id      String    @id @default(cuid())
  orderId String
  order   FarmOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cropId  String
  crop    FarmCrop  @relation(fields: [cropId], references: [id], onDelete: Cascade)
  qty     Int

  @@unique([orderId, cropId])
  @@index([orderId])
}

// ============================================================
// ĐẢO RỒNG — ấp trứng, nuôi lớn, đấu trường
// ============================================================

model Rong {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Loài (1–9) và màu (1–6) — tra thẳng vào `public/hoai-niem/rong/<loài>/<màu>.gif`.
   * Sáu tấm trong mỗi thư mục là SÁU BIẾN THỂ MÀU của cùng một loài, không phải
   * sáu bước tiến hoá; nên hai số này cùng nhau mới ra một con, và bộ sưu tập
   * đủ là 9 × 6 = 54 con.
   */
  loai Int
  mau  Int

  ten String?

  cap Int @default(1)
  exp Int @default(0)

  /**
   * Đời: rồng mua bằng trứng thường là đời 1, lai ra thì cộng 1, chặn ở đời 5.
   *
   * Có tác dụng thật chứ không phải con số trang trí — mỗi đời cộng thẳng một
   * điểm vào cả ba chỉ số (xem `chiSo` trong `rong-const.ts`). Cộng nhỏ và có
   * trần, chứ nhân lên thì đời sau đè hết đời trước và đấu trường thành cuộc
   * đua ai lai lâu hơn.
   */
  doi Int @default(1)

  /// Đã lai mấy lần; mỗi con chỉ lai được vài lần rồi thôi.
  soLanLai Int @default(0)

  /// Lần lai gần nhất — lai xong phải nghỉ, xem `LAI_CHO_MS`.
  laiLanCuoi DateTime?

  /**
   * Cha mẹ, chỉ để kể phả hệ.
   *
   * KHÔNG khai quan hệ Prisma: quan hệ kéo theo ràng buộc khoá ngoại, mà cha
   * mẹ thì thả về trời lúc nào cũng được — hoặc là con cũng bị cascade xoá
   * theo (mất trắng), hoặc là không thả được cha mẹ nữa. Hai chuỗi id trần,
   * trỏ hụt thì thôi không kể phả hệ, là đúng thứ cần ở đây.
   */
  chaId String?
  meId  String?

  /**
   * Ba trục chăm sóc, mỗi trục một cặp "giá trị + mốc tính".
   *
   * Không có trục nào được ghi giảm dần bằng tác vụ nền — đảo này không có
   * cron, mà có cũng không nên. Cột giữ giá trị TẠI MỐC, còn phần trôi đi thì
   * tính lúc đọc (`vuiHienGio`, `noHienGio`, `theLucHienGio`). Ghi lại chỉ khi
   * người chơi thật sự làm gì đó với con rồng.
   *
   * Mỗi trục một mốc riêng chứ không chung một mốc: ba trục đổi vào ba lúc
   * khác nhau (ăn thì no, chơi thì vui và tụt lực), dùng chung một mốc là mỗi
   * lần đụng vào một trục lại phải tính lại cả hai trục kia cho đúng — sai một
   * chỗ là hụt hoặc lãi vô hình.
   *
   * `vui`    tụt theo giờ, tăng khi chơi. Vui thấp thì đánh yếu.
   * `doNo`   tụt theo giờ, tăng khi ăn. Đói thì cũng đánh yếu.
   * `theLuc` HỒI theo giờ, tiêu khi chơi và khi vào hang. Đây là thứ chặn số
   *          lượt chơi mỗi ngày, thay cho mấy cái hẹn giờ vô hình trước đây.
   */
  vui       Int      @default(60)
  vuiTinhAt DateTime @default(now())

  doNo      Int      @default(70)
  noTinhAt  DateTime @default(now())

  theLuc    Int      @default(100)
  lucTinhAt DateTime @default(now())

  /**
   * Còn là trứng khi `noAt` là null. Trứng nở được kể từ `apXongAt` — mốc ấy
   * ghi sẵn lúc mua, chứ không tính lại từ đồng hồ mỗi lần mở trang: hai nguồn
   * sự thật thì có lúc lệch nhau.
   */
  apXongAt DateTime
  noAt     DateTime?

  anLanCuoi   DateTime?
  choiLanCuoi DateTime?

  /**
   * Con đang cử ra đấu trường. Mỗi người chỉ một con.
   */
  raTran Boolean @default(false)

  createdAt DateTime @default(now())

  tranA RongTran[] @relation("RongA")
  tranB RongTran[] @relation("RongB")

  @@index([userId, createdAt])
  @@index([userId, raTran])
  @@index([loai, mau])
}

/**
 * Một trận ở đấu trường — giữ để kể lại diễn biến.
 * KHÔNG đếm trần "mỗi ngày mấy trận" trên bảng này: hai khoá ngoại đều
 * `onDelete: Cascade`, mà người chơi thả rồng lúc nào cũng được, nên xoá một
 * con rồng là xoá luôn lịch sử trận của nó và bộ đếm ngày tự về 0. Tệ hơn, thả
 * rồng của MÌNH còn quét cả những trận người khác đã đánh với nó. Trần ngày
 * đếm trên `RongLuotDau` — bảng người chơi không xoá được.
 */
/// Hồ sơ của một người chơi ở Đảo Rồng.
///
/// Trước nay đảo chỉ có bảng cho CON RỒNG, không có bảng nào cho NGƯỜI NUÔI —
/// nên số mốc sưu tầm đã lĩnh chẳng biết cất vào đâu. Nhét lên `User` thì lẫn
/// với diễn đàn, mà đếm lại lúc đọc thì bảng xếp hạng không sắp theo được:
/// `ORDER BY` cần một cột thật chứ không nhận một phép đếm `distinct`.
///
/// Hàng tự sinh lúc người chơi mở trang sổ sưu tầm lần đầu, nên người đã nuôi
/// rồng từ trước không cần bộ nạp lại nào.
/// Một món đồ trong túi của người chơi Đảo Rồng.
///
/// `ma` trỏ vào mảng hằng `RONG_DO` chứ không thành một bảng: danh sách món là
/// LUẬT CHƠI — giá và tác dụng đọc ở máy chủ, không cho quản trị sửa và trình
/// duyệt cũng không gửi lên được. Bảng này chỉ giữ "ai đang có mấy cái".
///
/// `@@unique([chuId, ma])` để `upsert` + `increment` chạy an toàn mà không cần
/// khoá hàng người dùng.
/// Một lượt ghi danh đấu trường rồng — sổ đếm trần trận mỗi ngày.
///
/// Trước đây đếm nhờ bảng chung `MiniGamePlay` của khu giải trí. Khu ấy dẹp
/// mấy trò cầu may nên bảng chung đi theo, còn phép đếm thì vẫn phải nằm ở
/// một bảng NGƯỜI CHƠI KHÔNG XOÁ ĐƯỢC.
///
/// Vì sao không đếm thẳng trên `RongTran`: bảng ấy cascade theo cả hai con
/// rồng, mà thả rồng thì lúc nào cũng thả được — đấu đủ số trận, thả con vừa
/// đấu, bộ đếm về 0, đấu tiếp; mỗi trận thắng lãi ròng 25 điểm nên vòng lặp
/// ấy có lãi. Tệ hơn là đường vòng qua người khác: B thả con rồng mà A vừa
/// đánh mười trận là bộ đếm của A về 0 dù A không đụng gì vào rồng của mình.
model RongLuotDau {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Điểm diễn đàn ròng của lượt ấy (thưởng trừ phí ghi danh), giữ để soát sổ.
  doi Int @default(0)

  /// 'thang' | 'hoa' | 'thua' — chép lại kết quả cho khỏi phải join `RongTran`,
  /// vốn là bảng có thể biến mất khi người ta thả rồng.
  ketQua String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RongDo {
  id    String @id @default(cuid())
  chuId String
  chu   User   @relation(fields: [chuId], references: [id], onDelete: Cascade)

  ma      String
  soLuong Int    @default(0)

  @@unique([chuId, ma])
  @@index([chuId])
}

model RongNguoiChoi {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Số cặp loài+màu đã TỪNG nở, kể cả con đã thả về trời.
  ///
  /// Ghi trong cùng transaction với lúc nở trứng, và tự sửa lại nếu lệch khi
  /// mở trang sổ — con số này chỉ để xếp hạng, còn cái sổ vẫn đọc thẳng từ
  /// bảng `Rong` nên không bao giờ bày sai.
  daSuuTam Int @default(0)

  /**
   * Điểm đấu trường kiểu Elo, khởi đầu 1000, sàn 100.
   *
   * Bản gốc không có xếp hạng nào cho đấu trường rồng: đánh bao nhiêu trận
   * cũng chỉ có tiền thưởng từng trận, nên bảng không có mà lý do đánh thêm
   * cũng không. Elo thì thắng người mạnh hơn được nhiều điểm hơn, nên đánh
   * kèo dễ không lên hạng được.
   */
  diemDau Int @default(1000)

  /// Mùa đang tính: năm×100+tháng theo giờ Việt Nam. 0 = chưa vào mùa nào.
  muaDau Int @default(0)

  thangDau Int @default(0)
  thuaDau  Int @default(0)
  hoaDau   Int @default(0)

  /// Số mốc sưu tầm đã lĩnh thưởng, tính theo THỨ TỰ trong `MOC_SUU_TAM`.
  ///
  /// Lưu số thứ tự chứ không lưu danh sách mốc: thêm mốc mới vào cuối bảng
  /// hằng số là người chơi cũ tự khắc lĩnh được mốc ấy, không phải vá dữ liệu.
  mocDaNhan Int @default(0)

  createdAt DateTime @default(now())

  @@index([daSuuTam])
  @@index([diemDau])
  @@index([thangDau])
}

model RongTran {
  id String @id @default(cuid())

  aId String
  a   Rong   @relation("RongA", fields: [aId], references: [id], onDelete: Cascade)
  bId String
  b   Rong   @relation("RongB", fields: [bId], references: [id], onDelete: Cascade)

  /**
   * id con thắng; null nghĩa là hoà.
   */
  thangId String?

  /**
   * Điểm bên thách đấu được (âm nếu thua).
   */
  duoc Int

  /**
   * Diễn biến từng hiệp, để kể lại trận đấu.
   */
  dienBien Json

  /// Điểm Elo bên thách đấu được (âm nếu thua). Bên bị thách đổi ngược lại.
  diemDoi Int @default(0)

  /// Mùa lúc đánh trận này — năm×100+tháng.
  mua Int @default(0)

  createdAt DateTime @default(now())

  @@index([aId, createdAt])
  @@index([bId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────── Đảo Pokémon ───────────────────────────
//
// Dựng lại từ mã nguồn một wap game Pokémon Việt hoá chạy trên JohnCMS quãng
// 2013. Bản gốc nhồi hết vào hai bảng `chars` và `poke` với hơn bốn mươi cột
// đánh số (`cuonghoa2`…`cuonghoa8`); ở đây tách theo đúng thứ mỗi bảng nói về.
//
// Thú hoang KHÔNG có bảng riêng cho từng khu như bản gốc (`pokemon2`,
// `pokemon3`, `nuoc3`… mười bốn bảng giống hệt nhau): bảng thú của cả mười bốn
// khu nằm trong `prisma/du-lieu/pokemon.json` và nạp vào `PokeThuHoang`.

model PokeNhanVat {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tên trong game, khác tên tài khoản diễn đàn.
  ten String @unique

  vang Int @default(200)
  exp  Int @default(20)
  cap  Int @default(1)

  /// Thể lực: mỗi trận tốn 2, hết thì phải vào trạm y tế.
  sk      Int @default(20)
  skToiDa Int @default(20)

  /// Quả cầu để bắt thú, và đá tiến cấp.
  cau Int @default(5)
  da  Int @default(0)

  /// Ngọc — thưởng riêng của Gym, bản gốc gọi là `tree`.
  ngoc Int @default(0)

  /// Huy chương cao nhất đang giữ; cũng là số Gym đã hạ vì Gym đánh theo thứ tự.
  huyChuong Int @default(0)

  /// Số trận thắng ở đấu trường.
  thangDau Int @default(0)

  /// Số nhiệm vụ đã nhận thưởng.
  nhiemVu Int @default(0)

  /// Điểm chiến công kiếm ở Lãnh Thổ, dùng đổi quà — bản gốc gọi là `point`.
  diemChien Int @default(0)

  /// Tổng số thú đã hạ ở Lãnh Thổ — bản gốc gọi là `rank`, dùng cho bảng
  /// "số quái đã giết".
  soDiet Int @default(0)

  /// Điểm danh hằng ngày: ngày nhận gần nhất và chuỗi ngày liên tiếp.
  /// `diemDanhNgay` lưu theo NGÀY (đầu ngày giờ Việt Nam) chứ không theo thời
  /// điểm, để "một ngày một lần" là một ngày lịch chứ không phải 24 giờ trôi.
  diemDanhNgay   DateTime?
  diemDanhChuoi  Int       @default(0)

  /// Điểm xếp hạng đấu trường và mùa giải đang tính.
  ///
  /// Bản gốc không có xếp hạng nào cho đấu trường: thắng bao nhiêu trận cũng
  /// chỉ có cột `thangDau` cộng dồn vĩnh viễn, nên người vào sau không bao giờ
  /// đuổi kịp và bảng xếp hạng đứng yên.
  ///
  /// `muaDau` là số hiệu mùa (năm × 100 + tháng, lịch giờ Việt Nam). Sang mùa
  /// mới thì lượt đọc đầu tiên chốt mùa cũ — chốt LƯỜI, không tiến trình nền.
  diemDau Int @default(1000)
  muaDau  Int @default(0)

  /// Mốc thưởng Đồ Giám đã nhận. Cùng lối cột `nhiemVu`: chỉ ghi ĐÃ NHẬN TỚI
  /// ĐÂU, còn tiến độ thì đọc thẳng từ bảng `PokeDoGiam` nên không lệch được.
  mocDoGiam Int @default(0)

  /// Hai bộ đếm cho nhiệm vụ hằng ngày.
  ///
  /// `soDiet` sẵn có chỉ đếm riêng Lãnh Thổ, còn số dòng `PokeThu` thì thả thú
  /// ra là mất dấu — cả hai đều không dùng làm mốc ngày được.
  soHaGuc Int @default(0)
  soBat   Int @default(0)

  nhiemVuNgay PokeNhiemVuNgay[]

  doGiam PokeDoGiam[]

  bangId String?
  bang   PokeBang? @relation("BangThanhVien", fields: [bangId], references: [id], onDelete: SetNull)

  /// Khu đang đứng.
  khu String @default("co")

  /// Con đang ra trận.
  raTranId String?  @unique
  raTran   PokeThu? @relation("PokeRaTran", fields: [raTranId], references: [id], onDelete: SetNull)

  /// Lần vào trạm y tế gần nhất — bản gốc dùng chung một lần chờ cho cả máu
  /// lẫn thể lực, giữ nguyên vậy.
  chuaLuc DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thu        PokeThu[]       @relation("PokeChu")
  tran       PokeTran?
  dauChu     PokeDau[]       @relation("DauChu")
  dauDoi     PokeDau[]       @relation("DauDoi")
  huyenTinh  PokeHuyenTinh[]
  do         PokeDo[]
  rao        PokeRao[]
  bangTruong PokeBang?       @relation("BangTruong")

  @@index([cap, exp])
  @@index([soDiet])
  @@index([thangDau])
}

model PokeThu {
  id        String      @id @default(cuid())
  nhanVatId String
  nhanVat   PokeNhanVat @relation("PokeChu", fields: [nhanVatId], references: [id], onDelete: Cascade)

  /// Số hiệu ảnh gốc; ảnh nấc sau nằm ở số hiệu + 500.
  nguon Int
  ten   String
  he    Int

  /// Nấc tiến hoá hiện tại và tối đa (bản gốc: `lv` và `mlv`).
  nac      Int @default(1)
  nacToiDa Int @default(1)

  cap Int @default(1)
  exp Int @default(0)

  /// Cấp cường hoá, 0 tới 6 — bản gốc gọi là `lvcuonghoa`.
  capCuong Int @default(0)

  mau      Int
  mauToiDa Int

  /// Sát thương bốn chiêu; trung bình bốn số này cũng là bộ thủ.
  c1 Int @default(10)
  c2 Int @default(10)
  c3 Int @default(10)
  c4 Int @default(10)

  chieu String[]

  createdAt DateTime @default(now())

  raTranCua PokeNhanVat? @relation("PokeRaTran")
  rao       PokeRao?

  @@index([nhanVatId, createdAt])
}

/// Bảng thú hoang của từng khu, nạp từ `prisma/du-lieu/pokemon.json`.
/**
 * Đồ Giám — sổ ghi từng loài đã GẶP và đã BẮT.
 *
 * Bản gốc không có mục này, mà đảo có tới 468 loài: không có sổ thì người chơi
 * chẳng bao giờ biết mình còn thiếu con nào, và cả bộ ảnh coi như chỉ để lướt
 * qua trong lúc đánh nhau.
 *
 * Ghi theo `nguon` (mã ảnh) chứ không theo bản ghi thú hoang: cùng một loài
 * xuất hiện ở nhiều khu, mà gặp ở khu nào cũng là gặp loài ấy.
 */
model PokeDoGiam {
  id        String      @id @default(cuid())
  nhanVatId String
  nhanVat   PokeNhanVat @relation(fields: [nhanVatId], references: [id], onDelete: Cascade)

  nguon Int
  ten   String
  he    Int

  /// Đã bắt được ít nhất một con. Gặp thì luôn đúng, nên không có cột riêng.
  daBat Boolean @default(false)

  lanDau DateTime @default(now())

  @@unique([nhanVatId, nguon])
  @@index([nhanVatId])
}

model PokeThuHoang {
  id  String @id @default(cuid())
  khu String
  /// Số hiệu trong bảng gốc, để đối chiếu về sau.
  goc Int

  nguon Int
  ten   String
  he    Int
  nac   Int    @default(1)

  cong Int
  thu  Int
  mau  Int
  exp  Int
  vang Int

  chieu String[]

  @@unique([khu, goc])
  @@index([khu])
}

/// Trận đang đánh dở. Một nhân vật chỉ có đúng một trận.
model PokeTran {
  id        String      @id @default(cuid())
  nhanVatId String      @unique
  nhanVat   PokeNhanVat @relation(fields: [nhanVatId], references: [id], onDelete: Cascade)

  khu String

  /// Số hiệu Gym nếu đây là trận Gym; rỗng nghĩa là thú hoang. Trận Gym không
  /// ném cầu được, và thắng thì có thưởng riêng.
  gym Int?

  /// Bản sao chỉ số con thú hoang lúc vào trận — chép ra chứ không trỏ tới
  /// bảng gốc, vì máu của nó tụt dần trong trận. Bản gốc trừ thẳng vào bảng
  /// chung nên hai người đánh cùng lúc là trừ máu của nhau.
  nguon    Int
  ten      String
  he       Int
  nac      Int      @default(1)
  cong     Int
  thu      Int
  mau      Int
  mauToiDa Int
  exp      Int
  vang     Int
  chieu    String[]

  /// Câu kể lượt vừa rồi.
  ke String?

  /// Kết quả BỐC của lượt vừa rồi, ghi lại chứ không chỉ kể ra chữ.
  ///
  /// Chí mạng và trượt là hai thứ ngẫu nhiên duy nhất trong một lượt đánh, mà
  /// bài kiểm thì phải khẳng định được máu trừ đúng công thức. Ghi ra cột thì
  /// bài kiểm ĐỌC được lượt vừa rồi đã bốc ra gì rồi mới so máu — không phải
  /// tắt ngẫu nhiên đi mới kiểm được, cũng không phải đoán.
  lanChiMang Boolean @default(false)
  lanTruot   Boolean @default(false)

  /// Trạng thái đang dính của hai bên và số lượt còn lại.
  ///
  /// Để trong trận chứ không để trên `PokeThu`: hết trận là hết, không có gì
  /// phải dọn và không có đường nào để một con mang trạng thái đi ra ngoài.
  trangThai    String?
  tramLuot     Int     @default(0)
  toiTrangThai String?
  toiTramLuot  Int     @default(0)

  createdAt DateTime @default(now())
}

/// Nhiệm vụ hằng ngày: mỗi người mỗi ngày mỗi việc một dòng.
///
/// Chuỗi nhiệm vụ nhập môn chỉ có bốn bước, nhận hết là hết — sau đó mục
/// Nhiệm vụ vĩnh viễn không còn gì để làm. Ba việc hằng ngày ở đây làm lại
/// mỗi ngày.
///
/// Tiến độ KHÔNG có cột đếm riêng: `mocDau` chép lại bộ đếm tổng lúc dòng này
/// sinh ra, tiến độ là hiệu số với bộ đếm hiện tại. Nhờ vậy không có đường nào
/// để tiến độ lệch khỏi sự thật, đúng lối `tienDoNhiemVu` đang dùng.
model PokeNhiemVuNgay {
  id        String      @id @default(cuid())
  nhanVatId String
  nhanVat   PokeNhanVat @relation(fields: [nhanVatId], references: [id], onDelete: Cascade)

  /// Đầu ngày theo lịch giờ Việt Nam, dùng chung mốc với điểm danh.
  ngay DateTime
  ma   String

  mocDau Int     @default(0)
  daNhan Boolean @default(false)

  createdAt DateTime @default(now())

  /// Chống nhận hai lần bằng chính ràng buộc của cơ sở dữ liệu.
  @@unique([nhanVatId, ngay, ma])
  @@index([nhanVatId, ngay])
}

/// Mười bốn Gym, nạp từ `prisma/du-lieu/pokemon.json`.
model PokeGym {
  so  Int    @id
  ten String
  he  Int

  cong Int
  thu  Int
  mau  Int

  /// Thưởng khi hạ được.
  exp  Int
  vang Int
  cau  Int
  ngoc Int

  chieu String[]

  /// Con thú tặng kèm — bản gốc lấy số hiệu ảnh là `số Gym + 1500`.
  tangNguon Int
  tangNac   Int @default(1)
}

/// Một kèo ở đấu trường: người tạo mở kèo, người khác nhảy vào, rồi đánh
/// luân phiên từng lượt cho tới khi một bên hết máu hoặc hết giờ.
model PokeDau {
  id String @id @default(cuid())

  chuId String
  chu   PokeNhanVat @relation("DauChu", fields: [chuId], references: [id], onDelete: Cascade)

  /// Khoảng cấp nhận đối thủ, do người mở kèo đặt.
  capMin Int
  capMax Int

  doiId String?
  doi   PokeNhanVat? @relation("DauDoi", fields: [doiId], references: [id], onDelete: Cascade)

  /// Bản sao lúc vào trận: tên, ảnh, bốn chiêu và máu của con ra trận mỗi bên.
  /// Chép ra để trận không đổi giữa chừng khi ai đó đổi con ở kho.
  chuTen      String
  chuNguon    Int
  chuNac      Int      @default(1)
  chuHe       Int      @default(1)
  chuChieu    Int[]
  chuTenChieu String[]
  chuMau      Int
  chuMauToiDa Int

  doiTen      String?
  doiNguon    Int?
  doiNac      Int?
  doiHe       Int?
  doiChieu    Int[]
  doiTenChieu String[]
  doiMau      Int?
  doiMauToiDa Int?

  /// Con ra trận của mỗi bên, để trừ máu thật khi thua.
  chuThuId String?
  doiThuId String?

  /// Đến lượt ai: 'chu' hoặc 'doi'. Rỗng khi chưa có đối thủ.
  luotCua String?

  /// Hạn của lượt hiện tại (hoặc hạn sống của kèo khi chưa ai vào). Quá hạn
  /// thì bên đến lượt xử thua — chốt lười, không cần tiến trình nền.
  hanLuc DateTime

  /// Câu kể lượt vừa rồi.
  ke String?

  /// Ai thắng, và kết thúc lúc nào. Rỗng nghĩa là còn đánh.
  thangId String?
  ketThuc DateTime?

  createdAt DateTime @default(now())

  @@index([thangId, hanLuc])
  @@index([chuId])
  @@index([doiId])
}

/// Huyền tinh để cường hoá — sáu cấp, mỗi cấp một dòng.
model PokeHuyenTinh {
  id        String      @id @default(cuid())
  nhanVatId String
  nhanVat   PokeNhanVat @relation(fields: [nhanVatId], references: [id], onDelete: Cascade)

  cap Int
  sl  Int @default(0)

  @@unique([nhanVatId, cap])
}

/// Một con thú đang rao bán ở chợ. Giá tính bằng NGỌC, y bản gốc.
model PokeRao {
  id        String      @id @default(cuid())
  nhanVatId String
  nhanVat   PokeNhanVat @relation(fields: [nhanVatId], references: [id], onDelete: Cascade)

  /// Mỗi con chỉ được rao một lần.
  thuId String  @unique
  thu   PokeThu @relation(fields: [thuId], references: [id], onDelete: Cascade)

  gia Int

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Bang hội.
model PokeBang {
  id  String @id @default(cuid())
  ten String @unique

  truongId String      @unique
  truong   PokeNhanVat @relation("BangTruong", fields: [truongId], references: [id], onDelete: Cascade)

  /// Quỹ chung.
  vang Int @default(0)
  ngoc Int @default(0)

  /// Chỉ số bang cộng cho mọi thành viên khi ra trận.
  cong Int @default(10)
  thu  Int @default(10)

  sucChua Int @default(5)

  /// Trưởng bang khoá quỹ thì chỉ mình trưởng rút được — bản gốc gọi là `zapret`.
  khoaQuy Boolean @default(true)

  createdAt DateTime @default(now())

  thanhVien PokeNhanVat[] @relation("BangThanhVien")
}

/// Bảng hàng trang bị và thuốc, nạp từ `prisma/du-lieu/pokemon.json`.
model PokeHang {
  ma   Int    @id
  ten  String
  /// weapon | shield | golova | body | elixir
  loai String

  cong Int @default(0)
  thu  Int @default(0)
  mu   Int @default(0)
  giap Int @default(0)
  /// Riêng thuốc: số máu hồi được.
  mau  Int @default(0)

  /// Cấp nhân vật tối thiểu để mua.
  cap  Int @default(1)
  vang Int @default(0)
  ngoc Int @default(0)

  @@index([loai, cap])
}

/// Một món trong túi. Trang bị mỗi món một dòng; thuốc gộp theo `sl`.
model PokeDo {
  id        String      @id @default(cuid())
  nhanVatId String
  nhanVat   PokeNhanVat @relation(fields: [nhanVatId], references: [id], onDelete: Cascade)

  ma   Int
  ten  String
  loai String

  cong Int @default(0)
  thu  Int @default(0)
  mu   Int @default(0)
  giap Int @default(0)
  mau  Int @default(0)

  /// Trang bị: đang mặc hay để trong túi. Mỗi ô chỉ mặc được một món.
  dangMac Boolean @default(false)
  /// Thuốc thì gộp số lượng; trang bị luôn là 1.
  sl      Int     @default(1)

  createdAt DateTime @default(now())

  @@index([nhanVatId, loai, dangMac])
}
