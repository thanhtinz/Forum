# Nova Platform — biến môi trường
DATABASE_URL="postgresql://user:pass@localhost:5432/nova?schema=public"

# Auth.js v5
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# OAuth (điền khi dùng)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# SePay (điền khi dùng)
SEPAY_API_KEY=""
SEPAY_ACCOUNT_NUMBER=""
SEPAY_BANK_CODE=""

# Trợ lý AI ở trang quản trị game (tra cứu game, soạn mô tả, gợi ý ảnh).
# Không điền thì trang vẫn chạy, chỉ là nút AI báo "chưa bật".
ANTHROPIC_API_KEY=""
AI_MODEL=""            # bỏ trống = claude-sonnet-5
AI_SEARCH_TOOL=""      # bỏ trống = web_search_20250305

# Tuỳ chọn
REDIS_URL=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# URL công khai của trang (dùng cho SEO: sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL="https://nova.example.com"

# Game Hub / Emulator
NEXT_PUBLIC_GAME_CDN_URL=""     # gốc CDN phục vụ file game & ảnh (rỗng = phục vụ qua app)
GAME_SIGN_SECRET=""             # khoá ký signed URL (mặc định dùng AUTH_SECRET)
GAME_STORAGE_DIR="./storage/games"
GAME_SAVE_DIR="./storage/saves"
EMU_CLUSTER_MAX="200"           # số phiên emulator đồng thời toàn cụm
EMU_USER_MAX="2"                # số phiên đồng thời mỗi người dùng
EMU_BREAKER_ERRORS="25"         # số lỗi runtime/5 phút để mở circuit breaker
EMU_RUNTIME_URL=""              # URL runtime J2ME mặc định (iframe sandbox)

# Cloudflare R2 — lưu ảnh người dùng tải lên và sticker.
# Điền ở đây hoặc cấu hình trong trang Quản trị → Giao diện.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Sao lưu tự động — đặt chuỗi ngẫu nhiên dài để dịch vụ hẹn giờ gọi
# GET /api/admin/backup kèm header `Authorization: Bearer <token>`.
# Bỏ trống thì chỉ quản trị viên đăng nhập mới tải được bản sao lưu.
BACKUP_TOKEN=""
