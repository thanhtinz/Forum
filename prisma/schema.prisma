// Nova Platform — Prisma schema
// PostgreSQL + Auth.js (credentials + OAuth) + SePay

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Auth.js adapter models)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  passwordHash  String?
  image         String?
  cover         String?
  bio           String?   @db.Text

  role   Role   @default(USER)
  status UserStatus @default(ACTIVE)

  // Kinh tế
  points       Int @default(0)   // điểm (virtual currency, kiếm được)
  balance      Int @default(0)   // số dư nạp (VND, đơn vị đồng)
  frozenBalance Int @default(0)  // đang chờ rút

  // Cấp độ / kinh nghiệm
  exp   Int @default(0)
  level Int @default(1)

  // VIP
  vipTier      Int?      // null = không VIP; 1,2,3...
  vipExpiresAt DateTime? // null + vipTier != null => vĩnh viễn
  vipPermanent Boolean   @default(false)

  // Điểm danh
  checkinStreak    Int       @default(0)
  lastCheckinAt    DateTime?
  totalCheckinDays Int       @default(0)

  // Mời bạn
  inviteCode     String? @unique
  invitedById    String?
  invitedBy      User?   @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]  @relation("Invites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  comments       Comment[]
  threads        Thread[]
  replies        Reply[]
  reactions      Reaction[]
  favorites      Favorite[]
  orders         Order[]
  pointsLogs     PointsLog[]
  balanceLogs    BalanceLog[]
  downloads      DownloadLog[]
  medals         UserMedal[]
  notifications  Notification[]
  withdrawals    Withdrawal[]
  couponsClaimed CouponClaim[]
  followers      Follow[] @relation("Following")
  following      Follow[] @relation("Follower")
  reportsMade    Report[] @relation("Reporter")
  bans           Ban[]

  emulatorSessions EmulatorSession[]
  gameEvents       GameEvent[]
  gameKeymaps      UserKeymap[]
  gameSaveStates   SaveState[]
  gameRatings      GameRating[]
  gameConfigs      UserGameConfig[]

  @@index([level])
  @@index([vipTier])
  @@index([createdAt])
}

enum Role {
  USER
  AUTHOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CONTENT — Blog / bài viết
// ============================================================

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String? @db.Text
  content String  @db.Text
  cover   String?

  type   PostType   @default(ARTICLE)
  status PostStatus @default(DRAFT)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categories CategoriesOnPosts[]   // nhiều chuyên mục (WordPress-style)
  tags       TagsOnPosts[]

  // Card layout / hiển thị
  featured  Boolean @default(false)
  pinned    Boolean @default(false)
  cardStyle CardStyle @default(STANDARD)

  // Trả phí
  access      AccessLevel @default(FREE)
  pricePoints Int?        // giá bằng điểm
  priceAmount Int?        // giá bằng VND
  vipTierFree Int?        // VIP từ tier này trở lên xem miễn phí
  unlockLikes    Int?     // LIKE_GOAL: số lượt thích cần đạt để mở cho mọi người
  unlockComments Int?     // COMMENT_GOAL: số bình luận cần đạt để mở cho mọi người
  hiddenContent String?   @db.Text  // phần nội dung ẩn sau paywall
  // Mã BBCode gốc do người dùng gõ — giữ lại để sửa bài không mất định dạng.
  contentSource String?   @db.Text
  hiddenSource  String?   @db.Text
  faq         Json?       // [{ q, a }] — câu hỏi thường gặp của bài

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments   Comment[]
  reactions  Reaction[]
  favorites  Favorite[]
  downloads  DownloadItem[]
  orders     Order[]
  reports    Report[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
}

enum PostType {
  ARTICLE
  RESOURCE   // tài nguyên tải xuống
  DOC        // tài liệu / doc series
  PAGE
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum CardStyle {
  STANDARD
  WIDE
  TEXT_ONLY
  GALLERY
}

enum AccessLevel {
  FREE
  LOGIN_REQUIRED
  POINTS
  PAID
  VIP_ONLY

  // Mở khoá bằng tương tác của CHÍNH người xem
  LIKE            // phải thích bài
  COMMENT         // phải bình luận
  LIKE_COMMENT    // phải vừa thích vừa bình luận

  // Mở khoá cho TẤT CẢ khi đạt mốc tương tác chung
  LIKE_GOAL       // đủ `unlockLikes` lượt thích
  COMMENT_GOAL    // đủ `unlockComments` bình luận
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  color       String?
  order       Int     @default(0)

  parentId String?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CatTree")

  posts     Post[]               // chuyên mục chính (primary)
  postLinks CategoriesOnPosts[]  // nhiều chuyên mục

  createdAt DateTime @default(now())

  @@index([parentId])
}

model CategoriesOnPosts {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts TagsOnPosts[]
  threads TagsOnThreads[]
  games TagsOnGames[]
}

model TagsOnPosts {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ============================================================
// DOWNLOADS — nội dung tải xuống
// ============================================================

model DownloadItem {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  label    String
  url      String  @db.Text
  password String?          // mật khẩu giải nén
  extractCode String?       // mã trích xuất (netdisk)
  provider String?          // local | gdrive | onedrive | ...
  sizeBytes BigInt?
  version  String?

  order Int @default(0)

  logs DownloadLog[]

  createdAt DateTime @default(now())

  @@index([postId])
}

model DownloadLog {
  id     String @id @default(cuid())
  userId String
  itemId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   DownloadItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}

// ============================================================
// FORUM — diễn đàn
// ============================================================

model Forum {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  cover       String?
  order       Int     @default(0)

  postAccess  ForumAccess @default(ALL)
  minLevel    Int         @default(1)
  vipOnly     Boolean     @default(false)

  threadCount Int @default(0)
  replyCount  Int @default(0)

  parentId String?
  parent   Forum?  @relation("ForumTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Forum[] @relation("ForumTree")

  threads    Thread[]
  moderators ForumModerator[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

enum ForumAccess {
  ALL
  MEMBERS
  VIP
  MODERATORS
}

model ForumModerator {
  id      String @id @default(cuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([forumId, userId])
}

model Thread {
  id      String @id @default(cuid())
  forumId String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text
  // Mã BBCode gốc — giữ để sửa chủ đề không mất định dạng.
  contentSource String? @db.Text

  status ThreadStatus @default(PUBLISHED)
  pinned Boolean      @default(false)
  locked Boolean      @default(false)
  featured Boolean    @default(false)

  // Thưởng / hỏi đáp
  bountyPoints  Int?
  solvedReplyId String?  @unique

  viewCount  Int @default(0)
  replyCount Int @default(0)
  likeCount  Int @default(0)

  lastReplyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  replies   Reply[]
  tags      TagsOnThreads[]
  reactions Reaction[]
  favorites Favorite[]
  reports   Report[]

  @@index([forumId, lastReplyAt])
  @@index([authorId])
  @@index([pinned])
}

enum ThreadStatus {
  PUBLISHED
  PENDING
  HIDDEN
  DELETED
}

model TagsOnThreads {
  threadId String
  tagId    String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model Reply {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Reply?  @relation("ReplyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Reply[] @relation("ReplyTree")

  likeCount Int     @default(0)
  isSolution Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]
  reports   Report[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ============================================================
// COMMENTS (trên bài viết)
// ============================================================

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentTree")

  likeCount Int     @default(0)
  pinned    Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())

  reactions Reaction[]
  reports   Report[]

  @@index([postId, createdAt])
}

// ============================================================
// TƯƠNG TÁC
// ============================================================

model Reaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ReactionType @default(LIKE)

  postId    String?
  threadId  String?
  replyId   String?
  commentId String?

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread  Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply   Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, threadId, type])
  @@unique([userId, replyId, type])
  @@unique([userId, commentId, type])
}

enum ReactionType {
  LIKE
  DISLIKE
  HELPFUL
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId   String?
  threadId String?
  gameId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  folder String @default("default")

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, threadId])
  @@unique([userId, gameId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ============================================================
// KINH TẾ — điểm, số dư, đơn hàng
// ============================================================

model PointsLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount  Int         // +/- 
  balance Int         // số dư sau giao dịch
  reason  PointsReason
  note    String?
  refId   String?     // id đối tượng liên quan

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum PointsReason {
  CHECKIN
  POST_CREATE
  COMMENT_CREATE
  THREAD_CREATE
  REPLY_CREATE
  RECEIVED_LIKE
  INVITE_BONUS
  PURCHASE_CONTENT
  CONTENT_SALE       // tác giả nhận từ bán nội dung
  ADMIN_ADJUST
  EXCHANGE
  BOUNTY_PAID
  BOUNTY_RECEIVED
  COUPON
}

model BalanceLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount  Int          // VND, +/- 
  balance Int
  reason  BalanceReason
  note    String?
  refId   String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum BalanceReason {
  TOPUP
  PURCHASE
  REFUND
  WITHDRAW
  COMMISSION
  CONTENT_SALE       // tác giả nhận từ bán nội dung trả phí
  ADMIN_ADJUST
}

model Order {
  id     String @id @default(cuid())
  code   String @unique          // mã đơn hiển thị
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   OrderType
  status OrderStatus @default(PENDING)

  // Đối tượng mua
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  vipPlanId String?
  vipPlan   VipPlan? @relation(fields: [vipPlanId], references: [id], onDelete: SetNull)

  amount        Int      // VND trước giảm
  discount      Int      @default(0)
  finalAmount   Int      // thực trả
  pointsUsed    Int      @default(0)
  payMethod     PayMethod?

  couponClaimId String?     @unique
  couponClaim   CouponClaim? @relation(fields: [couponClaimId], references: [id], onDelete: SetNull)

  // SePay
  sepayRefId       String?  @unique
  sepayTransaction String?  @db.Text
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commission Commission?

  @@index([userId, createdAt])
  @@index([status])
}

enum OrderType {
  CONTENT
  VIP
  TOPUP
  POINTS
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum PayMethod {
  SEPAY
  BALANCE
  POINTS
  ADMIN
}

// ============================================================
// VIP
// ============================================================

model VipPlan {
  id       String @id @default(cuid())
  tier     Int             // 1, 2, 3
  name     String
  description String? @db.Text
  color    String?
  icon     String?

  durationDays Int?         // null => vĩnh viễn
  price        Int          // VND
  originalPrice Int?
  permanent    Boolean @default(false)

  // Quyền lợi
  discountPercent  Int @default(0)   // giảm giá khi mua nội dung
  freeContent      Boolean @default(false)
  dailyPointsBonus Int @default(0)
  checkinMultiplier Float @default(1)

  active Boolean @default(true)
  order  Int     @default(0)

  orders Order[]

  createdAt DateTime @default(now())

  @@unique([tier])
}

// ============================================================
// COUPON / MÃ GIẢM GIÁ
// ============================================================

model Coupon {
  id   String @id @default(cuid())
  code String @unique
  name String

  type  CouponType @default(FIXED)
  value Int                       // VND hoặc %

  minAmount   Int?
  maxDiscount Int?

  appliesTo OrderType?

  totalQuantity Int?    // null = không giới hạn
  usedCount     Int     @default(0)
  perUserLimit  Int     @default(1)

  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean  @default(true)

  claims CouponClaim[]

  createdAt DateTime @default(now())
}

enum CouponType {
  FIXED
  PERCENT
}

model CouponClaim {
  id       String @id @default(cuid())
  couponId String
  userId   String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt DateTime?
  order  Order?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([couponId])
}

// ============================================================
// HOA HỒNG / RÚT TIỀN
// ============================================================

model Commission {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  beneficiaryId String   // người nhận hoa hồng
  amount        Int
  rate          Float
  status        CommissionStatus @default(PENDING)
  settledAt     DateTime?

  createdAt DateTime @default(now())

  @@index([beneficiaryId])
}

enum CommissionStatus {
  PENDING
  SETTLED
  CANCELLED
}

model Withdrawal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int
  fee    Int @default(0)
  status WithdrawalStatus @default(PENDING)

  bankName    String?
  bankAccount String?
  bankHolder  String?

  note       String?
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ============================================================
// GAMIFICATION — huy chương, cấp độ
// ============================================================

model Medal {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String? @db.Text
  icon        String
  color       String?
  rarity      Int    @default(1)

  autoGrant     Boolean @default(false)
  conditionType String?          // posts_count | checkin_streak | ...
  conditionValue Int?

  users UserMedal[]

  createdAt DateTime @default(now())
}

model UserMedal {
  id      String @id @default(cuid())
  userId  String
  medalId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal   Medal  @relation(fields: [medalId], references: [id], onDelete: Cascade)

  displayed Boolean   @default(true)
  expiresAt DateTime?
  grantedAt DateTime  @default(now())

  @@unique([userId, medalId])
}

model LevelRule {
  id       String @id @default(cuid())
  level    Int    @unique
  name     String
  expRequired Int
  icon     String?
  color    String?

  // Quyền lợi theo cấp
  dailyDownloadLimit Int?
  canPostThread      Boolean @default(true)
  canUploadFile      Boolean @default(false)
}

// ============================================================
// THÔNG BÁO / TIN NHẮN
// ============================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  content String? @db.Text
  link    String?
  actorId String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

enum NotificationType {
  COMMENT
  REPLY
  MENTION
  LIKE
  FOLLOW
  ORDER
  SYSTEM
  MEDAL
  VIP
}

// ============================================================
// KIỂM DUYỆT
// ============================================================

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  postId    String?
  threadId  String?
  replyId   String?
  commentId String?
  gameId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply     Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  reason  String
  detail  String? @db.Text
  status  ReportStatus @default(OPEN)
  handledAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Ban {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason    String
  scope     BanScope @default(FULL)
  expiresAt DateTime?
  createdBy String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum BanScope {
  FULL
  COMMENT
  POST
  FORUM
}

// ============================================================
// CẤU HÌNH / TRANG CHỦ
// ============================================================

model StickerPack {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  order    Int    @default(0)
  active   Boolean @default(true)

  stickers Sticker[]

  createdAt DateTime @default(now())
}

model Sticker {
  id     String @id @default(cuid())
  packId String
  pack   StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  name String
  url  String  @db.Text
  /** Khoá đối tượng trên R2 để xoá được khi gỡ pack. */
  storageKey String? @db.Text
  order Int @default(0)

  @@index([packId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Slide {
  id       String @id @default(cuid())
  title    String
  subtitle String?
  image    String
  link     String?
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
}

model NavLink {
  id     String @id @default(cuid())
  label  String
  url    String
  icon   String?
  order  Int     @default(0)
  group  String  @default("header")   // header | footer | sidebar

  parentId String?
  parent   NavLink?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavLink[] @relation("NavTree")
}

model FriendLink {
  id     String @id @default(cuid())
  name   String
  url    String
  logo   String?
  description String?
  order  Int     @default(0)
  active Boolean @default(true)
}

// ============================================================
// GAME HUB — catalog game Java ME + emulator Play Online
// ============================================================

model Game {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String              // tên chính thức
  titleVi String?             // tên bản Việt hóa
  series  String?             // dòng game (Contra, Asphalt…)

  description String? @db.Text // mô tả
  gameplay    String? @db.Text // lối chơi
  icon        String?          // ảnh icon (URL/storage key)
  cover       String?          // ảnh nền trang chi tiết
  trailerUrl  String?          // video/trailer tuỳ chọn

  developer String?
  publisher String?
  releaseYear Int?

  language    String  @default("en")   // en | vi | multi
  vietnamized Boolean @default(false)  // bản Việt hóa

  status    GameStatus @default(DRAFT)
  featured  Boolean    @default(false)
  playOnline Boolean   @default(false) // bật Play Online cho game này

  // Phân loại
  platformId   String?
  platform     GamePlatform?   @relation(fields: [platformId], references: [id], onDelete: SetNull)
  resolutionId String?
  resolution   GameResolution? @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  genres       GenresOnGames[]
  tags         TagsOnGames[]
  collections  GamesOnCollections[]

  // Emulator mặc định (game tham chiếu profile, không nhúng logic emulator)
  emulatorProfileId String?
  emulatorProfile   EmulatorProfile? @relation("GameDefaultProfile", fields: [emulatorProfileId], references: [id], onDelete: SetNull)

  // Hướng dẫn / lưu ý
  controls          Json?            // [{ key, action }] — key mapping mô tả
  compatibilityNote String? @db.Text
  knownIssues       String? @db.Text

  // Thống kê
  ratingSum   Int   @default(0)
  ratingCount Int   @default(0)
  viewCount           Int @default(0)
  uniqueViewCount     Int @default(0)
  downloadCount       Int @default(0)
  uniqueDownloadCount Int @default(0)
  playCount           Int @default(0)
  uniquePlayerCount   Int @default(0)
  playSeconds         Int @default(0) // tổng thời lượng phiên (giây)
  trendingScore       Float @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions   GameVersion[]
  images     GameImage[]
  profiles   GameEmulatorProfile[]
  sessions   EmulatorSession[]
  events     GameEvent[]
  ratings    GameRating[]
  configs    UserGameConfig[]
  favorites  Favorite[]
  reports    Report[]
  uniqueHits GameUniqueHit[]

  @@index([status, publishedAt])
  @@index([featured])
  @@index([trendingScore])
  @@index([platformId])
  @@index([resolutionId])
  @@index([vietnamized])
}

enum GameStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model GameGenre {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  icon  String?
  color String?
  order Int    @default(0)

  games GenresOnGames[]
}

model GenresOnGames {
  gameId  String
  genreId String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   GameGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
}

model TagsOnGames {
  gameId String
  tagId  String
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
}

/// Nokia S40/S60, Sony Ericsson, Samsung, Motorola, Generic Java ME…
model GamePlatform {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  icon  String?
  order Int    @default(0)

  games Game[]
}

/// 128x160, 176x208, 176x220, 240x320, 320x240, 360x640, custom…
model GameResolution {
  id     String  @id @default(cuid())
  slug   String  @unique      // "240x320"
  label  String                // "240 × 320"
  width  Int
  height Int
  custom Boolean @default(false)
  order  Int     @default(0)

  games Game[]
}

model GameCollection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  cover       String?
  featured    Boolean @default(false)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  games GamesOnCollections[]
}

model GamesOnCollections {
  gameId       String
  collectionId String
  order        Int    @default(0)
  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  collection   GameCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([gameId, collectionId])
  @@index([collectionId])
}

// ── Versioning ────────────────────────────────────────────

model GameVersion {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  version     String            // "1.0.2"
  releaseDate DateTime?
  changelog   String?  @db.Text
  sizeBytes   BigInt?           // tổng dung lượng (thường = JAR)
  latest      Boolean  @default(false)
  playOnline  Boolean  @default(false) // Play Online Compatible hay Download Only
  note        String?

  createdAt DateTime @default(now())

  files      GameFile[]
  profiles   GameEmulatorProfile[]
  sessions   EmulatorSession[]
  saveStates SaveState[]
  events     GameEvent[]

  @@unique([gameId, version])
  @@index([gameId, latest])
}

model GameFile {
  id        String @id @default(cuid())
  versionId String
  version   GameVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  type       GameFileType
  storageKey String                 // key trên object storage / CDN
  fileName   String?
  sizeBytes  BigInt?
  checksum   String?                // giá trị checksum
  checksumAlgo String @default("sha256")
  mimeType   String?

  scanStatus ScanStatus @default(PENDING) // quét JAR/JAD trước khi phát hành
  scanNote   String?

  createdAt DateTime @default(now())

  @@unique([versionId, type])
  @@index([scanStatus])
}

enum GameFileType {
  JAR
  JAD
  PATCH
}

enum ScanStatus {
  PENDING
  CLEAN
  SUSPICIOUS
  QUARANTINED
}

model GameImage {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type       GameImageType @default(SCREENSHOT)
  storageKey String
  caption    String?
  width      Int?
  height     Int?
  sortOrder  Int @default(0)

  createdAt DateTime @default(now())

  @@index([gameId, type, sortOrder])
}

enum GameImageType {
  ICON
  COVER
  SCREENSHOT
  TRAILER
}

// ── Emulator ──────────────────────────────────────────────

model EmulatorProfile {
  id     String @id @default(cuid())
  slug   String @unique
  name   String              // "Nokia S40 240x320"
  vendor String?             // Nokia / Sony Ericsson / Samsung…

  screenWidth  Int
  screenHeight Int
  orientation  Orientation @default(PORTRAIT)

  cldc String @default("1.1")
  midp String @default("2.0")

  keyLayout String  @default("nokia")  // nokia | sonyericsson | generic
  softKeys  Boolean @default(true)
  audio     Boolean @default(true)
  rms       Boolean @default(true)
  saveState Boolean @default(false)
  touch     Boolean @default(true)

  /// Bản đồ phím mặc định: { "SOFT_LEFT": "Digit1", "UP": "ArrowUp", … }
  keymap Json?

  // Resource control
  cpuMillicores  Int @default(500)
  ramLimitMb     Int @default(256)
  sessionMaxSec  Int @default(1800) // maximum duration
  idleTimeoutSec Int @default(120)  // idle timeout (không heartbeat)
  gracePeriodSec Int @default(60)   // reconnect grace
  maxConcurrent  Int @default(50)   // giới hạn phiên đồng thời cho profile

  /// URL runtime J2ME chạy trong iframe sandbox (worker riêng, không chung process web).
  runtimeUrl String?
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForGames Game[]                @relation("GameDefaultProfile")
  gameProfiles    GameEmulatorProfile[]
  sessions        EmulatorSession[]
  keymaps         UserKeymap[]

  @@index([active])
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

/// Ma trận tương thích: game (hoặc version cụ thể) × emulator profile.
model GameEmulatorProfile {
  id        String @id @default(cuid())
  gameId    String
  versionId String?
  profileId String

  game    Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version GameVersion?    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  profile EmulatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  support EmuSupport @default(FULL)
  note    String?

  @@unique([gameId, versionId, profileId])
  @@index([profileId])
}

enum EmuSupport {
  FULL
  BETA
  NONE
}

model EmulatorSession {
  id String @id @default(cuid())

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey  String?          // khoá ẩn danh (cookie) cho khách

  gameId        String
  game          Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameVersionId String
  gameVersion   GameVersion @relation(fields: [gameVersionId], references: [id], onDelete: Cascade)
  profileId     String
  profile       EmulatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status SessionStatus @default(CREATED)

  queuePosition Int?             // vị trí hàng đợi khi quá tải
  workerId      String?
  runtimeUrl    String? @db.Text

  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  lastHeartbeatAt DateTime?
  pausedAt        DateTime?
  endedAt         DateTime?
  expiresAt       DateTime                 // maximum duration
  durationSec     Int       @default(0)
  playedSec       Int       @default(0)    // thời lượng thực (trừ pause)

  ip        String?
  userAgent String? @db.Text
  error     String? @db.Text

  events GameEvent[]

  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([guestKey, status])
  @@index([gameId, createdAt])
}

enum SessionStatus {
  CREATED
  QUEUED
  LOADING
  RUNNING
  PAUSED
  RECONNECTING
  EXPIRED
  CLOSED
  ERROR
}

// ── Sự kiện & thống kê ────────────────────────────────────

model GameEvent {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  versionId String?
  version   GameVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  session   EmulatorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  actorKey String            // userId hoặc hash(ip+ua) cho khách
  type     GameEventType
  isUnique Boolean @default(false)
  value    Int?              // ví dụ: thời lượng phiên (giây)
  meta     Json?

  createdAt DateTime @default(now())

  @@index([gameId, type, createdAt])
  @@index([type, createdAt])
  @@index([actorKey, type])
}

enum GameEventType {
  VIEW
  DOWNLOAD
  PLAY_START
  PLAY_END
  PLAY_ERROR
  FAVORITE
  SHARE
  RATE
}

/// Khoá chống trùng cho "unique view / unique download / unique player".
model GameUniqueHit {
  id       String        @id @default(cuid())
  gameId   String
  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type     GameEventType
  actorKey String

  createdAt DateTime @default(now())

  @@unique([gameId, type, actorKey])
}

model GameRating {
  id     String @id @default(cuid())
  gameId String
  userId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int    // 1..5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, userId])
  @@index([gameId])
}

// ── Input & Save ──────────────────────────────────────────

model UserKeymap {
  id        String @id @default(cuid())
  userId    String
  profileId String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   EmulatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// { "SOFT_LEFT": "KeyQ", "FIRE": "Space", … }
  mapping Json

  updatedAt DateTime @updatedAt

  @@unique([userId, profileId])
}

/**
 * Cấu hình emulator người dùng đặt riêng cho từng game (kiểu J2ME Loader):
 * kích thước màn hình, cách phóng, lọc ảnh, giới hạn FPS, hệ số tốc độ…
 * Khách chưa đăng nhập thì giữ trong localStorage của trình duyệt.
 */
model UserGameConfig {
  id     String @id @default(cuid())
  userId String
  gameId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([gameId])
}

model SaveState {
  id            String @id @default(cuid())
  userId        String
  gameVersionId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameVersion   GameVersion @relation(fields: [gameVersionId], references: [id], onDelete: Cascade)

  kind       SaveKind @default(RMS)
  slot       Int      @default(0)
  label      String?
  storageKey String
  sizeBytes  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameVersionId, kind, slot])
  @@index([userId])
}

enum SaveKind {
  RMS
  STATE
}
