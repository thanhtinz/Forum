# Chuỗi kết nối Postgres.
DATABASE_URL="postgresql://nguoi:matkhau@localhost:5432/nova"

# Địa chỉ gốc của trang, dùng cho SEO và cho đường dẫn tuyệt đối.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Mấy dòng dưới đây SỬA ĐƯỢC TRONG KHU QUẢN TRỊ ─────────────────────────
# Kho tệp (R2), gửi thư (SMTP) và thông tin cửa hàng nay có chỗ sửa ở
# `/quan-tri/cai-dat`, mỗi nhóm một tab, và sửa xong có hiệu lực ngay chứ
# không phải dựng lại trang.
#
# Thứ tự ưu tiên: CÓ trong khu quản trị thì lấy cái ấy, KHÔNG thì lùi về mấy
# dòng dưới đây. Nên vẫn nên khai đủ ở đây — máy vừa dựng lên, cơ sở dữ liệu
# còn trống trơn, thì cửa hàng phải gửi được thư và nhận được tệp ngay chứ
# không đợi ai vào bấm Lưu.
#
# Tên cửa hàng, câu giới thiệu và email liên hệ thì KHÔNG có biến môi trường:
# chúng chỉ nằm trong khu quản trị, chưa đặt thì dùng chữ mặc định.

# ─── Cổng nhà phát triển ───────────────────────────────────────────────────
# Bảng tác giả và trang xin làm tác giả có tên miền riêng: cứ thêm tiền tố
# `developer.` vào trước tên miền cửa hàng là ra — không cần khai biến nào.
# Chỉ cần trỏ bản ghi DNS `developer.<tên miền>` về cùng máy chủ; phần mềm
# trung gian tự phân luồng. Ở máy dựng thì `developer.localhost` chạy sẵn.

# ─── Kho của cửa hàng: Cloudflare R2 ───────────────────────────────────────
# Giữ CẢ ẢNH, PHIM LẪN TỆP GAME: biểu tượng, ảnh bìa, ảnh chụp màn hình, ảnh
# trong bài diễn đàn, đoạn phim xem trước, và mọi tệp cài đặt (JAR, APK, EXE…)
# người ta tải về.
# Thiếu bất kỳ dòng nào thì tệp tải lên sẽ ghi xuống `tai-len/` — dùng
# được khi chạy ở máy phát triển, KHÔNG dùng được trên máy chủ chỉ đọc.
#
# Lấy ở bảng điều khiển Cloudflare: R2 → thùng của bạn → Settings.
#   R2_TAI_KHOAN : mã tài khoản, nằm trong địa chỉ endpoint
#   R2_KHOA      : Access Key ID của một API token có quyền ghi vào thùng
#   R2_BI_MAT    : Secret Access Key của chính token ấy
#   R2_THUNG     : tên thùng
#   R2_DIA_CHI   : địa chỉ công khai của thùng (tên miền riêng hoặc r2.dev)
R2_TAI_KHOAN=
R2_KHOA=
R2_BI_MAT=
R2_THUNG=
R2_DIA_CHI=

# ─── Gửi thư (SMTP) ────────────────────────────────────────────────────────
# Dùng cho BA việc: gửi mã xác minh email lúc mở tài khoản, gửi mã đặt lại mật
# khẩu cho người quên, và báo mỗi khi có thông báo mới (người dùng tắt được ở
# trang Cài đặt).
#
# THIẾU BẤT KỲ DÒNG NÀO LÀ TẮT HẲN phần gửi thư, và cả ba việc trên tự lùi về
# lối cũ: đăng ký vào thẳng không cần mã, trang "Quên mật khẩu" chỉ đường xin
# mã tay từ ban quản trị, công tắc nhận thư không hiện ra. KHÔNG bày một ô nhập
# bấm vào rồi chẳng có gì tới.
#
# Riêng chuyện bắt xác minh email phải tự tắt theo là bắt buộc chứ không phải
# cho tiện: thiếu cấu hình thư mà vẫn bắt xác minh là khoá cửa hẳn — chẳng ai
# mở nổi tài khoản nào nữa.
#
# Cổng 465 là TLS ngay từ đầu; 587 thì bắt tay xong mới nâng cấp bằng
# STARTTLS. Đoán sai chỗ này là nối kết treo im cho tới lúc hết giờ chờ.
THU_MAY_CHU="smtp.example.com"
THU_CONG="587"
THU_NGUOI="khong-tra-loi@example.com"
THU_MAT_KHAU=""
# Địa chỉ đứng tên người gửi. Bỏ trống thì mượn luôn THU_NGUOI.
THU_TU="SunnyStore <khong-tra-loi@example.com>"

# Bao nhiêu proxy của chính mình đứng trước cửa hàng (nginx, CDN…).
# Dùng để đọc đúng IP người gọi trong `x-forwarded-for`: mẩu đầu của tiêu đề
# ấy là chuỗi máy khách TỰ KHAI, nên lấy nhầm nó là mọi cửa chặn theo IP hoá
# ra không chặn gì. Để trống thì hiểu là 1.
SO_PROXY_TIN=1
