// Nova Platform — Prisma schema
// PostgreSQL + Auth.js (credentials + OAuth) + SePay

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Auth.js adapter models)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  passwordHash  String?
  image         String?
  cover         String?
  bio           String?   @db.Text
  /// Tâm trạng — dòng chữ ngắn hiện cạnh tên, đổi xoành xoạch. Mod "tâm
  /// trạng" là thứ forum wap Việt nào quãng 2010 cũng gắn thêm.
  mood          String?
  /**
   * Chữ ký — dán dưới mỗi bài viết của người này ở diễn đàn.
   * Forum Việt thời 2010 nhà nào cũng có; nhận BBCode như nội dung bài.
   */
  signature     String?   @db.Text

  role   Role   @default(USER)
  status UserStatus @default(ACTIVE)

  // Kinh tế — chỉ còn MỘT loại: điểm, kiếm được bằng hoạt động trên diễn đàn.
  points Int @default(0)

  // Cấp độ / kinh nghiệm
  exp   Int @default(0)
  level Int @default(1)

  // Điểm danh
  checkinStreak    Int       @default(0)
  lastCheckinAt    DateTime?
  totalCheckinDays Int       @default(0)

  // Mời bạn
  inviteCode     String? @unique
  invitedById    String?
  invitedBy      User?   @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]  @relation("Invites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  comments       Comment[]
  threads        Thread[]
  replies        Reply[]
  reactions      Reaction[]
  favorites      Favorite[]
  orders         Order[]
  pointsLogs     PointsLog[]
  downloads      DownloadLog[]
  medals         UserMedal[]
  notifications  Notification[]
  couponsClaimed CouponClaim[]
  followers      Follow[] @relation("Following")
  following      Follow[] @relation("Follower")
  reportsMade    Report[] @relation("Reporter")
  bans           Ban[]
  blocksMade     Block[] @relation("Blocker")
  blocksAgainst  Block[] @relation("Blocked")
  convosA        Conversation[] @relation("ConvoA")
  convosB        Conversation[] @relation("ConvoB")
  messagesSent   Message[]
  msgReactions   MessageReaction[]
  threadFollows  ThreadFollow[]
  pollVotes      PollVote[]

  /// Các loại thông báo người dùng đã tắt (chỉ áp dụng cho loại được phép tắt).
  notifyOff      NotificationType[] @default([])
  adminLogs      AdminLog[] @relation("AdminLogActor")

  gameEvents  GameEvent[]
  gameRatings GameRating[]

  shouts        ShoutMessage[]
  shoutsDeleted ShoutMessage[] @relation("ShoutDeleter")
  gameUnlocks   GameUnlock[]
  presence      PresenceHere[]
  donationsSent     PointDonation[] @relation("DonationFrom")
  donationsReceived PointDonation[] @relation("DonationTo")

  @@index([level])
  @@index([createdAt])
}

enum Role {
  USER
  AUTHOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CONTENT — Blog / bài viết
// ============================================================

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String? @db.Text
  content String  @db.Text
  cover   String?

  type   PostType   @default(ARTICLE)
  status PostStatus @default(DRAFT)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categories CategoriesOnPosts[]   // nhiều chuyên mục (WordPress-style)
  tags       TagsOnPosts[]

  // Card layout / hiển thị
  featured  Boolean @default(false)
  pinned    Boolean @default(false)
  cardStyle CardStyle @default(STANDARD)

  // Trả phí
  access      AccessLevel @default(FREE)
  pricePoints Int?        // giá bằng điểm
  unlockLikes    Int?     // LIKE_GOAL: số lượt thích cần đạt để mở cho mọi người
  unlockComments Int?     // COMMENT_GOAL: số bình luận cần đạt để mở cho mọi người
  hiddenContent String?   @db.Text  // phần nội dung ẩn sau paywall
  // Mã BBCode gốc do người dùng gõ — giữ lại để sửa bài không mất định dạng.
  contentSource String?   @db.Text
  hiddenSource  String?   @db.Text
  faq         Json?       // [{ q, a }] — câu hỏi thường gặp của bài

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments   Comment[]
  reactions  Reaction[]
  favorites  Favorite[]
  downloads  DownloadItem[]
  orders     Order[]
  reports    Report[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
}

enum PostType {
  ARTICLE
  RESOURCE   // tài nguyên tải xuống
  DOC        // tài liệu / doc series
  PAGE
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum CardStyle {
  STANDARD
  WIDE
  TEXT_ONLY
  GALLERY
}

enum AccessLevel {
  FREE
  LOGIN_REQUIRED
  POINTS

  // Mở khoá bằng tương tác của CHÍNH người xem
  LIKE            // phải thích bài
  COMMENT         // phải bình luận
  LIKE_COMMENT    // phải vừa thích vừa bình luận

  // Mở khoá cho TẤT CẢ khi đạt mốc tương tác chung
  LIKE_GOAL       // đủ `unlockLikes` lượt thích
  COMMENT_GOAL    // đủ `unlockComments` bình luận
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  color       String?
  order       Int     @default(0)

  parentId String?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CatTree")

  posts     Post[]               // chuyên mục chính (primary)
  postLinks CategoriesOnPosts[]  // nhiều chuyên mục

  createdAt DateTime @default(now())

  @@index([parentId])
}

model CategoriesOnPosts {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts TagsOnPosts[]
  threads TagsOnThreads[]
  games TagsOnGames[]
}

model TagsOnPosts {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ============================================================
// DOWNLOADS — nội dung tải xuống
// ============================================================

model DownloadItem {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  label    String
  url      String  @db.Text
  password String?          // mật khẩu giải nén
  extractCode String?       // mã trích xuất (netdisk)
  provider String?          // local | gdrive | onedrive | ...
  sizeBytes BigInt?
  version  String?

  order Int @default(0)

  logs DownloadLog[]

  createdAt DateTime @default(now())

  @@index([postId])
}

model DownloadLog {
  id     String @id @default(cuid())
  userId String
  itemId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   DownloadItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}

// ============================================================
// FORUM — diễn đàn
// ============================================================

model Forum {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  cover       String?
  order       Int     @default(0)

  postAccess  ForumAccess @default(ALL)
  minLevel    Int         @default(1)

  threadCount Int @default(0)
  replyCount  Int @default(0)

  parentId String?
  parent   Forum?  @relation("ForumTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Forum[] @relation("ForumTree")

  threads    Thread[]
  moderators ForumModerator[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

enum ForumAccess {
  ALL
  MEMBERS
  MODERATORS
}

model ForumModerator {
  id      String @id @default(cuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([forumId, userId])
}

model Thread {
  id      String @id @default(cuid())
  forumId String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text
  // Mã BBCode gốc — giữ để sửa chủ đề không mất định dạng.
  contentSource String? @db.Text

  status ThreadStatus @default(PUBLISHED)
  pinned Boolean      @default(false)
  locked Boolean      @default(false)
  featured Boolean    @default(false)

  // Thưởng / hỏi đáp
  bountyPoints  Int?
  solvedReplyId String?  @unique

  viewCount  Int @default(0)
  replyCount Int @default(0)
  likeCount  Int @default(0)

  lastReplyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  replies   Reply[]
  tags      TagsOnThreads[]
  reactions Reaction[]
  favorites Favorite[]
  reports   Report[]
  followers ThreadFollow[]
  poll      Poll?
  donations PointDonation[]

  @@index([forumId, lastReplyAt])
  @@index([authorId])
  @@index([pinned])
}

/// Bình chọn gắn vào một chủ đề — mỗi chủ đề nhiều nhất một cuộc.
model Poll {
  id       String @id @default(cuid())
  threadId String @unique
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  question String
  /// Cho chọn nhiều đáp án cùng lúc.
  multiple Boolean @default(false)
  /// Hết hạn thì khoá lại và ai cũng xem được kết quả. null = không hạn.
  closesAt DateTime?
  /// Chủ đề/quản trị đóng sớm.
  closed   Boolean @default(false)

  createdAt DateTime @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text  String
  order Int @default(0)

  votes PollVote[]

  @@index([pollId, order])
}

model PollVote {
  id       String @id @default(cuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

/// Theo dõi chủ đề: có trả lời mới thì được báo, kể cả không phải chủ chủ đề.
model ThreadFollow {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@index([userId, createdAt])
}


enum ThreadStatus {
  PUBLISHED
  PENDING
  HIDDEN
  DELETED
}

model TagsOnThreads {
  threadId String
  tagId    String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model Reply {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Reply?  @relation("ReplyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Reply[] @relation("ReplyTree")

  likeCount Int     @default(0)
  isSolution Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]
  reports   Report[]
  donations PointDonation[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ============================================================
// COMMENTS (trên bài viết)
// ============================================================

model Comment {
  id String @id @default(cuid())

  // Bình luận gắn vào MỘT trong hai: bài viết hoặc game. Cùng kiểu "một cột
  // cho mỗi đối tượng" mà Reaction và Favorite đang dùng, để khỏi phải bịa ra
  // bảng bình luận riêng cho kho game.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentTree")

  likeCount Int     @default(0)
  pinned    Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  /// Bình luận cũ chưa có cột này nên lấy now() làm mốc, coi như chưa từng sửa.
  updatedAt DateTime @default(now()) @updatedAt

  reactions Reaction[]
  reports   Report[]

  @@index([postId, createdAt])
  @@index([gameId, createdAt])
}

// ============================================================
// TƯƠNG TÁC
// ============================================================

model Reaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ReactionType @default(LIKE)

  postId    String?
  threadId  String?
  replyId   String?
  commentId String?

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread  Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply   Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, threadId, type])
  @@unique([userId, replyId, type])
  @@unique([userId, commentId, type])
}

enum ReactionType {
  LIKE
  DISLIKE
  HELPFUL
  /// Nút "Cảm ơn" của forum Việt ngày xưa — khác Thích ở chỗ nó công khai
  /// danh sách người đã cảm ơn ngay dưới bài, và một người vẫn vừa thích
  /// vừa cảm ơn được (ràng buộc duy nhất đã tính cả `type`).
  THANKS
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId   String?
  threadId String?
  gameId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  folder String @default("default")

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, threadId])
  @@unique([userId, gameId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ============================================================
// KINH TẾ — chỉ còn điểm và sổ ghi quyền mở khoá nội dung
// ============================================================

model PointsLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount  Int         // +/- 
  balance Int         // số dư sau giao dịch
  reason  PointsReason
  note    String?
  refId   String?     // id đối tượng liên quan

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum PointsReason {
  CHECKIN
  POST_CREATE
  COMMENT_CREATE
  THREAD_CREATE
  REPLY_CREATE
  RECEIVED_LIKE
  INVITE_BONUS
  PURCHASE_CONTENT
  CONTENT_SALE       // tác giả nhận từ bán nội dung
  ADMIN_ADJUST
  EXCHANGE
  BOUNTY_PAID
  BOUNTY_RECEIVED
  COUPON
  DONATE_SENT        // tặng điểm cho bài của người khác
  DONATE_RECEIVED    // nhận điểm người khác tặng
}



model Order {
  id     String @id @default(cuid())
  code   String @unique          // mã đơn hiển thị
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status OrderStatus @default(PENDING)

  // Đối tượng mua
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  discount   Int @default(0)
  pointsUsed Int @default(0)

  couponClaimId String?     @unique
  couponClaim   CouponClaim? @relation(fields: [couponClaimId], references: [id], onDelete: SetNull)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}


enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}


// ============================================================
// VIP
// ============================================================


// ============================================================
// COUPON / MÃ GIẢM GIÁ
// ============================================================

model Coupon {
  id   String @id @default(cuid())
  code String @unique
  name String

  type  CouponType @default(FIXED)
  value Int                       // số điểm giảm, hoặc %

  minAmount   Int?
  maxDiscount Int?

  totalQuantity Int?    // null = không giới hạn
  usedCount     Int     @default(0)
  perUserLimit  Int     @default(1)

  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean  @default(true)

  claims CouponClaim[]

  createdAt DateTime @default(now())
}

enum CouponType {
  FIXED
  PERCENT
}

model CouponClaim {
  id       String @id @default(cuid())
  couponId String
  userId   String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt DateTime?
  order  Order?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([couponId])
}

// ============================================================
// HOA HỒNG / RÚT TIỀN
// ============================================================





// ============================================================
// GAMIFICATION — huy chương, cấp độ
// ============================================================

model Medal {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String? @db.Text
  icon        String
  color       String?
  rarity      Int    @default(1)

  autoGrant     Boolean @default(false)
  conditionType String?          // posts_count | checkin_streak | ...
  conditionValue Int?

  users UserMedal[]

  createdAt DateTime @default(now())
}

model UserMedal {
  id      String @id @default(cuid())
  userId  String
  medalId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal   Medal  @relation(fields: [medalId], references: [id], onDelete: Cascade)

  displayed Boolean   @default(true)
  expiresAt DateTime?
  grantedAt DateTime  @default(now())

  @@unique([userId, medalId])
}

model LevelRule {
  id       String @id @default(cuid())
  level    Int    @unique
  name     String
  expRequired Int
  icon     String?
  color    String?

  // Quyền lợi theo cấp
  dailyDownloadLimit Int?
  canPostThread      Boolean @default(true)
  canUploadFile      Boolean @default(false)
}

// ============================================================
// THÔNG BÁO / TIN NHẮN
// ============================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  content String? @db.Text
  link    String?
  actorId String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

enum NotificationType {
  COMMENT
  REPLY
  MENTION
  LIKE
  FOLLOW
  ORDER
  SYSTEM
  MEDAL
  /// Được người khác tặng điểm.
  DONATE
}

// ============================================================
// KIỂM DUYỆT
// ============================================================

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  postId    String?
  threadId  String?
  replyId   String?
  commentId String?
  gameId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply     Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  reason  String
  detail  String? @db.Text
  status  ReportStatus @default(OPEN)
  handledAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Ban {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason    String
  scope     BanScope @default(FULL)
  expiresAt DateTime?
  createdBy String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum BanScope {
  FULL
  COMMENT
  POST
  FORUM
}

// ============================================================
// CẤU HÌNH / TRANG CHỦ
// ============================================================

model StickerPack {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  order    Int    @default(0)
  active   Boolean @default(true)

  stickers Sticker[]

  createdAt DateTime @default(now())
}

model Sticker {
  id     String @id @default(cuid())
  packId String
  pack   StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  name String
  url  String  @db.Text
  /** Khoá đối tượng trên R2 để xoá được khi gỡ pack. */
  storageKey String? @db.Text
  order Int @default(0)

  @@index([packId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Slide {
  id       String @id @default(cuid())
  title    String
  subtitle String?
  image    String
  link     String?
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
}

model NavLink {
  id     String @id @default(cuid())
  label  String
  url    String
  icon   String?
  order  Int     @default(0)
  group  String  @default("header")   // header | footer | sidebar

  parentId String?
  parent   NavLink?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavLink[] @relation("NavTree")
}

model FriendLink {
  id     String @id @default(cuid())
  name   String
  url    String
  logo   String?
  description String?
  order  Int     @default(0)
  active Boolean @default(true)
}

// ============================================================
// GAME HUB — catalog game Java ME
// ============================================================

model Game {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String              // tên chính thức
  titleVi String?             // tên bản Việt hóa
  series  String?             // dòng game (Contra, Asphalt…)

  description String? @db.Text // mô tả
  gameplay    String? @db.Text // lối chơi
  icon        String?          // ảnh icon (URL/storage key)
  cover       String?          // ảnh nền trang chi tiết
  trailerUrl  String?          // video/trailer tuỳ chọn

  developer String?
  publisher String?
  releaseYear Int?

  language    String  @default("en")   // en | vi | multi
  vietnamized Boolean @default(false)  // bản Việt hóa

  status   GameStatus @default(DRAFT)
  featured Boolean    @default(false)

  /**
   * Số điểm phải trả để mở phần tải xuống. null hoặc 0 = tải tự do.
   * Trả một lần là mở mãi, ghi lại bằng GameUnlock.
   */
  pricePoints Int?

  // Phân loại
  platformId   String?
  platform     GamePlatform?   @relation(fields: [platformId], references: [id], onDelete: SetNull)
  resolutionId String?
  resolution   GameResolution? @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  genres       GenresOnGames[]
  tags         TagsOnGames[]
  collections  GamesOnCollections[]

  // Hướng dẫn / lưu ý
  controls          Json?            // [{ key, action }] — key mapping mô tả
  compatibilityNote String? @db.Text
  knownIssues       String? @db.Text

  // Thống kê
  ratingSum    Int @default(0)
  ratingCount  Int @default(0)
  commentCount Int @default(0)
  viewCount           Int @default(0)
  uniqueViewCount     Int @default(0)
  downloadCount       Int @default(0)
  uniqueDownloadCount Int @default(0)
  trendingScore       Float @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions   GameVersion[]
  images     GameImage[]
  events     GameEvent[]
  ratings    GameRating[]
  comments   Comment[]
  unlocks    GameUnlock[]
  favorites  Favorite[]
  reports    Report[]
  uniqueHits GameUniqueHit[]

  @@index([status, publishedAt])
  @@index([featured])
  @@index([trendingScore])
  @@index([platformId])
  @@index([resolutionId])
  @@index([vietnamized])
}

enum GameStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model GameGenre {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  icon  String?
  color String?
  order Int    @default(0)

  games GenresOnGames[]
}

model GenresOnGames {
  gameId  String
  genreId String
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   GameGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
}

model TagsOnGames {
  gameId String
  tagId  String
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
}

/// Nokia S40/S60, Sony Ericsson, Samsung, Motorola, Generic Java ME…
model GamePlatform {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  icon  String?
  order Int    @default(0)

  games Game[]
}

/// 128x160, 176x208, 176x220, 240x320, 320x240, 360x640, custom…
model GameResolution {
  id     String  @id @default(cuid())
  slug   String  @unique      // "240x320"
  label  String                // "240 × 320"
  width  Int
  height Int
  custom Boolean @default(false)
  order  Int     @default(0)

  games Game[]
}

model GameCollection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  cover       String?
  featured    Boolean @default(false)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  games GamesOnCollections[]
}

model GamesOnCollections {
  gameId       String
  collectionId String
  order        Int    @default(0)
  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  collection   GameCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([gameId, collectionId])
  @@index([collectionId])
}

// ── Versioning ────────────────────────────────────────────

model GameVersion {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Bản tải này dành cho nền tảng nào. Mỗi nền tảng có dãy version riêng.
  platform    DownloadPlatform @default(JAR)
  version     String            // "1.0.2"
  releaseDate DateTime?
  changelog   String?  @db.Text
  sizeBytes   BigInt?           // tổng dung lượng của bản tải
  /// Bản mới nhất **của nền tảng này** — mỗi nền tảng đúng một bản.
  latest      Boolean  @default(false)
  note        String?

  createdAt DateTime @default(now())

  files  GameFile[]
  events GameEvent[]

  @@unique([gameId, platform, version])
  @@index([gameId, platform, latest])
}

/// Nút tải trên trang chi tiết game. Khác `GamePlatform` (dòng máy để lọc catalog).
enum DownloadPlatform {
  WINDOWS
  MAC
  LINUX
  ANDROID
  IOS
  WEB
  JAR
}

model GameFile {
  id        String @id @default(cuid())
  versionId String
  version   GameVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  type       GameFileType
  storageKey String                 // key trên object storage / CDN
  fileName   String?
  sizeBytes  BigInt?
  checksum   String?                // giá trị checksum
  checksumAlgo String @default("sha256")
  mimeType   String?

  scanStatus ScanStatus @default(PENDING) // quét file trước khi phát hành
  scanNote   String?

  createdAt DateTime @default(now())

  @@unique([versionId, type])
  @@index([scanStatus])
}

enum GameFileType {
  JAR
  JAD
  APK
  IPA
  EXE
  MSI
  DMG
  PKG
  DEB
  ZIP
  PATCH
}

enum ScanStatus {
  PENDING
  CLEAN
  SUSPICIOUS
  QUARANTINED
}

model GameImage {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type       GameImageType @default(SCREENSHOT)
  storageKey String
  caption    String?
  width      Int?
  height     Int?
  sortOrder  Int @default(0)

  createdAt DateTime @default(now())

  @@index([gameId, type, sortOrder])
}

enum GameImageType {
  ICON
  COVER
  SCREENSHOT
  TRAILER
}

// ── Sự kiện & thống kê ────────────────────────────────────

model GameEvent {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  versionId String?
  version   GameVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorKey String            // userId hoặc hash(ip+ua) cho khách
  type     GameEventType
  isUnique Boolean @default(false)
  value    Int?              // ví dụ: thời lượng phiên (giây)
  meta     Json?

  createdAt DateTime @default(now())

  @@index([gameId, type, createdAt])
  @@index([type, createdAt])
  @@index([actorKey, type])
}

enum GameEventType {
  VIEW
  DOWNLOAD
  FAVORITE
  SHARE
  RATE
}

/// Khoá chống trùng cho "unique view / unique download / unique player".
model GameUniqueHit {
  id       String        @id @default(cuid())
  gameId   String
  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type     GameEventType
  actorKey String

  createdAt DateTime @default(now())

  @@unique([gameId, type, actorKey])
}

model GameRating {
  id     String @id @default(cuid())
  gameId String
  userId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int    // 1..5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, userId])
  @@index([gameId])
}

// ============================================================
// TIN NHẮN RIÊNG
// ============================================================

model Conversation {
  id String @id @default(cuid())

  // Hội thoại 1–1. Luôn lưu userAId < userBId để một cặp chỉ có một hội thoại,
  // nhờ vậy @@unique chặn được trùng bất kể ai nhắn trước.
  userAId String
  userBId String
  userA   User   @relation("ConvoA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User   @relation("ConvoB", fields: [userBId], references: [id], onDelete: Cascade)

  // Tuỳ chỉnh dùng chung cho cả hai người, giống cách các app chat vẫn làm.
  theme       String  @default("default")   // ảnh nền khung chat
  bubble      String  @default("default")   // kiểu bong bóng
  nicknameA   String?                       // biệt danh đặt cho userA
  nicknameB   String?                       // biệt danh đặt cho userB
  // Số giờ giữ tin trước khi tự xoá; null = không tự xoá
  autoDeleteHours Int?
  // Mốc bật tự xoá. Chỉ tin gửi TỪ mốc này trở đi mới bị xoá — bật tính năng
  // không được phép thổi bay lịch sử đã có từ trước.
  autoDeleteFrom  DateTime?

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String    @db.Text
  readAt  DateTime?
  /** Đã thu hồi: giữ lại bản ghi để tin trích dẫn nó không bị hụt. */
  deletedAt DateTime?

  // Trả lời một tin cụ thể trong cùng hội thoại
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  createdAt DateTime @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

/** Cảm xúc thả lên một tin nhắn — mỗi người một cảm xúc cho mỗi tin. */
model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}


/** Chặn giữa hai thành viên: cắt nhắn tin và theo dõi cả hai chiều. */
model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}


/**
 * Nhật ký hành động quản trị. Ghi lại ai làm gì, lên đối tượng nào —
 * để đối soát khi có tranh chấp và tìm ra nguồn của một thay đổi bất thường.
 * Xoá tài khoản admin vẫn giữ nguyên bản ghi (actorId -> null) nên lịch sử không mất.
 */
model AdminLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AdminLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  /** Tên đăng nhập lúc thao tác — giữ lại phòng khi tài khoản bị xoá/đổi tên. */
  actorName String?

  /** Khoá hành động dạng `nhóm.việc`, ví dụ `post.approve`. */
  action String
  /** Loại đối tượng bị tác động: post, user, thread… (null nếu là cài đặt chung). */
  targetType String?
  targetId   String?
  /** Mô tả ngắn hiển thị trong danh sách, đã kèm tên đối tượng. */
  summary String @db.Text
  /** Dữ liệu phụ (giá trị trước/sau, lý do…) để soi khi cần. */
  meta Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}


/** Ảnh nền khung chat do admin tải lên. */
model ChatBackground {
  id     String  @id @default(cuid())
  name   String
  image  String              // đường dẫn ảnh admin tải lên
  /** Ảnh tối: chữ phụ trong khung chat phải sáng lên mới đọc được. */
  dark   Boolean @default(false)
  active Boolean @default(true)
  order  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([active, order])
}

/** Kiểu bong bóng chat do admin tải lên: màu nền + ảnh trang trí phía trên. */
model ChatBubbleStyle {
  id          String  @id @default(cuid())
  name        String
  /** Ảnh gắn trên bong bóng (tai chibi, nơ…). Để trống thì chỉ đổi màu. */
  decor       String?
  colorMine   String
  colorTheirs String
  /** Chữ trong bong bóng là màu đậm hay trắng. */
  darkText    Boolean @default(true)
  active      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([active, order])
}

// ============================================================
// PHÒNG CHAT CHUNG — "chat tổng" kiểu forum wap ngày xưa
// ============================================================

/**
 * Một câu nói trong phòng chat chung.
 *
 * Khác hẳn Message (nhắn riêng 1–1): đây là dòng chảy công khai, ai vào cũng
 * đọc được, chỉ giữ lại một số lượng gần đây. Xoá là xoá mềm để chỗ trống
 * trong hội thoại vẫn nhìn ra là "đã bị gỡ" chứ không lặng lẽ biến mất.
 */
model ShoutMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String @db.Text

  /** Trả lời một câu cụ thể — giữ lại nếp "@ai đó" của phòng chat cũ. */
  replyToId String?
  replyTo   ShoutMessage?  @relation("ShoutReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ShoutMessage[] @relation("ShoutReply")

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ShoutDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/**
 * Ai đang ở trong một chủ đề / trong phòng chat ngay lúc này.
 *
 * Forum ngày xưa trang nào cũng có dòng "Đang xem chủ đề: A, B và 3 khách".
 * Một hàng cho mỗi (người, chỗ); mở chỗ khác thì hàng cũ được ghi đè.
 * `scope` là 'thread:<id>' hoặc 'chat'.
 */
model PresenceHere {
  userId String
  scope  String
  at     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
  @@index([scope, at])
}

/**
 * Tặng điểm kèm lời cảm ơn.
 *
 * Điểm đã cộng/trừ và ghi vào PointsLog rồi, nhưng bảng này giữ riêng để
 * dựng được dòng "N người đã tặng X điểm cho bài này" ngay dưới bài — moi ra
 * từ nhật ký điểm thì phải lọc theo cả reason lẫn refId, vừa chậm vừa dễ sai.
 */
model PointDonation {
  id String @id @default(cuid())

  fromId String
  from   User   @relation("DonationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("DonationTo", fields: [toId], references: [id], onDelete: Cascade)

  amount Int

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyId  String?
  reply    Reply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([replyId, createdAt])
  @@index([toId, createdAt])
}

/**
 * Ai đã trả điểm để mở phần tải của game nào.
 *
 * Sổ ghi quyền, giống Order bên bài viết: mở rồi thì lần sau vào không bị đòi
 * điểm nữa, kể cả khi quản trị viên đổi giá.
 */
model GameUnlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /** Số điểm thực trả lúc mở, giữ lại để đối soát khi giá đổi. */
  pointsPaid Int

  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}
