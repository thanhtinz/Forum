// Nova Platform — Prisma schema
// PostgreSQL + Auth.js (credentials + OAuth) + SePay

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Auth.js adapter models)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  passwordHash  String?
  image         String?
  cover         String?
  bio           String?   @db.Text
  /// Tâm trạng — dòng chữ ngắn hiện cạnh tên, đổi xoành xoạch. Mod "tâm
  /// trạng" là thứ forum wap Việt nào quãng 2010 cũng gắn thêm.
  mood          String?
  /**
   * Chữ ký — dán dưới mỗi bài viết của người này ở diễn đàn.
   * Forum Việt thời 2010 nhà nào cũng có; nhận BBCode như nội dung bài.
   */
  signature     String?   @db.Text

  role   Role   @default(USER)
  status UserStatus @default(ACTIVE)

  // Kinh tế — chỉ còn MỘT loại: điểm, kiếm được bằng hoạt động trên diễn đàn.
  points Int @default(0)

  /**
   * Uy tín — tổng các lần thành viên khác chấm "+" và "−" cho người này.
   *
   * Cộng dồn sẵn ở đây thay vì đếm lại bảng KarmaVote mỗi lần in tên: con số
   * này hiện cạnh nick ở MỌI bài trong chủ đề, đếm lại thì mỗi trang chủ đề
   * thêm vài chục lượt gom nhóm chỉ để ra một số nhỏ.
   */
  karma Int @default(0)

  // Cấp độ / kinh nghiệm
  exp   Int @default(0)
  level Int @default(1)

  // Điểm danh
  checkinStreak    Int       @default(0)
  lastCheckinAt    DateTime?
  totalCheckinDays Int       @default(0)

  // Mời bạn
  inviteCode     String? @unique
  invitedById    String?
  invitedBy      User?   @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]  @relation("Invites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  /**
   * Mốc "đã đọc hết diễn đàn" — bấm một nút là mọi chủ đề cũ hơn mốc này hết
   * được coi là mới.
   *
   * Có mốc chung thì nút ấy làm được trong một lần ghi, thay vì phải chèn một
   * hàng ThreadRead cho từng chủ đề trong cả diễn đàn.
   */
  forumReadAt DateTime?

  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  comments       Comment[]
  threads        Thread[]
  replies        Reply[]
  reactions      Reaction[]
  favorites      Favorite[]
  orders         Order[]
  pointsLogs     PointsLog[]
  downloads      DownloadLog[]
  medals         UserMedal[]
  notifications  Notification[]
  couponsClaimed CouponClaim[]
  followers      Follow[] @relation("Following")
  following      Follow[] @relation("Follower")
  reportsMade    Report[] @relation("Reporter")
  bans           Ban[]
  blocksMade     Block[] @relation("Blocker")
  blocksAgainst  Block[] @relation("Blocked")
  convosA        Conversation[] @relation("ConvoA")
  convosB        Conversation[] @relation("ConvoB")
  messagesSent   Message[]
  msgReactions   MessageReaction[]
  threadFollows  ThreadFollow[]
  pollVotes      PollVote[]

  /// Các loại thông báo người dùng đã tắt (chỉ áp dụng cho loại được phép tắt).
  notifyOff      NotificationType[] @default([])
  adminLogs      AdminLog[] @relation("AdminLogActor")

  gameEvents  GameEvent[]
  gameRatings GameRating[]

  shouts        ShoutMessage[]
  shoutsDeleted ShoutMessage[] @relation("ShoutDeleter")
  gameUnlocks   GameUnlock[]
  hideUnlocks   ThreadHideUnlock[]

  clubsOwned      Club[]       @relation("ClubOwner")
  clubMemberships ClubMember[]
  clubPosts       ClubPost[]
  clubPostLikes    ClubPostLike[]
  clubComments     ClubComment[]
  clubCommentLikes ClubCommentLike[]
  presence      PresenceHere[]
  donationsSent     PointDonation[] @relation("DonationFrom")
  donationsReceived PointDonation[] @relation("DonationTo")

  guestbookReceived GuestbookEntry[] @relation("GuestbookOwner")
  guestbookWritten  GuestbookEntry[] @relation("GuestbookAuthor")
  guestbookHidden   GuestbookEntry[] @relation("GuestbookHider")

  gameRequests        GameRequest[]     @relation("GameRequestBy")
  gameRequestsHandled GameRequest[]     @relation("GameRequestHandler")
  gameRequestVotes    GameRequestVote[]

  friendRequestsSent     Friendship[] @relation("FriendRequester")
  friendRequestsReceived Friendship[] @relation("FriendAddressee")

  albums PhotoAlbum[]
  photos Photo[]

  karmaGiven    KarmaVote[] @relation("KarmaFrom")
  karmaReceived KarmaVote[] @relation("KarmaTo")

  threadReads ThreadRead[]

  // Cửa hàng: đồ đã mua, và đồ đang đeo (mỗi loại đeo được một món).
  shopPurchases ShopPurchase[]
  nameColorId   String?
  nameColor     ShopItem? @relation("EquipNameColor", fields: [nameColorId], references: [id], onDelete: SetNull)
  avatarFrameId String?
  avatarFrame   ShopItem? @relation("EquipAvatarFrame", fields: [avatarFrameId], references: [id], onDelete: SetNull)
  shopBadgeId   String?
  shopBadge     ShopItem? @relation("EquipBadge", fields: [shopBadgeId], references: [id], onDelete: SetNull)
  profileCoverId String?
  profileCover   ShopItem? @relation("EquipCover", fields: [profileCoverId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([createdAt])
}

enum Role {
  USER
  AUTHOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CONTENT — Blog / bài viết
// ============================================================

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String? @db.Text
  content String  @db.Text
  cover   String?

  type   PostType   @default(ARTICLE)
  status PostStatus @default(DRAFT)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categories CategoriesOnPosts[]   // nhiều chuyên mục (WordPress-style)
  tags       TagsOnPosts[]

  // Card layout / hiển thị
  featured  Boolean @default(false)
  pinned    Boolean @default(false)
  cardStyle CardStyle @default(STANDARD)

  // Trả phí
  access      AccessLevel @default(FREE)
  pricePoints Int?        // giá bằng điểm
  unlockLikes    Int?     // LIKE_GOAL: số lượt thích cần đạt để mở cho mọi người
  unlockComments Int?     // COMMENT_GOAL: số bình luận cần đạt để mở cho mọi người
  hiddenContent String?   @db.Text  // phần nội dung ẩn sau paywall
  // Mã BBCode gốc do người dùng gõ — giữ lại để sửa bài không mất định dạng.
  contentSource String?   @db.Text
  hiddenSource  String?   @db.Text
  faq         Json?       // [{ q, a }] — câu hỏi thường gặp của bài

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments   Comment[]
  reactions  Reaction[]
  favorites  Favorite[]
  downloads  DownloadItem[]
  orders     Order[]
  reports    Report[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
}

enum PostType {
  ARTICLE
  RESOURCE   // tài nguyên tải xuống
  DOC        // tài liệu / doc series
  PAGE
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum CardStyle {
  STANDARD
  WIDE
  TEXT_ONLY
  GALLERY
}

enum AccessLevel {
  FREE
  LOGIN_REQUIRED
  POINTS

  // Mở khoá bằng tương tác của CHÍNH người xem
  LIKE            // phải thích bài
  COMMENT         // phải bình luận
  LIKE_COMMENT    // phải vừa thích vừa bình luận

  // Mở khoá cho TẤT CẢ khi đạt mốc tương tác chung
  LIKE_GOAL       // đủ `unlockLikes` lượt thích
  COMMENT_GOAL    // đủ `unlockComments` bình luận
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  color       String?
  order       Int     @default(0)

  parentId String?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CatTree")

  posts     Post[]               // chuyên mục chính (primary)
  postLinks CategoriesOnPosts[]  // nhiều chuyên mục

  createdAt DateTime @default(now())

  @@index([parentId])
}

model CategoriesOnPosts {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts TagsOnPosts[]
  threads TagsOnThreads[]
  games TagsOnGames[]
}

model TagsOnPosts {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ============================================================
// DOWNLOADS — nội dung tải xuống
// ============================================================

model DownloadItem {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  label    String
  url      String  @db.Text
  password String?          // mật khẩu giải nén
  extractCode String?       // mã trích xuất (netdisk)
  provider String?          // local | gdrive | onedrive | ...
  sizeBytes BigInt?
  version  String?

  order Int @default(0)

  logs DownloadLog[]

  createdAt DateTime @default(now())

  @@index([postId])
}

model DownloadLog {
  id     String @id @default(cuid())
  userId String
  itemId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   DownloadItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}

// ============================================================
// FORUM — diễn đàn
// ============================================================

model Forum {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  cover       String?
  order       Int     @default(0)

  postAccess  ForumAccess @default(ALL)
  minLevel    Int         @default(1)

  threadCount Int @default(0)
  replyCount  Int @default(0)

  parentId String?
  parent   Forum?  @relation("ForumTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Forum[] @relation("ForumTree")

  threads    Thread[]
  moderators ForumModerator[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

enum ForumAccess {
  ALL
  MEMBERS
  MODERATORS
}

model ForumModerator {
  id      String @id @default(cuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([forumId, userId])
}

model Thread {
  id      String @id @default(cuid())
  forumId String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text
  // Mã BBCode gốc — giữ để sửa chủ đề không mất định dạng.
  contentSource String? @db.Text

  status ThreadStatus @default(PUBLISHED)
  pinned Boolean      @default(false)
  locked Boolean      @default(false)
  featured Boolean    @default(false)

  // Thưởng / hỏi đáp
  bountyPoints  Int?
  solvedReplyId String?  @unique

  viewCount  Int @default(0)
  replyCount Int @default(0)
  likeCount  Int @default(0)

  lastReplyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  replies   Reply[]
  tags      TagsOnThreads[]
  reactions Reaction[]
  favorites Favorite[]
  reports   Report[]
  followers ThreadFollow[]
  reads     ThreadRead[]
  poll      Poll?
  donations PointDonation[]
  hideUnlocks ThreadHideUnlock[]

  @@index([forumId, lastReplyAt])
  @@index([authorId])
  @@index([pinned])
}

/// Bình chọn gắn vào một chủ đề — mỗi chủ đề nhiều nhất một cuộc.
model Poll {
  id       String @id @default(cuid())
  threadId String @unique
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  question String
  /// Cho chọn nhiều đáp án cùng lúc.
  multiple Boolean @default(false)
  /// Hết hạn thì khoá lại và ai cũng xem được kết quả. null = không hạn.
  closesAt DateTime?
  /// Chủ đề/quản trị đóng sớm.
  closed   Boolean @default(false)

  createdAt DateTime @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text  String
  order Int @default(0)

  votes PollVote[]

  @@index([pollId, order])
}

model PollVote {
  id       String @id @default(cuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

/// Theo dõi chủ đề: có trả lời mới thì được báo, kể cả không phải chủ chủ đề.
model ThreadFollow {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@index([userId, createdAt])
}


/**
 * Lần cuối một người mở một chủ đề — để đánh dấu chủ đề có bài mới.
 *
 * Chỉ ghi mốc thời gian, không ghi "đã đọc tới bài số mấy": danh sách chủ đề
 * chỉ cần biết có gì mới sau lần mình ghé hay không, mà mốc thời gian thì so
 * thẳng được với `lastReplyAt` sẵn có, không phải đếm bài.
 */
model ThreadRead {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([userId, threadId])
  @@index([userId, readAt])
}

enum ThreadStatus {
  PUBLISHED
  PENDING
  HIDDEN
  DELETED
}

model TagsOnThreads {
  threadId String
  tagId    String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model Reply {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Reply?  @relation("ReplyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Reply[] @relation("ReplyTree")

  likeCount Int     @default(0)
  isSolution Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]
  reports   Report[]
  donations PointDonation[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ============================================================
// COMMENTS (trên bài viết)
// ============================================================

model Comment {
  id String @id @default(cuid())

  // Bình luận gắn vào MỘT trong hai: bài viết hoặc game. Cùng kiểu "một cột
  // cho mỗi đối tượng" mà Reaction và Favorite đang dùng, để khỏi phải bịa ra
  // bảng bình luận riêng cho kho game.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId String?
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentTree")

  likeCount Int     @default(0)
  pinned    Boolean @default(false)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  /// Bình luận cũ chưa có cột này nên lấy now() làm mốc, coi như chưa từng sửa.
  updatedAt DateTime @default(now()) @updatedAt

  reactions Reaction[]
  reports   Report[]

  @@index([postId, createdAt])
  @@index([gameId, createdAt])
}

// ============================================================
// TƯƠNG TÁC
// ============================================================

model Reaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ReactionType @default(LIKE)

  postId    String?
  threadId  String?
  replyId   String?
  commentId String?

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread  Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply   Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, threadId, type])
  @@unique([userId, replyId, type])
  @@unique([userId, commentId, type])
}

enum ReactionType {
  LIKE
  DISLIKE
  HELPFUL
  /// Nút "Cảm ơn" của forum Việt ngày xưa — khác Thích ở chỗ nó công khai
  /// danh sách người đã cảm ơn ngay dưới bài, và một người vẫn vừa thích
  /// vừa cảm ơn được (ràng buộc duy nhất đã tính cả `type`).
  THANKS
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId   String?
  threadId String?
  gameId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  folder String @default("default")

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, threadId])
  @@unique([userId, gameId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ============================================================
// KINH TẾ — chỉ còn điểm và sổ ghi quyền mở khoá nội dung
// ============================================================

model PointsLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount  Int         // +/- 
  balance Int         // số dư sau giao dịch
  reason  PointsReason
  note    String?
  refId   String?     // id đối tượng liên quan

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum PointsReason {
  CHECKIN
  POST_CREATE
  COMMENT_CREATE
  THREAD_CREATE
  REPLY_CREATE
  RECEIVED_LIKE
  INVITE_BONUS
  PURCHASE_CONTENT
  CONTENT_SALE       // tác giả nhận từ bán nội dung
  ADMIN_ADJUST
  EXCHANGE
  BOUNTY_PAID
  BOUNTY_RECEIVED
  COUPON
  DONATE_SENT        // tặng điểm cho bài của người khác
  DONATE_RECEIVED    // nhận điểm người khác tặng
  SHOP_BUY           // mua đồ trang trí ở cửa hàng
}



model Order {
  id     String @id @default(cuid())
  code   String @unique          // mã đơn hiển thị
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status OrderStatus @default(PENDING)

  // Đối tượng mua
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  discount   Int @default(0)
  pointsUsed Int @default(0)

  couponClaimId String?     @unique
  couponClaim   CouponClaim? @relation(fields: [couponClaimId], references: [id], onDelete: SetNull)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}


enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}


